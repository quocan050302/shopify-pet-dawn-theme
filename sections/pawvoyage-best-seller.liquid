{%- liquid
  assign img = section.settings.main_image
  assign img_alt = section.settings.main_image_alt | default: 'PawVoyage Tactical Dog Harness'
-%}
<style>
#pvbs-{{ section.id }} { background: #FAF8F3; padding: 5rem 1.6rem; font-family: inherit; }
@media(min-width:990px){ #pvbs-{{ section.id }} { padding: 7rem 2rem; } }
.pvbs-wrap { max-width: 1360px; margin: 0 auto; }
.pvbs-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
@media(min-width:990px){ .pvbs-grid { grid-template-columns: 52% 1fr; gap: 5rem; align-items: start; } }
.pvbs-left { display: flex; flex-direction: column; gap: 1.6rem; }
.pvbs-img-card { position: relative; border-radius: 28px; overflow: hidden; background: #EDE8DC; min-height: 420px; box-shadow: 0 24px 60px rgba(20,45,25,.10); }
@media(min-width:990px){ .pvbs-img-card { border-radius: 34px; min-height: 680px; } }
.pvbs-img-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.pvbs-placeholder { display: flex; align-items: center; justify-content: center; min-height: 420px; color: #8A9486; font-size: 1.4rem; padding: 4rem; text-align: center; }
@media(min-width:990px){ .pvbs-placeholder { min-height: 680px; } }
.pvbs-float-layer { position: absolute; inset: 0; pointer-events: none; }
.pvbs-float { position: absolute; background: rgba(255,255,255,0.93); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 20px; box-shadow: 0 16px 48px rgba(20,45,25,.14); border: 1px solid rgba(20,60,30,.07); padding: 1.4rem 1.6rem; width: 210px; pointer-events: auto; display: flex; align-items: flex-start; gap: 1rem; }
.pvbs-float--1 { top: 10%; left: 4%; }
.pvbs-float--2 { top: 38%; right: 2%; }
.pvbs-float--3 { bottom: 24%; left: 4%; }
.pvbs-float__icon { flex-shrink: 0; width: 34px; height: 34px; background: #133316; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; }
.pvbs-float__icon svg { width: 16px; height: 16px; }
.pvbs-float__body { display: flex; flex-direction: column; gap: .3rem; }
.pvbs-float__title { font-size: 1.05rem; font-weight: 800; color: #133316; letter-spacing: .06em; text-transform: uppercase; }
.pvbs-float__text { font-size: 1.2rem; color: #4A5748; margin: 0; line-height: 1.4; }
.pvbs-dot { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: #F2B544; box-shadow: 0 0 0 5px rgba(242,181,68,.2); transform: translate(-50%,-50%); }
.pvbs-dot--1 { top: 34%; left: 40%; }
.pvbs-dot--2 { top: 52%; left: 62%; }
.pvbs-dot--3 { top: 65%; left: 35%; }
.pvbs-mobile-callouts { display: none; flex-direction: column; gap: 1rem; }
@media(max-width:989px){ .pvbs-mobile-callouts { display: flex; } .pvbs-float-layer { display: none; } }
.pvbs-mobile-card { background: #fff; border-radius: 14px; padding: 1.4rem; display: flex; align-items: flex-start; gap: 1rem; box-shadow: 0 4px 14px rgba(0,0,0,.05); }
.pvbs-mobile-card__icon { flex-shrink: 0; width: 32px; height: 32px; background: #133316; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; }
.pvbs-mobile-card__icon svg { width: 15px; height: 15px; }
.pvbs-mobile-card__title { font-size: 1.1rem; font-weight: 800; color: #133316; text-transform: uppercase; letter-spacing: .05em; }
.pvbs-mobile-card__text { font-size: 1.25rem; color: #4A5748; margin: .2rem 0 0; line-height: 1.4; }
.pvbs-trust-bar { background: #fff; border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,.06); padding: 1.6rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; flex-wrap: wrap; }
.pvbs-trust-item { display: flex; align-items: center; gap: .8rem; flex: 1; min-width: 120px; }
.pvbs-trust-item__icon { color: #D4A843; flex-shrink: 0; }
.pvbs-trust-item__icon svg { width: 22px; height: 22px; }
.pvbs-trust-item__stars { display: flex; gap: 2px; }
.pvbs-trust-item__star { color: #D4A843; font-size: 1.6rem; }
.pvbs-trust-item__label { font-size: 1.25rem; font-weight: 600; color: #2A3228; }
.pvbs-trust-item__sub { font-size: 1.1rem; color: #6B7568; }
.pvbs-trust-sep { width: 1px; height: 36px; background: #E2DDD4; flex-shrink: 0; }
.pvbs-right { display: flex; flex-direction: column; align-items: flex-start; }
.pvbs-badge { display: inline-flex; align-items: center; gap: .5rem; background: #D4A843; color: #fff; font-size: 1.1rem; font-weight: 800; letter-spacing: .10em; text-transform: uppercase; padding: .55rem 1.4rem; border-radius: 999px; margin-bottom: 2rem; box-shadow: 0 4px 14px rgba(212,168,67,.25); }
.pvbs-heading { font-size: clamp(3.4rem,5vw,6.2rem); font-weight: 800; color: #133316; line-height: .95; letter-spacing: -.02em; margin: 0 0 1.6rem; }
.pvbs-sub { font-size: 1.7rem; color: #4A5748; line-height: 1.6; margin: 0 0 2.8rem; max-width: 580px; }
.pvbs-price-row { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-bottom: 2.8rem; }
.pvbs-price-label { font-size: 1.3rem; font-weight: 700; color: #6B7568; letter-spacing: .06em; text-transform: uppercase; }
.pvbs-price-now { font-size: clamp(3rem,4vw,4.2rem); font-weight: 800; color: #133316; line-height: 1; }
.pvbs-price-was { font-size: 1.8rem; color: #9CA8A0; text-decoration: line-through; }
.pvbs-price-save { background: #133316; color: #fff; font-size: 1.15rem; font-weight: 800; letter-spacing: .04em; padding: .5rem 1.2rem; border-radius: 8px; white-space: nowrap; }
.pvbs-divider { width: 100%; height: 1px; background: rgba(19,51,22,.10); margin: 0 0 2.8rem; }
.pvbs-features { list-style: none; padding: 0; margin: 0 0 2.8rem; display: flex; flex-direction: column; }
.pvbs-feature { display: flex; align-items: flex-start; gap: 1.4rem; padding: 1.6rem 0; border-bottom: 1px solid rgba(19,51,22,.08); }
.pvbs-feature:first-child { border-top: 1px solid rgba(19,51,22,.08); }
.pvbs-feature__icon { flex-shrink: 0; width: 42px; height: 42px; background: #133316; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; margin-top: 2px; }
.pvbs-feature__icon svg { width: 20px; height: 20px; }
.pvbs-feature__body { display: flex; flex-direction: column; gap: .3rem; }
.pvbs-feature__title { font-size: 1.6rem; font-weight: 800; color: #133316; margin: 0; }
.pvbs-feature__text { font-size: 1.45rem; color: #4A5748; margin: 0; line-height: 1.45; }
.pvbs-why-box { width: 100%; background: #F2EEE4; border: 1px solid #DDD8CC; border-radius: 18px; padding: 2.2rem 2.4rem; margin-bottom: 3rem; }
.pvbs-why-box__header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.4rem; }
.pvbs-why-box__icon { color: #D4A843; }
.pvbs-why-box__icon svg { width: 20px; height: 20px; }
.pvbs-why-box__title { font-size: 1.2rem; font-weight: 800; color: #133316; letter-spacing: .08em; text-transform: uppercase; margin: 0; }
.pvbs-why-item { display: flex; align-items: flex-start; gap: .8rem; margin-bottom: .8rem; font-size: 1.45rem; color: #2A3228; }
.pvbs-why-item:last-child { margin-bottom: 0; }
.pvbs-why-check { color: #133316; font-weight: 800; flex-shrink: 0; }
.pvbs-cta-wrap { width: 100%; margin-bottom: 1.6rem; }
.pvbs-cta { display: flex; align-items: center; justify-content: center; gap: 1rem; width: 100%; background: linear-gradient(135deg,#133316 0%,#1D4A1F 100%); color: #fff; font-size: 1.8rem; font-weight: 800; padding: 2rem 3.6rem; border-radius: 999px; text-decoration: none; border: none; cursor: pointer; box-shadow: 0 10px 28px rgba(19,51,22,.22); transition: transform .25s ease, box-shadow .25s ease, background .25s ease; }
.pvbs-cta:hover { background: linear-gradient(135deg,#1A4220 0%,#245825 100%); transform: translateY(-2px); box-shadow: 0 16px 36px rgba(19,51,22,.28); color: #fff; }
.pvbs-cta svg { width: 20px; height: 20px; flex-shrink: 0; }
@media(min-width:750px){ .pvbs-cta { width: auto; min-width: 380px; } }
.pvbs-microcopy { text-align: center; font-size: 1.3rem; color: #6B7568; display: flex; align-items: center; justify-content: center; gap: .5rem; width: 100%; }
</style>
