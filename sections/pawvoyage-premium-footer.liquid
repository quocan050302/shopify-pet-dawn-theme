{%- liquid
  assign nl_img     = section.settings.newsletter_image
  assign shimmer_on = section.settings.enable_shimmer
  assign av1        = section.settings.proof_avatar_1
  assign av2        = section.settings.proof_avatar_2
  assign av3        = section.settings.proof_avatar_3
  assign av4        = section.settings.proof_avatar_4
  assign av5        = section.settings.proof_avatar_5

  assign raw_heading   = section.settings.newsletter_heading   | default: 'Join 10,000+ Dog Owners Creating Calmer Walks.'
  assign raw_highlight = section.settings.newsletter_highlight | default: 'Calmer Walks.'
-%}

{%- style -%}
/* ═══════════════════════════════════════════════════════════
   PawVoyage Premium Footer v3 — Compact Luxury Rebuild
   Scoped to: #pvf-{{ section.id }}
   ═══════════════════════════════════════════════════════════ */

#pvf-{{ section.id }},
#pvf-{{ section.id }} *,
#pvf-{{ section.id }} *::before,
#pvf-{{ section.id }} *::after { box-sizing: border-box; }

/* ── TOKENS ── */
#pvf-{{ section.id }} {
  --g:       #06170f;
  --g2:      #0b2a1c;
  --g3:      #123625;
  --gold:    #d7a53f;
  --gold2:   #e8bb5c;
  --cream:   #f6f2e8;
  --muted:   rgba(255,255,255,0.72);
  --dim:     rgba(255,255,255,0.45);
  --dimmer:  rgba(255,255,255,0.28);
  --bdr:     rgba(255,255,255,0.08);
  --bdr-g:   rgba(215,165,63,0.22);
  --r:       16px;
  --r-card:  24px;
  font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif);
  background: linear-gradient(135deg, var(--g) 0%, var(--g2) 45%, var(--g3) 100%);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}

/* Ambient radial glow */
#pvf-{{ section.id }}::before {
  content: '';
  position: absolute;
  top: -30%; left: -10%;
  width: 70%; height: 160%;
  background: radial-gradient(ellipse, rgba(215,165,63,0.06) 0%, transparent 65%);
  pointer-events: none;
  z-index: 0;
}
#pvf-{{ section.id }}::after {
  content: '';
  position: absolute;
  bottom: -20%; right: -10%;
  width: 55%; height: 120%;
  background: radial-gradient(ellipse, rgba(18,54,37,0.45) 0%, transparent 65%);
  pointer-events: none;
  z-index: 0;
}

/* ── WRAP ── */
#pvf-{{ section.id }} .pvf-wrap {
  position: relative;
  z-index: 1;
  max-width: 1600px;
  margin: 0 auto;
  padding: 48px 40px 28px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
@media (max-width: 749px) {
  #pvf-{{ section.id }} .pvf-wrap {
    padding: 24px 18px 18px;
    gap: 18px;
  }
}

/* ══════════════════════════════════════════════════════
   1. NEWSLETTER CTA — Horizontal 2-Column
   ══════════════════════════════════════════════════════ */

/* Outer section wrapper */
#pvf-{{ section.id }} .pvf-nl {
  position: relative;
  width: 100%;
}
/* Ambient amber glow behind card */
#pvf-{{ section.id }} .pvf-nl::before {
  content: '';
  position: absolute;
  inset: -20px -5%;
  background: radial-gradient(ellipse 60% 120% at 50% 50%, rgba(215,165,63,0.06) 0%, transparent 68%);
  pointer-events: none;
  z-index: 0;
}

/* ── 2-COLUMN CARD ── */
#pvf-{{ section.id }} .pvf-nl__card {
  position: relative;
  z-index: 1;
  margin: 0 auto;
  padding: 36px 48px;
  border-radius: 24px;
  background: rgba(255,255,255,0.032);
  border: 1px solid rgba(255,255,255,0.08);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow:
    0 2px 0 rgba(215,165,63,0.10),
    0 18px 52px rgba(0,0,0,0.32),
    inset 0 1px 0 rgba(255,255,255,0.05);
  /* 2-column grid: left 55% / right 45% */
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
  align-items: center;
  gap: 48px;
  min-height: 0;
}
/* Gold shimmer top line */
#pvf-{{ section.id }} .pvf-nl__card::before {
  content: '';
  position: absolute;
  top: 0; left: 8%; right: 8%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(215,165,63,0.46) 50%, transparent);
  pointer-events: none;
  border-radius: 1px;
}

/* ── LEFT: COPY ── */
#pvf-{{ section.id }} .pvf-nl__copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  text-align: left;
  min-width: 0;
}

/* Label */
#pvf-{{ section.id }} .pvf-nl__label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold);
  opacity: 0.90;
  line-height: 1;
}
#pvf-{{ section.id }} .pvf-nl__label svg {
  width: 12px; height: 12px;
  fill: var(--gold);
  flex-shrink: 0;
}

/* Headline */
#pvf-{{ section.id }} .pvf-nl__headline {
  font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
  font-size: clamp(30px, 3.4vw, 52px);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.028em;
  color: #f5f2e8;
  margin: 0;
  max-width: 620px;
}
#pvf-{{ section.id }} .pvf-nl__accent {
  color: var(--gold);
  text-shadow: 0 0 24px rgba(215,165,63,0.22);
}

/* Shimmer */
#pvf-{{ section.id }} .pvf-nl__shimmer {
  position: relative;
  display: inline;
  color: #f5f2e8;
  filter: brightness(1.08);
}
{% if shimmer_on %}
#pvf-{{ section.id }} .pvf-nl__shimmer::after {
  content: '';
  position: absolute;
  inset: -2px -4px;
  border-radius: 4px;
  background: linear-gradient(105deg, transparent 15%, rgba(215,165,63,0.28) 50%, transparent 85%);
  background-size: 250% 100%;
  animation: pvf-shimmer 3.8s ease-in-out infinite;
  pointer-events: none;
}
{% endif %}

/* Description */
#pvf-{{ section.id }} .pvf-nl__desc {
  font-size: 16px;
  color: var(--muted);
  line-height: 1.52;
  margin: 0;
  max-width: 500px;
}

/* ── RIGHT: ACTIONS ── */
#pvf-{{ section.id }} .pvf-nl__actions {
  display: flex;
  flex-direction: column;
  gap: 11px;
  min-width: 0;
}

/* Form */
#pvf-{{ section.id }} .pvf-nl__form {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
}
#pvf-{{ section.id }} .pvf-nl__row {
  display: flex;
  gap: 8px;
  width: 100%;
  height: 56px;
}

/* Input */
#pvf-{{ section.id }} .pvf-nl__input-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
#pvf-{{ section.id }} .pvf-nl__icon {
  position: absolute;
  left: 16px;
  display: flex;
  align-items: center;
  pointer-events: none;
}
#pvf-{{ section.id }} .pvf-nl__icon svg {
  width: 15px; height: 15px;
  stroke: rgba(215,165,63,0.42);
}
#pvf-{{ section.id }} .pvf-nl__input {
  width: 100%;
  height: 56px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 16px;
  padding: 0 16px 0 44px;
  color: var(--cream);
  font-size: 15px;
  font-family: inherit;
  outline: none;
  -webkit-appearance: none;
  appearance: none;
  transition: border-color 0.25s, box-shadow 0.25s;
}
#pvf-{{ section.id }} .pvf-nl__input::placeholder { color: rgba(255,255,255,0.42); }
#pvf-{{ section.id }} .pvf-nl__input:focus {
  border-color: rgba(215,165,63,0.46);
  box-shadow: 0 0 0 3px rgba(215,165,63,0.09);
}

/* Button */
#pvf-{{ section.id }} .pvf-nl__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56px;
  width: 170px;
  flex-shrink: 0;
  background: linear-gradient(180deg, #e0b24c 0%, #c9942f 100%);
  color: #111;
  font-size: 15px;
  font-weight: 700;
  font-family: inherit;
  border: none;
  border-radius: 16px;
  cursor: pointer;
  white-space: nowrap;
  letter-spacing: 0.01em;
  position: relative;
  overflow: hidden;
  transition: background 0.25s, box-shadow 0.25s, transform 0.15s;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.20), inset 0 -2px 0 rgba(0,0,0,0.12);
}
#pvf-{{ section.id }} .pvf-nl__btn::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(115deg, transparent 30%, rgba(255,255,255,0.16) 50%, transparent 70%);
  opacity: 0;
  transition: opacity 0.25s;
}
#pvf-{{ section.id }} .pvf-nl__btn:hover::before { opacity: 1; }
#pvf-{{ section.id }} .pvf-nl__btn:hover {
  background: linear-gradient(180deg, #ebbc5a 0%, #d7a53f 100%);
  box-shadow: 0 0 20px rgba(215,165,63,0.40), inset 0 1px 0 rgba(255,255,255,0.22);
  transform: translateY(-1px);
}
#pvf-{{ section.id }} .pvf-nl__btn:active { transform: translateY(0); }
#pvf-{{ section.id }} .pvf-nl__btn:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
}

/* Form messages */
#pvf-{{ section.id }} .pvf-nl__msg {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; margin-top: 6px;
}
#pvf-{{ section.id }} .pvf-nl__msg--success { color: #6fd98c; }
#pvf-{{ section.id }} .pvf-nl__msg--error   { color: #f07070; }
#pvf-{{ section.id }} .pvf-nl__msg svg { width: 13px; height: 13px; flex-shrink: 0; }

/* Trust row */
#pvf-{{ section.id }} .pvf-nl__trust {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px 14px;
  width: 100%;
}
#pvf-{{ section.id }} .pvf-nl__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: rgba(255,255,255,0.52);
  white-space: nowrap;
}
#pvf-{{ section.id }} .pvf-nl__trust-icon {
  width: 13px; height: 13px;
  border-radius: 50%;
  border: 1px solid rgba(215,165,63,0.30);
  background: rgba(215,165,63,0.07);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-nl__trust-icon svg {
  width: 7px; height: 7px;
  stroke: var(--gold);
}

/* Proof row */
#pvf-{{ section.id }} .pvf-nl__proof {
  display: flex;
  align-items: center;
  gap: 7px;
  flex-wrap: wrap;
  opacity: 0.68;
}
#pvf-{{ section.id }} .pvf-nl__proof-stars {
  color: var(--gold);
  font-size: 1.2rem;
  letter-spacing: 1px;
  line-height: 1;
  filter: drop-shadow(0 0 4px rgba(215,165,63,0.30));
}
#pvf-{{ section.id }} .pvf-nl__proof-text {
  font-size: 12px;
  color: rgba(255,255,255,0.68);
  line-height: 1;
}

/* ── MOBILE ── */
@media (max-width: 749px) {
  #pvf-{{ section.id }} .pvf-nl__card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 20px;
    padding: 24px 18px;
    border-radius: 18px;
    min-height: auto;
  }
  #pvf-{{ section.id }} .pvf-nl__copy {
    align-items: center;
    text-align: center;
  }
  #pvf-{{ section.id }} .pvf-nl__headline {
    font-size: clamp(28px, 8vw, 36px);
    line-height: 1.03;
    max-width: 100%;
  }
  #pvf-{{ section.id }} .pvf-nl__desc {
    font-size: 15px;
    max-width: 100%;
  }
  #pvf-{{ section.id }} .pvf-nl__row {
    flex-direction: column;
    height: auto;
    gap: 10px;
  }
  #pvf-{{ section.id }} .pvf-nl__input {
    height: 54px;
    border-radius: 14px;
  }
  #pvf-{{ section.id }} .pvf-nl__btn {
    width: 100%;
    height: 54px;
    border-radius: 14px;
  }
  #pvf-{{ section.id }} .pvf-nl__trust {
    justify-content: center;
  }
  #pvf-{{ section.id }} .pvf-nl__proof {
    justify-content: center;
  }
}

/* ══════════════════════════════════════════════════════
   2. MAIN FOOTER ROW — 4-COLUMN
   ══════════════════════════════════════════════════════ */

#pvf-{{ section.id }} .pvf-main {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 24px;
  padding-bottom: 20px;
}
@media (max-width: 860px) {
  #pvf-{{ section.id }} .pvf-main {
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
  }
}
@media (max-width: 560px) {
  #pvf-{{ section.id }} .pvf-main {
    grid-template-columns: 1fr;
    gap: 0;
    border-bottom: none;
    padding-bottom: 0;
  }
}

/* Brand column */
#pvf-{{ section.id }} .pvf-brand {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
@media (max-width: 860px) {
  #pvf-{{ section.id }} .pvf-brand { grid-column: 1 / -1; }
}

/* Logo row */
#pvf-{{ section.id }} .pvf-brand__logo {
  display: flex;
  align-items: center;
  gap: 9px;
}
#pvf-{{ section.id }} .pvf-brand__logo-mark {
  width: 32px; height: 32px;
  background: rgba(215,165,63,0.12);
  border: 1px solid rgba(215,165,63,0.28);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-brand__logo-mark svg {
  width: 18px; height: 18px;
  fill: var(--gold);
}
#pvf-{{ section.id }} .pvf-brand__name {
  font-size: 1.9rem;
  font-weight: 900;
  color: var(--cream);
  letter-spacing: -0.02em;
  line-height: 1;
}

/* Brand description */
#pvf-{{ section.id }} .pvf-brand__desc {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.6;
  max-width: 260px;
  margin: 0;
}

/* Socials */
#pvf-{{ section.id }} .pvf-socials {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 2px;
}
#pvf-{{ section.id }} .pvf-social {
  width: 34px; height: 34px;
  border-radius: 50%;
  border: 1px solid var(--bdr);
  background: rgba(255,255,255,0.04);
  display: flex; align-items: center; justify-content: center;
  color: var(--muted);
  text-decoration: none;
  transition: border-color 0.2s, background 0.2s, color 0.2s, box-shadow 0.2s;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-social:hover {
  border-color: var(--gold);
  background: rgba(215,165,63,0.10);
  color: var(--gold);
  box-shadow: 0 0 12px rgba(215,165,63,0.20);
}
#pvf-{{ section.id }} .pvf-social svg { width: 15px; height: 15px; }

/* Menu columns */
#pvf-{{ section.id }} .pvf-col {}

/* Accordion toggle (mobile) */
#pvf-{{ section.id }} .pvf-col__title {
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cream);
  margin: 0 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: default;
}
#pvf-{{ section.id }} .pvf-col__toggle {
  display: none;
  width: 20px; height: 20px;
  border-radius: 50%;
  border: 1px solid var(--bdr);
  background: rgba(255,255,255,0.05);
  align-items: center;
  justify-content: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color 0.2s, background 0.2s;
}
#pvf-{{ section.id }} .pvf-col__toggle svg {
  width: 10px; height: 10px;
  stroke: var(--muted);
  transition: transform 0.25s;
}
@media (max-width: 560px) {
  #pvf-{{ section.id }} .pvf-col {
    border-bottom: 1px solid var(--bdr);
  }
  #pvf-{{ section.id }} .pvf-col__title {
    margin: 0;
    padding: 14px 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #pvf-{{ section.id }} .pvf-col__toggle { display: flex; }
  #pvf-{{ section.id }} .pvf-col.pvf-col--open .pvf-col__toggle svg {
    transform: rotate(180deg);
  }
}

/* Menu list */
#pvf-{{ section.id }} .pvf-menu {
  list-style: none; padding: 0; margin: 0;
  display: flex;
  flex-direction: column;
  gap: 11px;
}
@media (max-width: 560px) {
  #pvf-{{ section.id }} .pvf-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    padding-bottom: 0;
    gap: 0;
  }
  #pvf-{{ section.id }} .pvf-col.pvf-col--open .pvf-menu {
    max-height: 320px;
    padding-bottom: 14px;
  }
  #pvf-{{ section.id }} .pvf-menu li + li {
    margin-top: 11px;
  }
}

#pvf-{{ section.id }} .pvf-menu a {
  font-size: 15px;
  color: var(--muted);
  text-decoration: none;
  font-weight: 400;
  transition: color 0.18s;
  display: inline-block;
}
#pvf-{{ section.id }} .pvf-menu a:hover { color: var(--gold); }

/* Long link (Do Not Sell...) wraps cleanly */
#pvf-{{ section.id }} .pvf-menu__wrap a {
  white-space: normal;
  line-height: 1.45;
  font-size: 13.5px;
}

/* ══════════════════════════════════════════════════════
   3. COMPACT TRUST BAR
   ══════════════════════════════════════════════════════ */

#pvf-{{ section.id }} .pvf-trust-bar {
  display: flex;
  align-items: center;
  gap: 16px 24px;
  flex-wrap: wrap;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--bdr);
  border-radius: var(--r);
  padding: 14px 18px;
  width: 100%;
}
#pvf-{{ section.id }} .pvf-trust-bar__stars {
  font-size: 1.5rem;
  color: var(--gold);
  letter-spacing: 1px;
  filter: drop-shadow(0 0 5px rgba(215,165,63,0.35));
  flex-shrink: 0;
  line-height: 1;
}
#pvf-{{ section.id }} .pvf-trust-bar__rating {
  font-size: 14px;
  font-weight: 700;
  color: var(--cream);
  flex-shrink: 0;
  line-height: 1.2;
}
#pvf-{{ section.id }} .pvf-trust-bar__rating small {
  font-size: 13px;
  font-weight: 400;
  color: var(--dim);
  margin-left: 2px;
}
#pvf-{{ section.id }} .pvf-trust-bar__divider {
  width: 1px;
  height: 20px;
  background: var(--bdr);
  flex-shrink: 0;
}
@media (max-width: 560px) {
  #pvf-{{ section.id }} .pvf-trust-bar__divider { display: none; }
}
#pvf-{{ section.id }} .pvf-trust-bar__item {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-trust-bar__avatars {
  display: flex;
  align-items: center;
}
#pvf-{{ section.id }} .pvf-trust-bar__avatar {
  width: 26px; height: 26px;
  border-radius: 50%;
  border: 2px solid var(--g2);
  object-fit: cover;
  margin-left: -7px;
  background: #1b4030;
  display: block;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-trust-bar__avatar:first-child { margin-left: 0; }
#pvf-{{ section.id }} .pvf-trust-bar__avatar-ph {
  width: 26px; height: 26px;
  border-radius: 50%;
  border: 2px solid var(--g2);
  background: rgba(215,165,63,0.12);
  margin-left: -7px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-trust-bar__avatar-ph:first-child { margin-left: 0; }
#pvf-{{ section.id }} .pvf-trust-bar__count {
  font-size: 14px;
  font-weight: 700;
  color: var(--cream);
  margin-left: 8px;
  white-space: nowrap;
}
#pvf-{{ section.id }} .pvf-trust-bar__count small {
  font-weight: 400;
  color: var(--dim);
  font-size: 13px;
  margin-left: 2px;
}

/* ══════════════════════════════════════════════════════
   4. BOTTOM BAR
   ══════════════════════════════════════════════════════ */

#pvf-{{ section.id }} .pvf-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding-top: 18px;
  border-top: 1px solid var(--bdr);
  flex-wrap: wrap;
}
@media (max-width: 560px) {
  #pvf-{{ section.id }} .pvf-bottom {
    flex-direction: column;
    text-align: center;
    gap: 12px;
  }
}

#pvf-{{ section.id }} .pvf-bottom__copy {
  font-size: 13px;
  color: rgba(255,255,255,0.35);
  line-height: 1.4;
  flex-shrink: 0;
}
#pvf-{{ section.id }} .pvf-payments {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
  list-style: none;
  padding: 0; margin: 0;
}
#pvf-{{ section.id }} .pvf-payments li {
  background: rgba(255,255,255,0.92);
  border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  padding: 2px 4px;
}
#pvf-{{ section.id }} .pvf-payments li svg,
#pvf-{{ section.id }} .pvf-payments li img {
  height: 20px; width: auto; display: block;
}

/* ── ANIMATIONS ── */
@keyframes pvf-shimmer {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}
#pvf-{{ section.id }} .pvf-wrap {
  animation: pvf-fadein 0.65s cubic-bezier(0.22,1,0.36,1) both;
}
@keyframes pvf-fadein {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Visually hidden */
#pvf-{{ section.id }} .pvf-sr {
  position: absolute; width: 1px; height: 1px;
  padding: 0; overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap; border: 0;
}
{%- endstyle -%}

<footer id="pvf-{{ section.id }}" role="contentinfo" aria-label="Site footer">
  <div class="pvf-wrap">

    <!-- ══ 1. NEWSLETTER CTA — 2-Column Horizontal ══ -->
    <div class="pvf-nl" aria-label="Newsletter signup">
      <div class="pvf-nl__card">

        <!-- LEFT: COPY -->
        <div class="pvf-nl__copy">
          <!-- Label -->
          <div class="pvf-nl__label">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3C6.6 3 5.5 4.1 5.5 5.5S6.6 8 8 8s2.5-1.1 2.5-2.5S9.4 3 8 3zm8 0c-1.4 0-2.5 1.1-2.5 2.5S14.6 8 16 8s2.5-1.1 2.5-2.5S17.4 3 16 3zM5.5 9C4.1 9 3 10.1 3 11.5S4.1 14 5.5 14 8 12.9 8 11.5 6.9 9 5.5 9zm13 0C17.1 9 16 10.1 16 11.5S17.1 14 18.5 14 21 12.9 21 11.5 19.9 9 18.5 9zM12 10c-2.8 0-5 2.2-5 5 0 2.2 1.4 4.1 3.3 4.8L12 21l1.7-1.2C15.6 19.1 17 17.2 17 15c0-2.8-2.2-5-5-5z"/></svg>
            <span>{{ section.settings.newsletter_eyebrow | default: 'WALK BETTER. TOGETHER.' }}</span>
          </div>
          <!-- Headline -->
          <h2 class="pvf-nl__headline">
            {%- if raw_highlight != blank and raw_heading contains raw_highlight -%}
              {%- assign before_hl = raw_heading | split: raw_highlight | first -%}
              {%- assign after_hl  = raw_heading | remove_first: before_hl | remove_first: raw_highlight -%}
              {%- assign shimmer_word = '10,000+' -%}
              {%- if before_hl contains shimmer_word -%}
                {%- assign pb = before_hl | split: shimmer_word -%}
                {{- pb | first -}}<span class="pvf-nl__shimmer">{{ shimmer_word }}</span>{{- pb | last -}}<span class="pvf-nl__accent">{{ raw_highlight }}</span>{{- after_hl -}}
              {%- else -%}
                {{- before_hl -}}<span class="pvf-nl__accent">{{ raw_highlight }}</span>{{- after_hl -}}
              {%- endif -%}
            {%- else -%}
              {{ raw_heading }}
            {%- endif -%}
          </h2>
          <!-- Description -->
          <p class="pvf-nl__desc">{{ section.settings.newsletter_subheading | default: 'Get walking tips, exclusive offers, and product updates.' }}</p>
        </div><!-- /pvf-nl__copy -->

        <!-- RIGHT: ACTIONS -->
        <div class="pvf-nl__actions">
          <!-- Form -->
          {%- form 'customer', id: "PVFForm-{{ section.id }}", class: 'pvf-nl__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="pvf-nl__row">
              <div class="pvf-nl__input-wrap">
                <span class="pvf-nl__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="3" ry="3"/><path d="M2 7l10 7 10-7"/>
                  </svg>
                </span>
                <label for="PVFEmail-{{ section.id }}" class="pvf-sr">{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}</label>
                <input
                  id="PVFEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="pvf-nl__input"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}"
                  aria-required="true"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  {%- if form.errors %}autofocus aria-invalid="true" aria-describedby="PVFErr-{{ section.id }}"{%- endif %}
                  {%- if form.posted_successfully? %}aria-describedby="PVFOk-{{ section.id }}"{%- endif %}
                  required
                >
              </div>
              <button type="submit" name="commit" id="PVFBtn-{{ section.id }}" class="pvf-nl__btn">
                {{ section.settings.newsletter_button_text | default: 'Join the Pack' }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="pvf-nl__msg pvf-nl__msg--error" id="PVFErr-{{ section.id }}" role="alert">
                <svg viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M7 0C3.134 0 0 3.134 0 7s3.134 7 7 7 7-3.134 7-7-3.134-7-7-7zm.7 10.5H6.3v-1.4h1.4v1.4zm0-2.8H6.3V3.5h1.4v4.2z"/></svg>
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="pvf-nl__msg pvf-nl__msg--success" id="PVFOk-{{ section.id }}" role="status">
                <svg viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M7 0C3.134 0 0 3.134 0 7s3.134 7 7 7 7-3.134 7-7-3.134-7-7-7zm3.15 4.55L6.65 8.05l-2.8-2.8L2.8 6.3l3.85 3.85L11.2 5.6l-1.05-1.05z"/></svg>
                Thanks for subscribing! 🐾
              </p>
            {%- endif -%}
          {%- endform -%}
          <!-- Trust row -->
          <div class="pvf-nl__trust" role="list" aria-label="Newsletter benefits">
            <span class="pvf-nl__trust-item" role="listitem">
              <span class="pvf-nl__trust-icon" aria-hidden="true"><svg viewBox="0 0 10 10" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M2 5l2 2 4-4"/></svg></span>
              {{ section.settings.trust_item_1 | default: 'No spam' }}
            </span>
            <span class="pvf-nl__trust-item" role="listitem">
              <span class="pvf-nl__trust-icon" aria-hidden="true"><svg viewBox="0 0 10 10" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M2 5l2 2 4-4"/></svg></span>
              {{ section.settings.trust_item_2 | default: 'Unsubscribe anytime' }}
            </span>
            <span class="pvf-nl__trust-item" role="listitem">
              <span class="pvf-nl__trust-icon" aria-hidden="true"><svg viewBox="0 0 10 10" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M2 5l2 2 4-4"/></svg></span>
              {{ section.settings.trust_item_3 | default: 'Exclusive member deals' }}
            </span>
          </div>
          <!-- Rating proof -->
          <div class="pvf-nl__proof" aria-label="Customer rating">
            <span class="pvf-nl__proof-stars" aria-hidden="true">★★★★★</span>
            <span class="pvf-nl__proof-text">{{ section.settings.proof_rating | default: '4.9/5' }} &middot; {{ section.settings.proof_reviews | default: '1,247+ reviews' }}</span>
          </div>
        </div><!-- /pvf-nl__actions -->

      </div><!-- /pvf-nl__card -->
    </div><!-- /pvf-nl -->

    <!-- ══ 2. MAIN FOOTER ROW ══ -->
    <div class="pvf-main">

      <!-- Brand -->
      <div class="pvf-brand">
        <div class="pvf-brand__logo">
          <div class="pvf-brand__logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 3C6.6 3 5.5 4.1 5.5 5.5S6.6 8 8 8s2.5-1.1 2.5-2.5S9.4 3 8 3zm8 0c-1.4 0-2.5 1.1-2.5 2.5S14.6 8 16 8s2.5-1.1 2.5-2.5S17.4 3 16 3zM5.5 9C4.1 9 3 10.1 3 11.5S4.1 14 5.5 14 8 12.9 8 11.5 6.9 9 5.5 9zm13 0C17.1 9 16 10.1 16 11.5S17.1 14 18.5 14 21 12.9 21 11.5 19.9 9 18.5 9zM12 10c-2.8 0-5 2.2-5 5 0 2.2 1.4 4.1 3.3 4.8L12 21l1.7-1.2C15.6 19.1 17 17.2 17 15c0-2.8-2.2-5-5-5z"/>
            </svg>
          </div>
          <span class="pvf-brand__name">{{ section.settings.brand_name | default: shop.name }}</span>
        </div>
        <p class="pvf-brand__desc">{{ section.settings.brand_desc | default: 'Premium dog gear designed for calmer, safer, and more comfortable walks.' }}</p>
        <nav class="pvf-socials" aria-label="Social media links">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="pvf-social" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="pvf-social" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="pvf-social" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.27 6.27 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.9a8.18 8.18 0 0 0 4.77 1.52V7.0a4.85 4.85 0 0 1-1.01-.31z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="pvf-social" aria-label="YouTube" rel="noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
            </a>
          {%- endif -%}
        </nav>
      </div>

      <!-- Menu columns from blocks -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          {%- assign block_heading_lower = block.settings.heading | downcase -%}

          <div class="pvf-col" id="pvf-col-{{ block.id }}" {{ block.shopify_attributes }}>
            <h3
              class="pvf-col__title"
              id="pvf-col-title-{{ block.id }}"
              aria-controls="pvf-col-menu-{{ block.id }}"
              aria-expanded="false"
              role="button"
              tabindex="0"
            >
              {{ block.settings.heading | default: block.settings.menu.title | upcase }}
              <span class="pvf-col__toggle" aria-hidden="true">
                <svg viewBox="0 0 10 6" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
                  <path d="M1 1l4 4 4-4"/>
                </svg>
              </span>
            </h3>

            {%- if block_heading_lower == 'support' -%}
              {%- comment -%} Hardcoded Support policy links {%- endcomment -%}
              <nav aria-label="Support links">
                <ul class="pvf-menu" id="pvf-col-menu-{{ block.id }}" role="list">
                  <li role="listitem"><a href="{{ shop.shipping_policy.url }}">Shipping Policy</a></li>
                  <li role="listitem"><a href="{{ shop.refund_policy.url }}">Return &amp; Refund Policy</a></li>
                </ul>
              </nav>

            {%- elsif block_heading_lower == 'company' -%}
              {%- comment -%} Hardcoded Company / Legal policy links {%- endcomment -%}
              <nav aria-label="Company and legal links">
                <ul class="pvf-menu" id="pvf-col-menu-{{ block.id }}" role="list">
                  <li role="listitem"><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></li>
                  <li role="listitem"><a href="{{ shop.terms_of_service.url }}">Terms of Service</a></li>
                  <li role="listitem" class="pvf-menu__wrap"><a href="/pages/data-sharing-opt-out">Do Not Sell or Share My Personal Information</a></li>
                </ul>
              </nav>

            {%- elsif block.settings.menu != blank -%}
              {%- comment -%} Default: render from Shopify nav menu (e.g. Shop) {%- endcomment -%}
              <ul class="pvf-menu" id="pvf-col-menu-{{ block.id }}" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li role="listitem"><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}

    </div><!-- /pvf-main -->

    <!-- ══ 3. COMPACT TRUST BAR — HIDDEN ══ -->
    <div class="pvf-trust-bar" role="region" aria-label="Customer trust and reviews" style="display:none">

      <div class="pvf-trust-bar__stars" aria-label="5 stars out of 5">★★★★★</div>

      <div class="pvf-trust-bar__rating">
        {{ section.settings.proof_rating | default: '4.9/5' }}
        <small>{{ section.settings.proof_reviews | default: '· 1,247+ reviews' }}</small>
      </div>

      <div class="pvf-trust-bar__divider" aria-hidden="true"></div>

      <div class="pvf-trust-bar__item">
        <div class="pvf-trust-bar__avatars" aria-label="Customer photos">
          {%- if av1 != blank -%}
            <img class="pvf-trust-bar__avatar" src="{{ av1 | image_url: width: 60 }}" alt="Happy customer" width="26" height="26" loading="lazy">
          {%- else -%}
            <span class="pvf-trust-bar__avatar-ph" aria-hidden="true">🐾</span>
          {%- endif -%}
          {%- if av2 != blank -%}
            <img class="pvf-trust-bar__avatar" src="{{ av2 | image_url: width: 60 }}" alt="Happy customer" width="26" height="26" loading="lazy">
          {%- else -%}
            <span class="pvf-trust-bar__avatar-ph" aria-hidden="true">🐾</span>
          {%- endif -%}
          {%- if av3 != blank -%}
            <img class="pvf-trust-bar__avatar" src="{{ av3 | image_url: width: 60 }}" alt="Happy customer" width="26" height="26" loading="lazy">
          {%- else -%}
            <span class="pvf-trust-bar__avatar-ph" aria-hidden="true">🐾</span>
          {%- endif -%}
          {%- if av4 != blank -%}
            <img class="pvf-trust-bar__avatar" src="{{ av4 | image_url: width: 60 }}" alt="Happy customer" width="26" height="26" loading="lazy">
          {%- else -%}
            <span class="pvf-trust-bar__avatar-ph" aria-hidden="true">🐾</span>
          {%- endif -%}
        </div>
        <span class="pvf-trust-bar__count">
          {{ section.settings.proof_count | default: '10,000+' }}
          <small>{{ section.settings.proof_count_label | default: 'happy dog owners' }}</small>
        </span>
      </div>

    </div><!-- /pvf-trust-bar -->

    <!-- ══ 4. BOTTOM BAR ══ -->
    <div class="pvf-bottom">
      <p class="pvf-bottom__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. All rights reserved.
      </p>
      {%- if section.settings.payment_enable -%}
        <ul class="pvf-payments" role="list" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li role="listitem">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div><!-- /pvf-wrap -->
</footer>

<script>
(function() {
  var titles = document.querySelectorAll('#pvf-{{ section.id }} .pvf-col__title');
  if (!titles.length) return;
  function isMobile() { return window.innerWidth <= 560; }
  titles.forEach(function(title) {
    function toggle(e) {
      if (!isMobile()) return;
      var col = title.closest('.pvf-col');
      var expanded = col.classList.toggle('pvf-col--open');
      title.setAttribute('aria-expanded', expanded ? 'true' : 'false');
    }
    title.addEventListener('click', toggle);
    title.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(e); }
    });
  });
})();
</script>

