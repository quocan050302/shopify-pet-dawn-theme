<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {{ 'pv-premium-pdp.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: 0;
      padding-bottom: 0;
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  {%- liquid
    assign selected_variant = product.selected_or_first_available_variant
    if selected_variant == blank
      assign selected_variant = product.variants.first
    endif
    assign current_price = selected_variant.price
    assign compare_price = selected_variant.compare_at_price
    assign savings = 0
    assign savings_pct = 0
    if compare_price and compare_price > current_price
      assign savings = compare_price | minus: current_price
      assign savings_pct = savings | times: 100 | divided_by: compare_price | round
    endif
  -%}

  <div class="pv-pdp-outer">
    <div class="pv-pdp-wrap">
      <div class="pv-product-grid">

        <!-- ===== LEFT COLUMN: Media Panel (Gallery + Reviews) ===== -->
        <div class="pv-media-panel pv-left-col">

          <!-- Gallery -->
          <div class="pv-gallery-col">

            <!-- Vertical thumbnail rail (desktop) -->
            <div class="pv-thumb-rail" id="pv-thumb-rail-{{ section.id }}" role="list">
              {%- if selected_variant.featured_media != null -%}
                {%- assign featured_media = selected_variant.featured_media -%}
                {%- assign thumb_alt = featured_media.alt | escape -%}
                <button class="pv-thumb-btn is-active" data-pv-thumb-target="{{ section.id }}-{{ featured_media.id }}" aria-label="View image 1" type="button">
                  {{ featured_media.preview_image | image_url: width: 160 | image_tag: loading: 'eager', alt: thumb_alt }}
                  {%- if featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}
                    <span class="pv-thumb-video-badge"><svg viewBox="0 0 10 10"><polygon points="2,1 9,5 2,9" fill="white"/></svg></span>
                  {%- endif -%}
                </button>
              {%- endif -%}
              {%- for media in product.media -%}
                {%- unless media.id == selected_variant.featured_media.id -%}
                  {%- assign thumb_alt = media.alt | escape -%}
                  <button class="pv-thumb-btn" data-pv-thumb-target="{{ section.id }}-{{ media.id }}" aria-label="View image {{ forloop.index | plus: 1 }}" type="button">
                    {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: thumb_alt }}
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="pv-thumb-video-badge"><svg viewBox="0 0 10 10"><polygon points="2,1 9,5 2,9" fill="white"/></svg></span>
                    {%- endif -%}
                  </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>

            <!-- Main image wrapper -->
            <div class="pv-main-img-wrap" id="pv-main-img-wrap-{{ section.id }}">

              <media-gallery
                id="MediaGallery-{{ section.id }}"
                role="region"
                aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
                data-desktop-layout="thumbnail_slider"
                style="position:absolute;inset:0;width:100%;height:100%;"
              >
                <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
                <slider-component id="GalleryViewer-{{ section.id }}" style="width:100%;height:100%;display:block;overflow:hidden;border-radius:inherit;">
                  <ul id="Slider-Gallery-{{ section.id }}" class="pv-media-list list-unstyled" role="list" style="margin:0;padding:0;list-style:none;width:100%;height:100%;position:relative;">
                    {%- if selected_variant.featured_media != null -%}
                      {%- assign featured_media = selected_variant.featured_media -%}
                      {%- assign main_alt = featured_media.alt | escape -%}
                      <li id="Slide-{{ section.id }}-{{ featured_media.id }}" class="pv-media-slide is-active" data-media-id="{{ section.id }}-{{ featured_media.id }}" style="position:absolute;inset:0;display:block;">
                        {%- if featured_media.media_type == 'image' -%}
                          {{ featured_media | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: main_alt, style: 'width:100%;height:100%;object-fit:cover;display:block;' }}
                        {%- elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}
                          {%- render 'product-media', media: featured_media, loop: section.settings.enable_video_looping, modal_id: section.id -%}
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                    {%- for media in product.media -%}
                      {%- unless media.id == selected_variant.featured_media.id -%}
                        {%- assign main_alt = media.alt | escape -%}
                        <li id="Slide-{{ section.id }}-{{ media.id }}" class="pv-media-slide" data-media-id="{{ section.id }}-{{ media.id }}" style="position:absolute;inset:0;display:none;">
                          {%- if media.media_type == 'image' -%}
                            {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: main_alt, style: 'width:100%;height:100%;object-fit:cover;display:block;' }}
                          {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                            {%- render 'product-media', media: media, loop: section.settings.enable_video_looping, modal_id: section.id -%}
                          {%- endif -%}
                        </li>
                      {%- endunless -%}
                    {%- endfor -%}
                  </ul>
                </slider-component>

                <!-- Hidden thumbnail list required by media-gallery.js for variant switching -->
                <slider-component
                  id="GalleryThumbnails-{{ section.id }}"
                  class="thumbnail-slider slider-mobile-gutter quick-add-hidden"
                  style="display:none!important;position:absolute;pointer-events:none;width:0;height:0;overflow:hidden;visibility:hidden;"
                >
                  <ul id="Slider-Thumbnails-{{ section.id }}" class="thumbnail-list list-unstyled" style="display:flex;">
                    {%- if selected_variant.featured_media != null -%}
                      <li id="Slide-Thumbnails-{{ section.id }}-0" class="thumbnail-list__item slider__slide" data-target="{{ section.id }}-{{ selected_variant.featured_media.id }}" data-media-position="1">
                        <button class="thumbnail" aria-current="true" aria-controls="GalleryViewer-{{ section.id }}">{{ selected_variant.featured_media.preview_image | image_url: width: 54 | image_tag: loading: 'lazy', alt: '' }}</button>
                      </li>
                    {%- endif -%}
                    {%- for media in product.media -%}
                      {%- unless media.id == selected_variant.featured_media.id -%}
                        <li id="Slide-Thumbnails-{{ section.id }}-{{ forloop.index }}" class="thumbnail-list__item slider__slide" data-target="{{ section.id }}-{{ media.id }}" data-media-position="{{ forloop.index | plus: 1 }}">
                          <button class="thumbnail" aria-controls="GalleryViewer-{{ section.id }}">{{ media.preview_image | image_url: width: 54 | image_tag: loading: 'lazy', alt: '' }}</button>
                        </li>
                      {%- endunless -%}
                    {%- endfor -%}
                  </ul>
                </slider-component>
              </media-gallery>

              <!-- Image Overlay -->
              <div class="pv-img-overlay" aria-hidden="true">
                <p class="pv-overlay-headline">
                  {{ section.settings.overlay_headline_1 | default: 'Built for Adventure.' }}
                  <span>{{ section.settings.overlay_headline_2 | default: 'Designed for Comfort.' }}</span>
                </p>
                <div class="pv-overlay-chips">
                  {%- assign chip_1 = section.settings.overlay_chip_1 | default: 'No-Pull Control' -%}
                  {%- assign chip_2 = section.settings.overlay_chip_2 | default: 'Secure & Adjustable' -%}
                  {%- assign chip_3 = section.settings.overlay_chip_3 | default: 'All-Day Comfort' -%}
                  {%- if chip_1 != blank -%}
                    <span class="pv-overlay-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ chip_1 }}</span>
                  {%- endif -%}
                  {%- if chip_2 != blank -%}
                    <span class="pv-overlay-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{{ chip_2 }}</span>
                  {%- endif -%}
                  {%- if chip_3 != blank -%}
                    <span class="pv-overlay-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{{ chip_3 }}</span>
                  {%- endif -%}
                </div>
                <div class="pv-social-mini">
                  <div class="pv-avatar-stack">
                    <div class="pv-avatar">J</div>
                    <div class="pv-avatar">S</div>
                    <div class="pv-avatar">M</div>
                    <div class="pv-avatar">R</div>
                  </div>
                  <div class="pv-social-mini-text">
                    <span class="pv-social-mini-rating"><span class="pv-stars">★★★★★</span> 4.9/5</span>
                    <span class="pv-social-mini-count">{{ section.settings.overlay_review_text | default: '1,247+ Happy Dog Owners' }}</span>
                  </div>
                </div>
              </div>

              {%- if product.media.size > 1 -%}
                <button class="pv-arrow-btn pv-arrow-prev" id="pv-arrow-prev-{{ section.id }}" type="button" aria-label="Previous image">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button class="pv-arrow-btn pv-arrow-next" id="pv-arrow-next-{{ section.id }}" type="button" aria-label="Next image">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              {%- endif -%}
            </div><!-- end .pv-main-img-wrap -->

            <!-- Mobile Thumbnail Strip -->
            <div class="pv-thumb-mobile-strip" id="pv-thumb-mobile-{{ section.id }}" role="list">
              {%- if selected_variant.featured_media != null -%}
                <button class="pv-thumb-btn is-active" data-pv-thumb-target="{{ section.id }}-{{ selected_variant.featured_media.id }}" type="button">
                  {{ selected_variant.featured_media.preview_image | image_url: width: 140 | image_tag: loading: 'eager', widths: '68, 140', alt: '' }}
                </button>
              {%- endif -%}
              {%- for media in product.media -%}
                {%- unless media.id == selected_variant.featured_media.id -%}
                  <button class="pv-thumb-btn" data-pv-thumb-target="{{ section.id }}-{{ media.id }}" type="button">
                    {{ media.preview_image | image_url: width: 140 | image_tag: loading: 'lazy', widths: '68, 140', alt: '' }}
                  </button>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div><!-- end .pv-gallery-col -->


          <!-- Review Strip -->
          <div class="pv-review-strip">
            <div class="pv-review-left">
              <div class="pv-review-stars">★★★★★</div>
              <div class="pv-review-score">4.9/5 from</div>
              <div class="pv-review-count-text">{{ section.settings.review_count_text | default: '1,247+ reviews' }}</div>
              <div class="pv-review-dogs">{{ section.settings.review_dogs_text | default: '10,000+ Happy Dogs' }}</div>
              <div class="pv-review-avatars">
                <div class="pv-avatar">J</div><div class="pv-avatar">S</div><div class="pv-avatar">M</div><div class="pv-avatar">R</div><div class="pv-avatar">A</div>
              </div>
            </div>

            <!-- Cards section: wrap adds positioning context for the fade overlay -->
            <div class="pv-review-cards-wrap">
              <div class="pv-review-cards" data-pv-review-scroll>
                {%- assign r1_default = "Finally a harness that stops pulling without hurting my dog." -%}
                {%- assign r2_default = "Super tough and comfortable. Perfect for our hikes." -%}
                {%- assign r3_default = "Best harness we've ever used. Worth every penny." -%}
                <div class="pv-mini-review">
                  {%- if section.settings.review_1_image != blank -%}
                    <img src="{{ section.settings.review_1_image | image_url: width: 300 }}" alt="Customer photo" class="pv-mini-review-img" loading="lazy">
                  {%- elsif product.images[1] != blank -%}
                    <img src="{{ product.images[1] | image_url: width: 300 }}" alt="Product" class="pv-mini-review-img" loading="lazy">
                  {%- endif -%}
                  <div class="pv-mini-review-body">
                    <div class="pv-mini-review-stars">★★★★★</div>
                    <p class="pv-mini-review-text">{{ section.settings.review_1_text | default: r1_default }}</p>
                    <div class="pv-mini-review-author">{{ section.settings.review_1_author | default: 'James T.' }}</div>
                  </div>
                </div>
                <div class="pv-mini-review">
                  {%- if section.settings.review_2_image != blank -%}
                    <img src="{{ section.settings.review_2_image | image_url: width: 300 }}" alt="Customer photo" class="pv-mini-review-img" loading="lazy">
                  {%- elsif product.images[2] != blank -%}
                    <img src="{{ product.images[2] | image_url: width: 300 }}" alt="Product" class="pv-mini-review-img" loading="lazy">
                  {%- endif -%}
                  <div class="pv-mini-review-body">
                    <div class="pv-mini-review-stars">★★★★★</div>
                    <p class="pv-mini-review-text">{{ section.settings.review_2_text | default: r2_default }}</p>
                    <div class="pv-mini-review-author">{{ section.settings.review_2_author | default: 'Sarah M.' }}</div>
                  </div>
                </div>
                <div class="pv-mini-review">
                  {%- if section.settings.review_3_image != blank -%}
                    <img src="{{ section.settings.review_3_image | image_url: width: 300 }}" alt="Customer photo" class="pv-mini-review-img" loading="lazy">
                  {%- elsif product.images[3] != blank -%}
                    <img src="{{ product.images[3] | image_url: width: 300 }}" alt="Product" class="pv-mini-review-img" loading="lazy">
                  {%- endif -%}
                  <div class="pv-mini-review-body">
                    <div class="pv-mini-review-stars">★★★★★</div>
                    <p class="pv-mini-review-text">{{ section.settings.review_3_text | default: r3_default }}</p>
                    <div class="pv-mini-review-author">{{ section.settings.review_3_author | default: 'Michael R.' }}</div>
                  </div>
                </div>
              </div>
              <!-- Right-edge fade: hidden by JS when user scrolls to end -->
              <div class="pv-cards-fade-right" aria-hidden="true"></div>
            </div>

            <!-- Mobile swipe hint: JS hides when no overflow or at end -->
            <p class="pv-cards-swipe-hint" aria-hidden="true">Swipe for more reviews →</p>

          </div><!-- end .pv-review-strip -->


        </div><!-- end .pv-media-panel -->

        <!-- ===== RIGHT COLUMN: Info / Purchase Panel ===== -->
        <div class="pv-info-panel pv-purchase-col">
          <div class="pv-offer-bar-new">
            <div class="pv-offer-bar-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {{ section.settings.offer_bar_left | default: 'LIMITED SPRING OFFER' }}
            </div>
            <div class="pv-offer-bar-right">{{ section.settings.offer_bar_right | default: 'Save $30 Today!' }}</div>
          </div>

          <section id="ProductInfo-{{ section.id }}" class="pv-card-body" style="flex:1;display:flex;flex-direction:column;">

            <!-- 1. Title -->
            <h1 class="pv-product-title">{{ product.title | escape }}</h1>

            <!-- 2. Price -->
            <div class="pv-price-row" id="price-{{ section.id }}" role="status" aria-live="polite">
              <span class="pv-price-current">
                {%- if selected_variant.price -%}{{ selected_variant.price | money_with_currency }}{%- else -%}{{ product.price | money_with_currency }}{%- endif -%}
              </span>
              {%- if compare_price and compare_price > current_price -%}
                <span class="pv-price-compare">{{ compare_price | money_with_currency }}</span>
                <span class="pv-price-save-badge">SAVE {{ savings | money }} ({{ savings_pct }}%)</span>
              {%- endif -%}
            </div>

            <!-- 3. Short Description -->
            {%- assign short_desc = section.settings.short_description -%}
            {%- if short_desc != blank -%}
              <p class="pv-short-desc">{{ short_desc }}</p>
            {%- elsif product.description != blank -%}
              <p class="pv-short-desc">{{ product.description | strip_html | truncate: 150 }}</p>
            {%- endif -%}

            <!-- 4. Variant Pickers -->
            {%- unless product.has_only_default_variant -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'variant_picker' -%}
                  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
                {%- endif -%}
              {%- endfor -%}
            {%- endunless -%}

            <!-- 5. Add to Cart + Dynamic Checkout -->
            {%- for block in section.blocks -%}
              {%- if block.type == 'buy_buttons' -%}
                <div class="pv-atc-area">
                  {%- render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: false -%}
                </div>
              {%- endif -%}
            {%- endfor -%}

            <!-- 6. Benefit Chips -->
            

            <!-- 7. Trust Badges -->
            <div class="pv-trust-area">
              <div class="pv-trust-badges">
                <div class="pv-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><span class="pv-trust-badge-label">{{ section.settings.trust_1 | default: '30-Day Risk-Free Trial' }}</span></div>
                <div class="pv-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span class="pv-trust-badge-label">{{ section.settings.trust_2 | default: 'Secure Checkout' }}</span></div>
                <div class="pv-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span class="pv-trust-badge-label">{{ section.settings.trust_3 | default: 'Free Shipping' }}</span></div>
                <div class="pv-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span class="pv-trust-badge-label">{{ section.settings.trust_4 | default: '30-Day Returns' }}</span></div>
              </div>
              <div class="pv-trust-delivery">{{ section.settings.delivery_text | default: 'Delivery: 7–12 business days' }}</div>
            </div>

            <!-- 8. App blocks + custom_liquid -->
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}{% render block %}
                {%- when 'custom_liquid' -%}{{ block.settings.custom_liquid }}
              {%- endcase -%}
            {%- endfor -%}

            <!-- 9. Installment payment terms -->
            {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
            {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
              <input type="hidden" name="id" value="{{ selected_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}

          </section><!-- end #ProductInfo -->
        </div><!-- end .pv-info-panel -->

      </div><!-- end .pv-product-grid -->
    </div><!-- end .pv-pdp-wrap -->
  </div><!-- end .pv-pdp-outer -->

  {%- comment -%} ── Premium Floating Sticky ATC (matches homepage style) ── {%- endcomment -%}
  {%- liquid
    assign s_variant = product.selected_or_first_available_variant
    assign s_sold_out = false
    unless s_variant.available
      assign s_sold_out = true
    endunless
    assign s_has_compare = false
    if s_variant.compare_at_price > s_variant.price
      assign s_has_compare = true
    endif
  -%}

  <div
    id="pvpdp-sticky-{{ section.id }}"
    role="complementary"
    aria-label="Quick add to cart"
    aria-hidden="true"
  >
    <div class="pvpdp-sticky-inner">

      {%- comment -%} Left: thumbnail + title + rating {%- endcomment -%}
