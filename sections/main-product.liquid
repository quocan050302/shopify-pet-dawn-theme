  <!-- PV Gallery JS: Thumbnail Click + Arrow Nav + Swipe + Variant sync -->
  <script>
  (function() {
    'use strict';
    var sid = '{{ section.id }}';
    function pvGalleryInit() {
      var slides = document.querySelectorAll('#Slider-Gallery-' + sid + ' .pv-media-slide');
      var thumbBtns = document.querySelectorAll('[data-pv-thumb-target]');
      var prevBtn = document.getElementById('pv-arrow-prev-' + sid);
      var nextBtn = document.getElementById('pv-arrow-next-' + sid);
      if (!slides.length) return;

      function getActiveIdx() {
        for (var i = 0; i < slides.length; i++) { if (slides[i].style.display !== 'none') return i; }
        return 0;
      }

      function showSlide(idx) {
        if (idx < 0) idx = slides.length - 1;
        if (idx >= slides.length) idx = 0;
        slides.forEach(function(s, i) {
          s.style.display = (i === idx) ? 'block' : 'none';
          s.classList.toggle('is-active', i === idx);
        });
        var activeId = slides[idx].id.replace('Slide-', '');
        thumbBtns.forEach(function(btn) {
          var match = btn.getAttribute('data-pv-thumb-target') === activeId;
          btn.classList.toggle('is-active', match);
          btn.setAttribute('aria-current', match ? 'true' : 'false');
          if (match && btn.parentElement.classList.contains('pv-thumb-rail')) {
            btn.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        });
      }

      thumbBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = btn.getAttribute('data-pv-thumb-target');
          var el = document.getElementById('Slide-' + target);
          if (el) { var i = Array.prototype.indexOf.call(slides, el); if (i >= 0) showSlide(i); }
        });
      });

      if (prevBtn) prevBtn.addEventListener('click', function() { showSlide(getActiveIdx() - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function() { showSlide(getActiveIdx() + 1); });

      var wrap = document.getElementById('pv-main-img-wrap-' + sid);
      if (wrap) {
        var tx = 0;
        wrap.addEventListener('touchstart', function(e) { tx = e.changedTouches[0].pageX; }, { passive: true });
        wrap.addEventListener('touchend', function(e) { var d = e.changedTouches[0].pageX - tx; if (Math.abs(d) > 40) showSlide(getActiveIdx() + (d < 0 ? 1 : -1)); }, { passive: true });
      }

      document.addEventListener('variant:change', function(e) {
        var v = e.detail && e.detail.variant;
        if (!v || !v.featured_media) return;
        var el = document.getElementById('Slide-' + sid + '-' + v.featured_media.id);
        if (el) { var i = Array.prototype.indexOf.call(slides, el); if (i >= 0) showSlide(i); }
      });

      /* Old sticky atc removed — new premium floating bar handles its own visibility */
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', pvGalleryInit); } else { pvGalleryInit(); }
  })();
  </script>

  <!-- PV Thumbnail Rail: Drag-to-scroll (desktop vertical + mobile horizontal, mouse + touch) -->
  <script>
  (function() {
    'use strict';
    function pvThumbDragInit() {

      /*
       * makeDraggable(el, axis)
       * Adds mouse-drag AND touch-swipe scroll to a container.
       * axis: 'x' = horizontal scroll   |  'y' = vertical scroll
       *
       * Key mobile fix: touchmove is registered as { passive: false }
       * so we can call e.preventDefault() to stop the browser
       * from treating a horizontal thumb-swipe as a vertical page scroll.
       */
      function makeDraggable(el, axis) {
        if (!el) return;

        /* ---- State ---- */
        var isDragging  = false;
        var startPos    = 0;
        var startScroll = 0;
        var moved       = false;
        var touchStartX = 0;
        var touchStartY = 0;
        var isHorizIntent = null; /* null = undecided, true/false after first move */

        /* ---- MOUSE drag (desktop) ---- */
        el.addEventListener('mousedown', function(e) {
          if (e.button !== 0) return;
          isDragging  = true;
          moved       = false;
          startPos    = axis === 'x' ? e.pageX : e.pageY;
          startScroll = axis === 'x' ? el.scrollLeft : el.scrollTop;
          el.classList.add('is-dragging');
          e.preventDefault();
        });

        window.addEventListener('mousemove', function(e) {
          if (!isDragging) return;
          var delta = (axis === 'x' ? e.pageX : e.pageY) - startPos;
          if (Math.abs(delta) > 3) moved = true;
          if (axis === 'x') el.scrollLeft = startScroll - delta;
          else              el.scrollTop  = startScroll - delta;
        });

        window.addEventListener('mouseup', function() {
          if (!isDragging) return;
          isDragging = false;
          el.classList.remove('is-dragging');
        });

        /* Block accidental click after drag */
        el.addEventListener('click', function(e) {
          if (moved) { e.stopPropagation(); e.preventDefault(); moved = false; }
        }, true);

        /* ---- TOUCH drag (mobile / tablet) ---- */
        el.addEventListener('touchstart', function(e) {
          var t = e.touches[0];
          touchStartX    = t.clientX;
          touchStartY    = t.clientY;
          startScroll    = axis === 'x' ? el.scrollLeft : el.scrollTop;
          isHorizIntent  = null;
          moved          = false;
        }, { passive: true });

        /* non-passive → allows e.preventDefault() */
        el.addEventListener('touchmove', function(e) {
          var t      = e.touches[0];
          var dx     = t.clientX - touchStartX;
          var dy     = t.clientY - touchStartY;

          /* Determine scroll intent on first significant move */
          if (isHorizIntent === null && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) {
            isHorizIntent = Math.abs(dx) > Math.abs(dy);
          }
          if (isHorizIntent === null) return;

          if (axis === 'x') {
            if (!isHorizIntent) return; /* vertical swipe → let page scroll */
            e.preventDefault();        /* horizontal swipe → scroll the strip */
            el.scrollLeft = startScroll - dx;
            moved = true;
          } else {
            if (isHorizIntent) return; /* horizontal swipe → ignore */
            e.preventDefault();        /* vertical swipe → scroll the rail */
            el.scrollTop = startScroll - dy;
            moved = true;
          }
        }, { passive: false }); /* MUST be non-passive to call preventDefault */

        el.addEventListener('touchend', function() {
          isHorizIntent = null;
        }, { passive: true });
      }

      /* ---- Desktop vertical thumb rail ---- */
      document.querySelectorAll('.pv-thumb-rail').forEach(function(rail) {
        makeDraggable(rail, 'y');
        rail.style.cursor = 'grab';
      });

      /* ---- Mobile / tablet horizontal thumb strip ---- */
      document.querySelectorAll('.pv-thumb-mobile-strip').forEach(function(strip) {
        makeDraggable(strip, 'x');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pvThumbDragInit);
    } else {
      pvThumbDragInit();
    }
  })();
  </script>
  <script>
  (function() {
    'use strict';
    function pvReviewScrollInit() {
      var scrollers = document.querySelectorAll('[data-pv-review-scroll]');
      scrollers.forEach(function(el) {
        var wrap  = el.closest('.pv-review-cards-wrap') || el.parentElement;
        var fade  = wrap && wrap.querySelector('.pv-cards-fade-right');
        var hint  = el.closest('.pv-review-strip') && el.closest('.pv-review-strip').querySelector('.pv-cards-swipe-hint');

        function update() {
          var hasOverflow = el.scrollWidth > el.clientWidth + 4;
          var atEnd       = el.scrollLeft + el.clientWidth >= el.scrollWidth - 8;
          var hide        = !hasOverflow || atEnd;
          if (fade) fade.classList.toggle('is-hidden', hide);
          if (hint) hint.classList.toggle('is-hidden', hide);
        }

        el.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', pvReviewScrollInit);
    } else {
      pvReviewScrollInit();
    }
  })();
  </script>

