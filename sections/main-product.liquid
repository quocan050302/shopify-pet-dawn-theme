  <script>
  (function(){
    var sticky = document.getElementById('pvpdp-sticky-{{ section.id }}');
    if (!sticky) return;
    var shown = false;
    var footerVisible = false;
    var threshold = 400;

    function showBar() {
      if (shown) return;
      shown = true;
      sticky.classList.add('pvpdp-sticky-visible');
      sticky.setAttribute('aria-hidden', 'false');
    }
    function hideBar() {
      if (!shown) return;
      shown = false;
      sticky.classList.remove('pvpdp-sticky-visible');
      sticky.setAttribute('aria-hidden', 'true');
    }
    function toggle() {
      if (footerVisible) return;
      var scrollY = window.scrollY || window.pageYOffset;
      var nearBottom = (scrollY + window.innerHeight) >= (document.documentElement.scrollHeight - 120);
      if (nearBottom) { hideBar(); }
      else if (scrollY > threshold) { showBar(); }
      else { hideBar(); }
    }
    window.addEventListener('scroll', toggle, { passive: true });
    toggle();

    /* Hide when footer enters viewport */
    var footer = document.querySelector('footer[id^="pvf-"], footer.pv-footer, footer');
    if (footer && 'IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) { footerVisible = true; hideBar(); }
          else { footerVisible = false; toggle(); }
        });
      }, { threshold: 0.01 }).observe(footer);
    }

    /* Click → scroll to main ATC button */
    var btn = document.getElementById('pvpdp-sticky-btn-{{ section.id }}');
    if (btn && !btn.disabled) {
      btn.addEventListener('click', function() {
        /* Try to click the real ATC form button */
        var mainBtn = document.getElementById('ProductSubmitButton-{{ section.id }}');
        if (mainBtn && !mainBtn.disabled) {
          mainBtn.click();
          return;
        }
        /* Fallback: scroll to product form */
        var form = document.querySelector('.product-form, #product-form-{{ section.id }}');
        if (form) { form.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      });
    }
  })();
  </script>

