.pv-option-label {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  margin-bottom: 0.8rem;
  font-size: 1.4rem;
  color: #4A5246;
}
.pv-option-name { font-weight: 700; color: #12350E; text-transform: capitalize; }
.pv-option-selected { 
  font-weight: 600; 
  color: #12350E; 
  background: #FAF3E7; 
  padding: 0.2rem 0.8rem; 
  border-radius: 99px; 
  font-size: 1.3rem;
}
.pv-option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.8rem;
}
.pv-option-grid[data-option="size"] {
  grid-template-columns: repeat(4, 1fr); /* 4 per row for sizes */
}
@media screen and (min-width: 600px) {
  .pv-option-grid { grid-template-columns: repeat(4, 1fr); }
  .pv-option-grid[data-option="size"] { grid-template-columns: repeat(5, 1fr); }
}
@media screen and (min-width: 990px) {
  .pv-option-grid { grid-template-columns: repeat(9, 1fr); }
  .pv-option-grid[data-option="size"] { grid-template-columns: repeat(7, 1fr); }
}

/* Individual option button */
.pv-opt-btn {
  display: block;
  width: 100%;
  padding: 0.8rem 0.2rem;
  border: 1.5px solid rgba(31,36,29,0.15);
  border-radius: 8px;
  background: #FFFFFF;
  color: #1F241D;
  font-size: 1.2rem;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  text-align: center;
  transition: border-color 0.15s, background 0.15s, color 0.15s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}
.pv-opt-btn:hover {
  border-color: #12350E;
  background: #FAF3E7;
  color: #12350E;
}
.pv-opt-btn.pv-opt-active {
  border-color: #12350E;
  background: #FAF3E7; /* Subtle cream highlight */
  color: #12350E;
  font-weight: 800;
  box-shadow: 0 0 0 1px #12350E;
}
/* Unavailable variant */
.pv-opt-btn.pv-opt-unavailable {
  opacity: 0.5;
  cursor: not-allowed;
  text-decoration: line-through;
}
.pv-opt-btn.pv-opt-unavailable:hover {
  border-color: rgba(31,36,29,0.15);
  background: #FFFFFF;
  color: #1F241D;
}

/* Size guide hint */
.pv-size-guide-hint {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: 1.6rem;
  font-size: 1.3rem;
  color: #6F7568;
}
.pv-size-guide-link {
  background: none;
  border: none;
  color: #D99A2B;
  font-size: 1.3rem;
  font-weight: 700;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.pv-size-guide-link:hover { color: #B8811E; }

/* Desktop Vertical Thumbnails (Left side) */
@media screen and (min-width: 990px) {
  media-gallery[data-desktop-layout="thumbnail_slider"] {
    display: flex;
    flex-direction: row-reverse;
    align-items: flex-start;
    gap: 1.5rem;
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .slider-mobile-gutter:not(.thumbnail-slider) {
    flex-grow: 1;
    width: calc(100% - 80px - 1.5rem);
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .thumbnail-slider {
    width: 80px;
    flex-shrink: 0;
    margin-top: 0;
    display: block;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y pinch-zoom;
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .thumbnail-list {
    flex-direction: column !important;
    padding-bottom: 0;
    margin: 0;
    gap: 1rem;
    height: 500px; /* fixed height for vertical scroll */
    overflow-y: auto;
    overflow-x: hidden;
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .thumbnail-list::-webkit-scrollbar {
    display: none;
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .thumbnail-list__item {
    width: 100% !important;
  }
  media-gallery[data-desktop-layout="thumbnail_slider"] .thumbnail-slider .slider-button {
    display: none !important; /* Hide horizontal arrows */
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var DURATION_HOURS = 3;
  var DURATION_MS = DURATION_HOURS * 60 * 60 * 1000;
  var STORAGE_KEY = 'pv_offer_timer_end';

  var endTime = localStorage.getItem(STORAGE_KEY);
  var now = new Date().getTime();

  // If no timer exists, or it has expired, reset it
  if (!endTime || now > parseInt(endTime, 10)) {
    endTime = now + DURATION_MS;
    localStorage.setItem(STORAGE_KEY, endTime);
  } else {
    endTime = parseInt(endTime, 10);
  }

  function updateTimer() {
    // Query the DOM on every tick so it survives Shopify's variant AJAX HTML replacement
    var timerEl = document.getElementById('pv-countdown-timer');
    if (!timerEl) return;

    var currentTime = new Date().getTime();
    var timeLeft = endTime - currentTime;

    if (timeLeft <= 0) {
      timerEl.innerHTML = "00:00:00";
      // Auto-reset when it hits zero to keep the urgency loop
      endTime = currentTime + DURATION_MS;
      localStorage.setItem(STORAGE_KEY, endTime);
      return;
    }

    var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
    var seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

    var formatted = (hours < 10 ? "0" + hours : hours) + ":" +
                    (minutes < 10 ? "0" + minutes : minutes) + ":" +
                    (seconds < 10 ? "0" + seconds : seconds);
                    
    timerEl.innerHTML = formatted;
  }

  updateTimer();
  setInterval(updateTimer, 1000);
});
</script>
