<script>
// PawVoyage: Hide variant picker from right sticky card
// Runs immediately and also after Shopify section reloads
(function pvHideRightColVariants() {
  function hidePickerInCard() {
    var card = document.querySelector('.pv-sticky-card');
    if (!card) return;
    // Dawn renders the picker as <variant-selects>, not <product-variant-picker>
    // Use clip+height approach so radio inputs remain in DOM for form submission
    var allHide = card.querySelectorAll('variant-selects, .pv-size-reassurance, .pv-pre-size-box');
    allHide.forEach(function(el) { 
      el.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;';
    });
  }
  
  if (document.readyState !== 'loading') {
    hidePickerInCard();
  } else {
    document.addEventListener('DOMContentLoaded', hidePickerInCard);
  }
  // Re-run after Shopify updates
  document.addEventListener('shopify:section:load', hidePickerInCard);
  // Also run after a short delay in case of deferred rendering
  setTimeout(hidePickerInCard, 500);
  setTimeout(hidePickerInCard, 1500);
})();
</script>

