{{ 'pawvoyage-brand.css' | asset_url | stylesheet_tag }}

<section class="pv-trust section-{{ section.id }}" id="pv-trust-{{ section.id }}">
  <div class="page-width pv-trust__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'badge' -%}
        <div class="pv-trust__badge" {{ block.shopify_attributes }}>
          <span class="pv-trust__icon">
            {%- case block.settings.icon_type -%}
              {%- when 'secure' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {%- when 'returns' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.43"/></svg>
              {%- when 'paw' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><circle cx="4" cy="13" r="2"/><path d="M14.5 17.5c0 2.5-5 2.5-5 0 0-3 2.5-7 2.5-7s2.5 4 2.5 7z"/></svg>
              {%- when 'shipping' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'star' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when 'shield' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
              {%- else -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- endcase -%}
          </span>
          <span class="pv-trust__label">{{ block.settings.label }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .pv-trust {
    background: #2D5016;
    padding: 1.6rem 0;
  }
  .pv-trust__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.4rem 4rem;
  }
  .pv-trust__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: #FAF7F2;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .pv-trust__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.9;
  }
  @media (max-width: 749px) {
    .pv-trust { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "PV Trust Badges",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon",
          "options": [
            { "value": "secure",   "label": "Lock / Secure" },
            { "value": "returns",  "label": "Return Arrow" },
            { "value": "paw",      "label": "Paw Print" },
            { "value": "shipping", "label": "Truck / Shipping" },
            { "value": "star",     "label": "Star / Rating" },
            { "value": "shield",   "label": "Shield / Guarantee" }
          ],
          "default": "secure"
        },
        { "type": "text", "id": "label", "label": "Badge label", "default": "Secure Checkout" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PV Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon_type": "secure",   "label": "Secure Checkout" } },
        { "type": "badge", "settings": { "icon_type": "returns",  "label": "30-Day Returns" } },
        { "type": "badge", "settings": { "icon_type": "paw",      "label": "Pet-Friendly Design" } },
        { "type": "badge", "settings": { "icon_type": "shipping", "label": "Free Shipping Over $50" } }
      ]
    }
  ]
}
{% endschema %}
