<script>
(function(){
  'use strict';

  /* ── Carousel ── */
  var track = document.getElementById('pvec-track-{{ section.id }}');
  var prev  = document.getElementById('pvec-prev-{{ section.id }}');
  var next  = document.getElementById('pvec-next-{{ section.id }}');

  function cardW(){ var c = track && track.querySelector('.pvec-card'); return c ? c.offsetWidth + 20 : 260; }
  function updArrows(){
    if (!prev || !next || !track) return;
    prev.disabled = track.scrollLeft <= 4;
    next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
  }
  if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -cardW() * 2, behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ track.scrollBy({ left:  cardW() * 2, behavior: 'smooth' }); });
  if (track){ track.addEventListener('scroll', updArrows, { passive: true }); updArrows(); }

  /* ── Cart-drawer opener helper ── */
  function openCartDrawer(itemCount){
    /* 1. Dawn's native cart-drawer custom element */
    var drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') { drawer.open(); return; }
    /* 2. Dispatch event some themes listen to */
    document.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
    /* 3. Update cart bubble count if present */
    document.querySelectorAll(
      '.cart-count-bubble span, .cart-count-bubble, [data-cart-count], #cart-icon-bubble span'
    ).forEach(function(el){ el.textContent = itemCount; });
    /* 4. Trigger Dawn's cart refresh via fetch */
    var cartDrawerEl = document.querySelector('cart-drawer-items');
    if (cartDrawerEl && cartDrawerEl.refresh) { cartDrawerEl.refresh(); }
  }

  /* ── Add-to-Cart handler ── */
  var sec = document.getElementById('pvec-{{ section.id }}');
  if (!sec) return;

  sec.addEventListener('click', function(e){
    var btn = e.target.closest('[data-atc-btn]');
    if (!btn || btn.disabled) return;

    var vid = btn.getAttribute('data-variant-id');
    if (!vid) return;

    var origText = btn.textContent.trim();
    btn.disabled = true;
    btn.classList.add('pvec-card__atc--loading');
    btn.textContent = '\u22EF Adding\u2026';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ id: parseInt(vid, 10), quantity: 1, sections_url: window.location.pathname })
    })
    .then(function(r){
      if (!r.ok) throw new Error('cart/add failed ' + r.status);
      return r.json();
    })
    .then(function(d){
      btn.classList.remove('pvec-card__atc--loading');
      if (d && d.id) {
        btn.textContent = '\u2713 Added!';
        btn.classList.add('pvec-card__atc--added');

        /* Update cart count + try to open drawer */
        fetch('/cart.js')
          .then(function(r){ return r.json(); })
          .then(function(cart){
            openCartDrawer(cart.item_count);
            /* Dawn's SectionRenderer — force cart bubble update */
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: { cart: cart } }));
          });

        setTimeout(function(){
          btn.textContent = origText;
          btn.classList.remove('pvec-card__atc--added');
          btn.disabled = false;
        }, 2400);

      } else {
        btn.textContent = origText;
        btn.disabled = false;
      }
    })
    .catch(function(err){
      console.warn('[PawVoyage ATC]', err);
      btn.classList.remove('pvec-card__atc--loading');
      btn.textContent = origText;
      btn.disabled = false;
      /* Hard fallback: redirect to cart */
      window.location.href = '/cart';
    });
  });
})();
</script>

