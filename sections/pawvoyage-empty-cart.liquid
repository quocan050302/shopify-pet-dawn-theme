{% comment %} pawvoyage-empty-cart.liquid — only renders when cart is empty {% endcomment %}

{%- if cart == empty -%}
{%- liquid
  assign cta_link = section.settings.cta_link | default: '/collections/all'
-%}

<section id="pvec-{{ section.id }}" class="pvec-section" aria-label="Empty cart">

  <!-- ═══════════════════════════════════════
       1. HERO
  ═══════════════════════════════════════════ -->
  <div class="pvec-hero">
    <div class="pvec-hero__inner page-width">

      <!-- Left -->
      <div class="pvec-hero__left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="pvec-hero__eyebrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#D4A843" aria-hidden="true"><ellipse cx="12" cy="8" rx="4" ry="3"/><ellipse cx="6" cy="11" rx="2.5" ry="2"/><ellipse cx="18" cy="11" rx="2.5" ry="2"/><path d="M7 16c0 4 10 4 10 0 0-3-2.5-6-5-6s-5 3-5 6z"/></svg>
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        <h1 class="pvec-hero__heading">{{ section.settings.hero_heading | default: 'Your cart is looking a little lonely.' }}</h1>
        <p class="pvec-hero__sub">{{ section.settings.hero_subtext | default: "Looks like you haven't added anything yet. Let's fix that—your adventure buddy is waiting!" }}</p>

        <a href="{{ cta_link }}" class="pvec-hero__cta" id="pvec-cta-{{ section.id }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {{ section.settings.cta_text | default: 'Continue Shopping' }}
        </a>

        <div class="pvec-trust" aria-label="Trust badges">
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            <span>{{ section.settings.trust_1 | default: '30-Day Risk-Free Trial' }}</span>
          </div>
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h5l3 6v4h-8V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>{{ section.settings.trust_2 | default: 'Fast &amp; Free Shipping Over $50' }}</span>
          </div>
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span>{{ section.settings.trust_3 | default: 'Loved by 10,000+ Dog Owners' }}</span>
          </div>
        </div>
      </div>

      <!-- Right: Dog image + speech bubble -->
      <div class="pvec-hero__right">
        {%- if section.settings.hero_image != blank -%}
          {%- assign img = section.settings.hero_image -%}
          <img
            class="pvec-hero__dog-img"
            src="{{ img | image_url: width: 800 }}"
            srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 900 }} 900w"
            sizes="(max-width:749px) 90vw, 45vw"
            alt="{{ img.alt | default: 'Sad dog waiting' | escape }}"
            width="700"
            height="{{ 700 | divided_by: img.aspect_ratio | round }}"
            loading="eager"
          >
        {%- else -%}
          <div class="pvec-hero__dog-placeholder" aria-label="Upload dog image in Theme Customizer">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Upload dog image<br>in Theme Customizer</p>
          </div>
        {%- endif -%}

        {%- if section.settings.speech_bubble != blank -%}
          <div class="pvec-hero__bubble" aria-label="Speech bubble">
            <svg class="pvec-hero__bubble-heart" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {{ section.settings.speech_bubble }}
            <span class="pvec-hero__bubble-tail" aria-hidden="true"></span>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  <!-- ═══════════════════════════════════════
       2. YOU MIGHT ALSO LOVE — dynamic variant cards
  ═══════════════════════════════════════════ -->
  {%- liquid
    assign rec_product  = section.settings.recommended_product
    assign max_show     = section.settings.max_variants_to_show | default: 5
    assign show_rating  = section.settings.show_rating
    assign rating_text  = section.settings.rating_text | default: '★★★★★ (1,247)'
    assign fallback_img = section.settings.fallback_image
    assign size_order   = 'XS,S,M,L,XL'
    assign size_array   = size_order | split: ','
  -%}

  {%- if rec_product != blank or request.design_mode -%}

    {%- if rec_product != blank -%}
      {%- assign has_any_available = false -%}
      {%- for v in rec_product.variants -%}
        {%- if v.available -%}{%- assign has_any_available = true -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign has_any_available = false -%}
    {%- endif -%}

  <div class="pvec-recs" id="pvec-recs-{{ section.id }}" {% unless has_any_available or request.design_mode %}style="display:none"{% endunless %}>
    <div class="pvec-recs__inner page-width">
      <div class="pvec-recs__header">
        <h2 class="pvec-recs__heading">{{ section.settings.recs_heading | default: 'You Might Also Love' }}</h2>
        <div class="pvec-recs__divider" aria-hidden="true"></div>
      </div>

      {%- if rec_product == blank and request.design_mode -%}
        <div style="background:#FFF8E7;border:2px dashed #D4A843;border-radius:16px;padding:2.4rem;text-align:center;color:#5A4A1A;font-size:1.4rem;line-height:1.6;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.8" style="margin-bottom:.8rem" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 8v4m0 4h.01"/></svg><br>
          <strong>Select a product in Theme Customizer</strong><br>
          Go to <em>Recommended Products → Product to feature</em> and pick your harness product.<br>
          Variant cards will appear here automatically — only in-stock sizes shown.
        </div>
      {%- else -%}
      <div class="pvec-carousel-outer" role="region" aria-label="Recommended products carousel">
        <button class="pvec-arrow pvec-arrow--prev" id="pvec-prev-{{ section.id }}" aria-label="Previous" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <div class="pvec-track" id="pvec-track-{{ section.id }}" role="list">

          {%- comment -%} ─── PASS 1: Standard sizes in order XS → XL ─── {%- endcomment -%}
          {%- assign rendered_count = 0 -%}
          {%- assign rendered_ids = '' -%}

          {%- for size in size_array -%}
            {%- if rendered_count >= max_show -%}{%- break -%}{%- endif -%}
            {%- for variant in rec_product.variants -%}
              {%- unless variant.available -%}{%- continue -%}{%- endunless -%}
              {%- assign v_title_up = variant.title | upcase -%}
              {%- assign size_up = size | upcase -%}
              {%- unless v_title_up == size_up or v_title_up contains size_up -%}{%- continue -%}{%- endunless -%}
              {%- assign already = rendered_ids | split: ',' -%}
              {%- assign vid_str = variant.id | append: '' -%}
              {%- unless already contains vid_str -%}
                {%- liquid
                  if variant.featured_image != blank
                    assign v_img = variant.featured_image
                  elsif fallback_img != blank
                    assign v_img = fallback_img
                  else
                    assign v_img = rec_product.featured_image
                  endif
                  assign v_size_label = 'Size ' | append: variant.title
                  assign v_card_title = rec_product.title | append: ' — ' | append: variant.title
                -%}
                <article class="pvec-card pvec-card--variant" role="listitem"
                  data-variant-id="{{ variant.id }}"
                  data-variant-available="true">
                  <div class="pvec-card__img-wrap">
                    {%- if v_img != blank -%}
                      <img
                        class="pvec-card__img"
                        src="{{ v_img | image_url: width: 500 }}"
                        srcset="{{ v_img | image_url: width: 250 }} 250w, {{ v_img | image_url: width: 500 }} 500w"
                        sizes="(max-width:749px) 80vw, 22vw"
                        alt="{{ v_img.alt | default: v_card_title | escape }}"
                        width="500" height="500"
                        loading="lazy"
                      >
                    {%- else -%}
                      <div class="pvec-card__img-placeholder" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                      </div>
                    {%- endif -%}
                    <span class="pvec-card__label">{{ v_size_label }}</span>
                  </div>

                  <div class="pvec-card__body">
                    <h3 class="pvec-card__title">{{ v_card_title | escape }}</h3>

                    {%- if show_rating -%}
                      <div class="pvec-card__stars" aria-label="{{ rating_text | escape }}">
                        <span class="pvec-card__stars-icons" aria-hidden="true">★★★★★</span>
                        <span class="pvec-card__rating-text">{{ rating_text }}</span>
                      </div>
                    {%- endif -%}

                    <div class="pvec-card__price">
                      {{ variant.price | money }}
                      {%- if variant.compare_at_price > variant.price -%}
                        <s class="pvec-card__compare">{{ variant.compare_at_price | money }}</s>
                      {%- endif -%}
                    </div>

                    <button
                      class="pvec-card__atc"
                      type="button"
                      data-variant-id="{{ variant.id }}"
                      data-atc-btn
                      aria-label="Add {{ v_card_title | escape }} to cart"
                    >{{ section.settings.atc_text | default: 'Add to Cart' }}</button>
                  </div>
                </article>
                {%- assign rendered_ids = rendered_ids | append: vid_str | append: ',' -%}
                {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endfor -%}

          {%- comment -%} ─── PASS 2: Remaining available variants not already shown ─── {%- endcomment -%}
          {%- for variant in rec_product.variants -%}
            {%- if rendered_count >= max_show -%}{%- break -%}{%- endif -%}
            {%- unless variant.available -%}{%- continue -%}{%- endunless -%}
            {%- assign vid_str = variant.id | append: '' -%}
            {%- assign already = rendered_ids | split: ',' -%}
            {%- if already contains vid_str -%}{%- continue -%}{%- endif -%}
            {%- liquid
              if variant.featured_image != blank
                assign v_img = variant.featured_image
              elsif fallback_img != blank
                assign v_img = fallback_img
              else
                assign v_img = rec_product.featured_image
              endif
              assign v_size_label = 'Size ' | append: variant.title
              assign v_card_title = rec_product.title | append: ' — ' | append: variant.title
            -%}
            <article class="pvec-card pvec-card--variant" role="listitem"
              data-variant-id="{{ variant.id }}"
              data-variant-available="true">
              <div class="pvec-card__img-wrap">
                {%- if v_img != blank -%}
                  <img
                    class="pvec-card__img"
                    src="{{ v_img | image_url: width: 500 }}"
                    srcset="{{ v_img | image_url: width: 250 }} 250w, {{ v_img | image_url: width: 500 }} 500w"
                    sizes="(max-width:749px) 80vw, 22vw"
                    alt="{{ v_img.alt | default: v_card_title | escape }}"
                    width="500" height="500"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="pvec-card__img-placeholder" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                {%- endif -%}
                <span class="pvec-card__label">{{ v_size_label }}</span>
              </div>

              <div class="pvec-card__body">
                <h3 class="pvec-card__title">{{ v_card_title | escape }}</h3>

                {%- if show_rating -%}
                  <div class="pvec-card__stars" aria-label="{{ rating_text | escape }}">
                    <span class="pvec-card__stars-icons" aria-hidden="true">★★★★★</span>
                    <span class="pvec-card__rating-text">{{ rating_text }}</span>
                  </div>
                {%- endif -%}

                <div class="pvec-card__price">
                  {{ variant.price | money }}
                  {%- if variant.compare_at_price > variant.price -%}
                    <s class="pvec-card__compare">{{ variant.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>

                <button
                  class="pvec-card__atc"
                  type="button"
                  data-variant-id="{{ variant.id }}"
                  data-atc-btn
                  aria-label="Add {{ v_card_title | escape }} to cart"
                >{{ section.settings.atc_text | default: 'Add to Cart' }}</button>
              </div>
            </article>
            {%- assign rendered_ids = rendered_ids | append: vid_str | append: ',' -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
          {%- endfor -%}

        </div>{%- comment -%}/.pvec-track{%- endcomment -%}

        <button class="pvec-arrow pvec-arrow--next" id="pvec-next-{{ section.id }}" aria-label="Next" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>{%- comment -%}/.pvec-carousel-outer{%- endcomment -%}
      {%- endif -%}{%- comment -%}end design_mode placeholder vs carousel{%- endcomment -%}
    </div>{%- comment -%}/.pvec-recs__inner{%- endcomment -%}
  </div>{%- comment -%}/.pvec-recs{%- endcomment -%}
  {%- endif -%}


  <!-- ═══════════════════════════════════════
       3. ACCOUNT LOGIN — only for guests
  ═══════════════════════════════════════════ -->
  {%- if customer == null and shop.customer_accounts_enabled -%}
  <div class="pvec-login-bar">
    <div class="pvec-login-bar__inner page-width">
      <div class="pvec-login-bar__card">

        <!-- Avatar badge -->
        <div class="pvec-login-bar__avatar" aria-hidden="true">
          <div class="pvec-login-bar__avatar-ring">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
        </div>

        <!-- Eyebrow + heading -->
        <p class="pvec-login-bar__eyebrow">Members-only perks</p>
        <h2 class="pvec-login-bar__heading">Already have an account?</h2>
        <p class="pvec-login-bar__sub">Sign in for faster checkout, order tracking, and exclusive member deals.</p>

        <!-- Perks chips -->
        <div class="pvec-login-bar__perks" aria-label="Account benefits">
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Faster checkout
          </span>
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Order tracking
          </span>
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Member deals
          </span>
        </div>

        <!-- CTAs -->
        <div class="pvec-login-bar__ctas">
          <a href="{{ routes.account_login_url }}" class="pvec-login-bar__btn-primary" id="pvec-signin-{{ section.id }}">Sign In</a>
          <a href="{{ routes.account_register_url }}" class="pvec-login-bar__btn-ghost">Create Account</a>
        </div>

      </div>
    </div>
  </div>
  {%- endif -%}

</section>
{%- endif -%}


<style>
/* Hide default Dawn empty-cart block — replaced by our custom section */
cart-items.is-empty { display: none !important; }

#pvec-{{ section.id }} {
  font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  --pvec-green:  #133316;
  --pvec-gold:   #D4A843;
  --pvec-cream:  #FAF7F0;
  --pvec-white:  #FFFFFF;
  --pvec-text:   #2A3228;
  --pvec-muted:  #6B7568;
  --pvec-border: rgba(19,51,22,.1);
}

/* ── HERO ── */
#pvec-{{ section.id }} .pvec-hero {
  background: var(--pvec-cream);
  padding: 6rem 0 5rem;
  overflow: hidden;
}
#pvec-{{ section.id }} .pvec-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
#pvec-{{ section.id }} .pvec-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: .6rem;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pvec-gold);
  margin-bottom: 1.4rem;
}
#pvec-{{ section.id }} .pvec-hero__heading {
  font-size: clamp(3rem, 4.5vw, 4.8rem);
  font-weight: 900;
  color: var(--pvec-green);
  line-height: 1.1;
  letter-spacing: -.025em;
  margin: 0 0 1.4rem;
}
#pvec-{{ section.id }} .pvec-hero__sub {
  font-size: clamp(1.5rem, 2vw, 1.75rem);
  color: var(--pvec-muted);
  line-height: 1.6;
  margin: 0 0 2.8rem;
  max-width: 48ch;
}
#pvec-{{ section.id }} .pvec-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: .9rem;
  background: var(--pvec-green);
  color: #fff;
  font-size: 1.6rem;
  font-weight: 800;
  padding: 1.5rem 3.2rem;
  border-radius: 999px;
  text-decoration: none;
  box-shadow: 0 8px 28px rgba(19,51,22,.22);
  margin-bottom: 3.2rem;
  transition: background .25s, transform .25s, box-shadow .25s;
}
#pvec-{{ section.id }} .pvec-hero__cta:hover {
  background: #1A4A20;
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(19,51,22,.28);
}
#pvec-{{ section.id }} .pvec-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 1.8rem 3.2rem;
}
#pvec-{{ section.id }} .pvec-trust__item {
  display: flex;
  align-items: center;
  gap: .7rem;
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--pvec-text);
  line-height: 1.35;
}
#pvec-{{ section.id }} .pvec-trust__item svg { flex-shrink: 0; }
#pvec-{{ section.id }} .pvec-hero__right {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
#pvec-{{ section.id }} .pvec-hero__dog-img {
  width: 100%;
  max-width: 450px;
  height: auto;
  display: block;
  border-radius: 24px;
  object-fit: cover;
  filter: drop-shadow(0 20px 40px rgba(19,51,22,.12));
}
#pvec-{{ section.id }} .pvec-hero__dog-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background: rgba(212,168,67,.07);
  border: 2px dashed rgba(212,168,67,.4);
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: var(--pvec-muted);
  font-size: 1.3rem;
  text-align: center;
  padding: 2rem;
}
#pvec-{{ section.id }} .pvec-hero__bubble {
  position: absolute;
  top: 6%;
  right: 0;
  background: #fff;
  border: 1px solid var(--pvec-border);
  border-radius: 18px;
  padding: 1.2rem 1.6rem;
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--pvec-text);
  line-height: 1.4;
  max-width: 200px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(19,51,22,.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
}
#pvec-{{ section.id }} .pvec-hero__bubble-tail {
  position: absolute;
  bottom: -14px;
  left: 28px;
  width: 18px;
  height: 14px;
  background: #fff;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  filter: drop-shadow(0 3px 3px rgba(19,51,22,.08));
}

/* ── RECOMMENDED PRODUCTS ── */
#pvec-{{ section.id }} .pvec-recs {
  background: #FFFDF8;
  padding: 6rem 0;
}
#pvec-{{ section.id }} .pvec-recs__header {
  text-align: center;
  margin-bottom: 3.6rem;
}
#pvec-{{ section.id }} .pvec-recs__heading {
  font-size: clamp(2.4rem, 3vw, 3.2rem);
  font-weight: 800;
