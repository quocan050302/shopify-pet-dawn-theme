{% comment %} pawvoyage-empty-cart.liquid — only renders when cart is empty {% endcomment %}

{%- if cart == empty -%}
{%- liquid
  assign cta_link = section.settings.cta_link | default: '/collections/all'
-%}

<section id="pvec-{{ section.id }}" class="pvec-section" aria-label="Empty cart">

  <!-- ═══════════════════════════════════════
       1. HERO
  ═══════════════════════════════════════════ -->
  <div class="pvec-hero">
    <div class="pvec-hero__inner page-width">

      <!-- Left -->
      <div class="pvec-hero__left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="pvec-hero__eyebrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#D4A843" aria-hidden="true"><ellipse cx="12" cy="8" rx="4" ry="3"/><ellipse cx="6" cy="11" rx="2.5" ry="2"/><ellipse cx="18" cy="11" rx="2.5" ry="2"/><path d="M7 16c0 4 10 4 10 0 0-3-2.5-6-5-6s-5 3-5 6z"/></svg>
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        <h1 class="pvec-hero__heading">{{ section.settings.hero_heading | default: 'Your cart is looking a little lonely.' }}</h1>
        <p class="pvec-hero__sub">{{ section.settings.hero_subtext | default: "Looks like you haven't added anything yet. Let's fix that—your adventure buddy is waiting!" }}</p>

        <a href="{{ cta_link }}" class="pvec-hero__cta" id="pvec-cta-{{ section.id }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          {{ section.settings.cta_text | default: 'Continue Shopping' }}
        </a>

        <div class="pvec-trust" aria-label="Trust badges">
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            <span>{{ section.settings.trust_1 | default: '30-Day Risk-Free Trial' }}</span>
          </div>
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h5l3 6v4h-8V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>{{ section.settings.trust_2 | default: 'Fast &amp; Free Shipping Over $50' }}</span>
          </div>
          <div class="pvec-trust__item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span>{{ section.settings.trust_3 | default: 'Loved by 10,000+ Dog Owners' }}</span>
          </div>
        </div>
      </div>

      <!-- Right: Dog image + speech bubble -->
      <div class="pvec-hero__right">
        {%- if section.settings.hero_image != blank -%}
          {%- assign img = section.settings.hero_image -%}
          <img
            class="pvec-hero__dog-img"
            src="{{ img | image_url: width: 800 }}"
            srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 900 }} 900w"
            sizes="(max-width:749px) 90vw, 45vw"
            alt="{{ img.alt | default: 'Sad dog waiting' | escape }}"
            width="700"
            height="{{ 700 | divided_by: img.aspect_ratio | round }}"
            loading="eager"
          >
        {%- else -%}
          <div class="pvec-hero__dog-placeholder" aria-label="Upload dog image in Theme Customizer">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Upload dog image<br>in Theme Customizer</p>
          </div>
        {%- endif -%}

        {%- if section.settings.speech_bubble != blank -%}
          <div class="pvec-hero__bubble" aria-label="Speech bubble">
            <svg class="pvec-hero__bubble-heart" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {{ section.settings.speech_bubble }}
            <span class="pvec-hero__bubble-tail" aria-hidden="true"></span>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  <!-- ═══════════════════════════════════════
       2. YOU MIGHT ALSO LOVE
  ═══════════════════════════════════════════ -->
  {%- if section.blocks.size > 0 -%}
  <div class="pvec-recs" id="pvec-recs-{{ section.id }}">
    <div class="pvec-recs__inner page-width">
      <div class="pvec-recs__header">
        <h2 class="pvec-recs__heading">{{ section.settings.recs_heading | default: 'You might also love' }}</h2>
        <div class="pvec-recs__divider" aria-hidden="true"></div>
      </div>

      <div class="pvec-carousel-outer" role="region" aria-label="Recommended products">
        <button class="pvec-arrow pvec-arrow--prev" id="pvec-prev-{{ section.id }}" aria-label="Previous products" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <div class="pvec-track" id="pvec-track-{{ section.id }}" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'recommended_item' -%}
              {%- liquid
                assign rec_product   = block.settings.product
                assign custom_title  = block.settings.custom_title
                assign custom_rating = block.settings.custom_rating_text
                assign custom_price  = block.settings.custom_price_text
                assign custom_label  = block.settings.custom_label
                assign card_image    = block.settings.custom_image

                if rec_product != blank
                  assign card_product = rec_product
                  assign card_variant = rec_product.selected_or_first_available_variant
                  assign card_title   = custom_title | default: rec_product.title
                  assign card_avail   = card_variant.available
                  assign card_vid     = card_variant.id
                  if card_image == blank
                    if card_variant.image != blank
                      assign card_image = card_variant.image
                    else
                      assign card_image = rec_product.featured_image
                    endif
                  endif
                else
                  assign card_product = null
                  assign card_variant = null
                  assign card_title   = custom_title | default: 'PawVoyage Harness'
                  assign card_avail   = false
                  assign card_vid     = ''
                endif
              -%}

              <article class="pvec-card" role="listitem" {{ block.shopify_attributes }}>
                <div class="pvec-card__img-wrap">
                  {%- if card_image != blank -%}
                    <img
                      class="pvec-card__img"
                      src="{{ card_image | image_url: width: 500 }}"
                      srcset="{{ card_image | image_url: width: 250 }} 250w, {{ card_image | image_url: width: 500 }} 500w"
                      sizes="(max-width:749px) 72vw, 22vw"
                      alt="{{ card_image.alt | default: card_title | escape }}"
                      width="500"
                      height="{{ 500 | divided_by: card_image.aspect_ratio | round }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="pvec-card__img-placeholder">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="1.2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                  {%- endif -%}
                  {%- if custom_label != blank -%}
                    <span class="pvec-card__label">{{ custom_label }}</span>
                  {%- endif -%}
                </div>

                <div class="pvec-card__body">
                  <h3 class="pvec-card__title">{{ card_title }}</h3>

                  {%- if custom_rating != blank -%}
                    <div class="pvec-card__stars" aria-label="{{ custom_rating }}">
                      <span aria-hidden="true">★★★★★</span>
                      <span class="pvec-card__rating-text">{{ custom_rating }}</span>
                    </div>
                  {%- endif -%}

                  <div class="pvec-card__price">
                    {%- if card_product != blank -%}
                      {{ card_variant.price | money }}
                      {%- if card_variant.compare_at_price > card_variant.price -%}
                        <s class="pvec-card__compare">{{ card_variant.compare_at_price | money }}</s>
                      {%- endif -%}
                    {%- elsif custom_price != blank -%}
                      {{ custom_price }}
                    {%- endif -%}
                  </div>

                  {%- if card_product != blank -%}
                    {%- if card_avail -%}
                      <button
                        class="pvec-card__atc"
                        type="button"
                        data-variant-id="{{ card_vid }}"
                        aria-label="Add {{ card_title | escape }} to cart"
                      >{{ section.settings.atc_text | default: 'Add to Cart' }}</button>
                    {%- else -%}
                      <button class="pvec-card__atc pvec-card__atc--disabled" type="button" disabled aria-disabled="true">{{ 'products.product.sold_out' | t }}</button>
                    {%- endif -%}
                  {%- else -%}
                    <button class="pvec-card__atc pvec-card__atc--disabled" type="button" disabled aria-disabled="true">{{ section.settings.atc_text | default: 'Add to Cart' }}</button>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button class="pvec-arrow pvec-arrow--next" id="pvec-next-{{ section.id }}" aria-label="Next products" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </div>
  </div>
  {%- endif -%}


  <!-- ═══════════════════════════════════════
       3. ACCOUNT LOGIN — only for guests
  ═══════════════════════════════════════════ -->
  {%- if customer == null and shop.customer_accounts_enabled -%}
  <div class="pvec-login-bar">
    <div class="pvec-login-bar__inner page-width">
      <div class="pvec-login-bar__card">

        <!-- Avatar badge -->
        <div class="pvec-login-bar__avatar" aria-hidden="true">
          <div class="pvec-login-bar__avatar-ring">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
        </div>

        <!-- Eyebrow + heading -->
        <p class="pvec-login-bar__eyebrow">Members-only perks</p>
        <h2 class="pvec-login-bar__heading">Already have an account?</h2>
        <p class="pvec-login-bar__sub">Sign in for faster checkout, order tracking, and exclusive member deals.</p>

        <!-- Perks chips -->
        <div class="pvec-login-bar__perks" aria-label="Account benefits">
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Faster checkout
          </span>
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Order tracking
          </span>
          <span class="pvec-login-bar__chip">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            Member deals
          </span>
        </div>

        <!-- CTAs -->
        <div class="pvec-login-bar__ctas">
          <a href="{{ routes.account_login_url }}" class="pvec-login-bar__btn-primary" id="pvec-signin-{{ section.id }}">Sign In</a>
          <a href="{{ routes.account_register_url }}" class="pvec-login-bar__btn-ghost">Create Account</a>
        </div>

      </div>
    </div>
  </div>
  {%- endif -%}

</section>
{%- endif -%}


<style>
/* Hide default Dawn empty-cart block — replaced by our custom section */
cart-items.is-empty { display: none !important; }

#pvec-{{ section.id }} {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
  --pvec-green:  #133316;
  --pvec-gold:   #D4A843;
  --pvec-cream:  #FAF7F0;
  --pvec-white:  #FFFFFF;
  --pvec-text:   #2A3228;
  --pvec-muted:  #6B7568;
  --pvec-border: rgba(19,51,22,.1);
}

/* ── HERO ── */
#pvec-{{ section.id }} .pvec-hero {
  background: var(--pvec-cream);
  padding: 6rem 0 5rem;
  overflow: hidden;
}
#pvec-{{ section.id }} .pvec-hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}
#pvec-{{ section.id }} .pvec-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: .6rem;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pvec-gold);
  margin-bottom: 1.4rem;
}
#pvec-{{ section.id }} .pvec-hero__heading {
  font-size: clamp(3rem, 4.5vw, 4.8rem);
  font-weight: 900;
  color: var(--pvec-green);
  line-height: 1.1;
  letter-spacing: -.025em;
  margin: 0 0 1.4rem;
}
#pvec-{{ section.id }} .pvec-hero__sub {
  font-size: clamp(1.5rem, 2vw, 1.75rem);
  color: var(--pvec-muted);
  line-height: 1.6;
  margin: 0 0 2.8rem;
  max-width: 48ch;
}
#pvec-{{ section.id }} .pvec-hero__cta {
  display: inline-flex;
  align-items: center;
  gap: .9rem;
  background: var(--pvec-green);
  color: #fff;
  font-size: 1.6rem;
  font-weight: 800;
  padding: 1.5rem 3.2rem;
  border-radius: 999px;
  text-decoration: none;
  box-shadow: 0 8px 28px rgba(19,51,22,.22);
  margin-bottom: 3.2rem;
  transition: background .25s, transform .25s, box-shadow .25s;
}
#pvec-{{ section.id }} .pvec-hero__cta:hover {
  background: #1A4A20;
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(19,51,22,.28);
}
#pvec-{{ section.id }} .pvec-trust {
  display: flex;
  flex-wrap: wrap;
  gap: 1.8rem 3.2rem;
}
#pvec-{{ section.id }} .pvec-trust__item {
  display: flex;
  align-items: center;
  gap: .7rem;
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--pvec-text);
  line-height: 1.35;
}
#pvec-{{ section.id }} .pvec-trust__item svg { flex-shrink: 0; }
#pvec-{{ section.id }} .pvec-hero__right {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
#pvec-{{ section.id }} .pvec-hero__dog-img {
  width: 100%;
  max-width: 560px;
  height: auto;
  display: block;
  border-radius: 24px;
  object-fit: cover;
  filter: drop-shadow(0 20px 40px rgba(19,51,22,.12));
}
#pvec-{{ section.id }} .pvec-hero__dog-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background: rgba(212,168,67,.07);
  border: 2px dashed rgba(212,168,67,.4);
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  color: var(--pvec-muted);
  font-size: 1.3rem;
  text-align: center;
  padding: 2rem;
}
#pvec-{{ section.id }} .pvec-hero__bubble {
  position: absolute;
  top: 12%;
  right: 0;
  background: #fff;
  border: 1px solid var(--pvec-border);
  border-radius: 18px;
  padding: 1.2rem 1.6rem;
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--pvec-text);
  line-height: 1.4;
  max-width: 200px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(19,51,22,.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
}
#pvec-{{ section.id }} .pvec-hero__bubble-tail {
  position: absolute;
  bottom: -14px;
  left: 28px;
  width: 18px;
  height: 14px;
  background: #fff;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
  filter: drop-shadow(0 3px 3px rgba(19,51,22,.08));
}

/* ── RECOMMENDED PRODUCTS ── */
#pvec-{{ section.id }} .pvec-recs {
  background: #FFFDF8;
  padding: 6rem 0;
}
#pvec-{{ section.id }} .pvec-recs__header {
  text-align: center;
  margin-bottom: 3.6rem;
}
#pvec-{{ section.id }} .pvec-recs__heading {
  font-size: clamp(2.4rem, 3vw, 3.2rem);
  font-weight: 800;
  color: var(--pvec-green);
  letter-spacing: -.02em;
  margin: 0 0 .8rem;
}
#pvec-{{ section.id }} .pvec-recs__divider {
  width: 48px;
  height: 3px;
  background: var(--pvec-gold);
  border-radius: 99px;
  margin: 0 auto;
}
#pvec-{{ section.id }} .pvec-carousel-outer {
  position: relative;
  overflow: visible;
}
#pvec-{{ section.id }} .pvec-track {
  display: flex;
  gap: 2rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 8px;
}
#pvec-{{ section.id }} .pvec-track::-webkit-scrollbar { display: none; }
#pvec-{{ section.id }} .pvec-card {
  flex: 0 0 calc((100% - 3 * 2rem) / 4);
  min-width: 220px;
  scroll-snap-align: start;
  background: var(--pvec-white);
  border: 1px solid var(--pvec-border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(19,51,22,.07);
  display: flex;
  flex-direction: column;
  transition: transform .25s, box-shadow .25s;
}
#pvec-{{ section.id }} .pvec-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(19,51,22,.12);
}
#pvec-{{ section.id }} .pvec-card__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #F5F1EA;
  overflow: hidden;
}
#pvec-{{ section.id }} .pvec-card__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .4s;
}
#pvec-{{ section.id }} .pvec-card:hover .pvec-card__img { transform: scale(1.04); }
#pvec-{{ section.id }} .pvec-card__img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
#pvec-{{ section.id }} .pvec-card__label {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--pvec-gold);
  color: var(--pvec-green);
  font-size: 1.15rem;
  font-weight: 800;
  padding: .35rem .9rem;
  border-radius: 999px;
}
#pvec-{{ section.id }} .pvec-card__body {
  padding: 1.6rem;
  display: flex;
  flex-direction: column;
  gap: .6rem;
  flex: 1;
}
#pvec-{{ section.id }} .pvec-card__title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--pvec-green);
  line-height: 1.3;
  margin: 0;
}
#pvec-{{ section.id }} .pvec-card__stars {
  display: flex;
  align-items: center;
  gap: .4rem;
  color: var(--pvec-gold);
  font-size: 1.4rem;
}
#pvec-{{ section.id }} .pvec-card__rating-text {
  font-size: 1.2rem;
  color: var(--pvec-muted);
  font-weight: 500;
}
#pvec-{{ section.id }} .pvec-card__price {
  font-size: 1.55rem;
  font-weight: 800;
  color: var(--pvec-text);
  display: flex;
  align-items: center;
  gap: .6rem;
}
#pvec-{{ section.id }} .pvec-card__compare {
  font-size: 1.3rem;
  font-weight: 400;
  color: var(--pvec-muted);
  text-decoration: line-through;
}
#pvec-{{ section.id }} .pvec-card__atc {
  margin-top: auto;
  width: 100%;
  background: var(--pvec-green);
  color: #fff;
  font-size: 1.45rem;
  font-weight: 700;
  padding: 1.1rem 1.6rem;
  border-radius: 10px;
  border: none;
  cursor: pointer;
  transition: background .2s, transform .2s;
  text-align: center;
}
#pvec-{{ section.id }} .pvec-card__atc:hover:not([disabled]) {
  background: #1A4A20;
  transform: translateY(-1px);
}
#pvec-{{ section.id }} .pvec-card__atc--added { background: #2E7D32 !important; }
#pvec-{{ section.id }} .pvec-card__atc--disabled,
#pvec-{{ section.id }} .pvec-card__atc[disabled] {
  background: #C8CFC8;
  cursor: not-allowed;
  opacity: .7;
}
#pvec-{{ section.id }} .pvec-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--pvec-border);
  box-shadow: 0 4px 16px rgba(19,51,22,.12);
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background .2s, box-shadow .2s, transform .2s;
}
#pvec-{{ section.id }} .pvec-arrow:hover {
  background: var(--pvec-green);
  box-shadow: 0 8px 24px rgba(19,51,22,.22);
  transform: translateY(-50%) scale(1.08);
}
#pvec-{{ section.id }} .pvec-arrow:hover svg { stroke: #fff; }
#pvec-{{ section.id }} .pvec-arrow--prev { left: -22px; }
#pvec-{{ section.id }} .pvec-arrow--next { right: -22px; }
#pvec-{{ section.id }} .pvec-arrow:disabled { opacity: .35; pointer-events: none; }

/* ── LOGIN BAR ── */
#pvec-{{ section.id }} .pvec-login-bar {
  background: #F2EDE3;
  padding: 5.6rem 0;
  border-top: 1px solid rgba(19,51,22,.08);
}
#pvec-{{ section.id }} .pvec-login-bar__inner {
  max-width: 680px;
  margin: 0 auto;
  padding: 0 2rem;
}
#pvec-{{ section.id }} .pvec-login-bar__card {
  background: #fff;
  border-radius: 28px;
  box-shadow: 0 8px 40px rgba(19,51,22,.1);
  padding: 4rem 4.8rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0;
}

/* Avatar badge */
#pvec-{{ section.id }} .pvec-login-bar__avatar {
  margin-bottom: 2rem;
}
#pvec-{{ section.id }} .pvec-login-bar__avatar-ring {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: linear-gradient(135deg, #133316 0%, #1e6024 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(19,51,22,.25);
  transition: transform .3s;
}
#pvec-{{ section.id }} .pvec-login-bar__card:hover .pvec-login-bar__avatar-ring {
  transform: scale(1.06);
}

/* Text */
#pvec-{{ section.id }} .pvec-login-bar__eyebrow {
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--pvec-gold);
  margin: 0 0 .6rem;
}
#pvec-{{ section.id }} .pvec-login-bar__heading {
  font-size: clamp(2rem, 3vw, 2.6rem);
  font-weight: 900;
  color: var(--pvec-green);
  letter-spacing: -.025em;
  margin: 0 0 .8rem;
}
#pvec-{{ section.id }} .pvec-login-bar__sub {
  font-size: 1.4rem;
  color: var(--pvec-muted);
  line-height: 1.65;
  margin: 0 0 2rem;
  max-width: 44ch;
}

/* Perks chips */
#pvec-{{ section.id }} .pvec-login-bar__perks {
  display: flex;
  flex-wrap: wrap;
  gap: .8rem;
  justify-content: center;
  margin-bottom: 2.8rem;
}
#pvec-{{ section.id }} .pvec-login-bar__chip {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  background: #FAF7F0;
  border: 1px solid rgba(19,51,22,.1);
  border-radius: 999px;
  padding: .55rem 1.2rem;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--pvec-text);
}
#pvec-{{ section.id }} .pvec-login-bar__chip svg { flex-shrink: 0; }

/* CTAs */
#pvec-{{ section.id }} .pvec-login-bar__ctas {
  display: flex;
  align-items: center;
  gap: 1.6rem;
  flex-wrap: wrap;
  justify-content: center;
}
#pvec-{{ section.id }} .pvec-login-bar__btn-primary {
  display: inline-block;
  background: var(--pvec-green);
  color: #fff;
  font-size: 1.5rem;
  font-weight: 800;
  padding: 1.3rem 3rem;
  border-radius: 999px;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 6px 22px rgba(19,51,22,.22);
  transition: background .2s, transform .2s, box-shadow .2s;
}
#pvec-{{ section.id }} .pvec-login-bar__btn-primary:hover {
  background: #1A4A20;
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(19,51,22,.3);
}
#pvec-{{ section.id }} .pvec-login-bar__btn-ghost {
  display: inline-block;
  color: var(--pvec-green);
  font-size: 1.4rem;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color .2s;
  white-space: nowrap;
}
#pvec-{{ section.id }} .pvec-login-bar__btn-ghost:hover { color: #1A4A20; }

/* ── RESPONSIVE ── */
@media(max-width:1199px){
  #pvec-{{ section.id }} .pvec-card { flex: 0 0 calc((100% - 2 * 2rem) / 3); }
  #pvec-{{ section.id }} .pvec-arrow--prev { left: -16px; }
  #pvec-{{ section.id }} .pvec-arrow--next { right: -16px; }
}
@media(max-width:899px){
  #pvec-{{ section.id }} .pvec-hero { padding: 4rem 0 3rem; }
  #pvec-{{ section.id }} .pvec-card { flex: 0 0 calc((100% - 2rem) / 2); }
  #pvec-{{ section.id }} .pvec-recs { padding: 4.8rem 0; }
}
@media(max-width:749px){
  #pvec-{{ section.id }} .pvec-hero { padding: 3.2rem 0 2.4rem; }
  #pvec-{{ section.id }} .pvec-hero__inner { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
  #pvec-{{ section.id }} .pvec-hero__eyebrow { justify-content: center; }
  #pvec-{{ section.id }} .pvec-hero__sub { margin-left: auto; margin-right: auto; }
  #pvec-{{ section.id }} .pvec-hero__cta { width: 100%; justify-content: center; }
  #pvec-{{ section.id }} .pvec-trust { justify-content: center; gap: 1.4rem 2rem; }
  #pvec-{{ section.id }} .pvec-hero__right { order: -1; justify-content: center; }
  #pvec-{{ section.id }} .pvec-hero__bubble { top: -20px; right: 0; font-size: 1.25rem; max-width: 160px; padding: 1rem 1.2rem; }
  #pvec-{{ section.id }} .pvec-card { flex: 0 0 82vw; max-width: 82vw; min-width: 82vw; }
  #pvec-{{ section.id }} .pvec-arrow { display: none; }
  #pvec-{{ section.id }} .pvec-recs { padding: 3.6rem 0; }
  #pvec-{{ section.id }} .pvec-login-bar { padding: 3.6rem 0; }
  #pvec-{{ section.id }} .pvec-login-bar__card { padding: 3rem 2.4rem; border-radius: 20px; }
  #pvec-{{ section.id }} .pvec-login-bar__avatar-ring { width: 64px; height: 64px; }
  #pvec-{{ section.id }} .pvec-login-bar__perks { gap: .6rem; }
}
@media(max-width:479px){
  #pvec-{{ section.id }} .pvec-hero__bubble { display: none; }
}
</style>

<script>
(function(){
  'use strict';
  var track = document.getElementById('pvec-track-{{ section.id }}');
  var prev  = document.getElementById('pvec-prev-{{ section.id }}');
  var next  = document.getElementById('pvec-next-{{ section.id }}');

  function cardW(){ var c = track && track.querySelector('.pvec-card'); return c ? c.offsetWidth + 20 : 260; }
  function upd(){
    if (!prev || !next || !track) return;
    prev.disabled = track.scrollLeft <= 4;
    next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
  }
  if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -cardW() * 2, behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ track.scrollBy({ left:  cardW() * 2, behavior: 'smooth' }); });
  if (track){ track.addEventListener('scroll', upd, { passive: true }); upd(); }

  var sec = document.getElementById('pvec-{{ section.id }}');
  if (!sec) return;
  sec.addEventListener('click', function(e){
    var btn = e.target.closest('.pvec-card__atc');
    if (!btn || btn.disabled) return;
    var vid = btn.getAttribute('data-variant-id');
    if (!vid) return;
    var orig = btn.textContent.trim();
    btn.disabled = true;
    btn.textContent = 'Adding\u2026';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ id: parseInt(vid, 10), quantity: 1 })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (d.id) {
        btn.textContent = '\u2713 Added!';
        btn.classList.add('pvec-card__atc--added');
        fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart){
          document.querySelectorAll('.cart-count-bubble span, [data-cart-count]').forEach(function(el){ el.textContent = cart.item_count; });
        });
        setTimeout(function(){ btn.textContent = orig; btn.classList.remove('pvec-card__atc--added'); btn.disabled = false; }, 2200);
      } else { btn.textContent = orig; btn.disabled = false; }
    })
    .catch(function(){ btn.textContent = orig; btn.disabled = false; });
  });
})();
</script>

