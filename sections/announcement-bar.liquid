{%- if section.blocks.size > 0 -%}
  <div class="pv-announcement-bar color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    <div class="pv-announcement-bar__marquee">
      <div class="pv-announcement-bar__track">
        {%- capture marquee_content -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <span class="pv-announcement-bar__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="pv-announcement-bar__link">
                {%- endif -%}
                {{ block.settings.text | escape }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
                <span class="pv-announcement-bar__separator">•</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        
        <div class="pv-announcement-bar__content">{{ marquee_content }}</div>
        <div class="pv-announcement-bar__content">{{ marquee_content }}</div>
        <div class="pv-announcement-bar__content">{{ marquee_content }}</div>
        <div class="pv-announcement-bar__content">{{ marquee_content }}</div>
      </div>
    </div>
  </div>

  <style>
    .pv-announcement-bar {
      background: #1C3309;
      color: #C4853A;
      overflow: hidden;
      display: flex;
      align-items: center;
      height: 36px;
    }
    @media screen and (min-width: 750px) {
      .pv-announcement-bar {
        height: 40px;
      }
    }
    .pv-announcement-bar__marquee {
      width: 100%;
      overflow: hidden;
    }
    .pv-announcement-bar__track {
      display: inline-flex;
      white-space: nowrap;
      animation: marquee 40s linear infinite;
    }
    .pv-announcement-bar__content {
      display: inline-flex;
    }
    .pv-announcement-bar__marquee:hover .pv-announcement-bar__track {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .pv-announcement-bar__track {
        animation: none;
        flex-wrap: wrap;
        justify-content: center;
        white-space: normal;
      }
      .pv-announcement-bar__marquee {
        overflow: visible;
      }
      .pv-announcement-bar {
        height: auto;
        padding: 8px 0;
      }
      .pv-announcement-bar__content:not(:first-child) {
        display: none;
      }
    }
    .pv-announcement-bar__item {
      display: inline-flex;
      align-items: center;
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }
    @media screen and (min-width: 750px) {
      .pv-announcement-bar__item {
        font-size: 1.3rem;
      }
    }
    .pv-announcement-bar__link {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;
    }
    .pv-announcement-bar__link:hover {
      color: #FAF7F2;
    }
    .pv-announcement-bar__separator {
      margin: 0 2rem;
      color: #FAF7F2;
      opacity: 0.5;
    }

    @keyframes marquee {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
