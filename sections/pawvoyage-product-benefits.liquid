{%- comment -%}
  PawVoyage Product Benefits Section
  sections/pawvoyage-product-benefits.liquid
{%- endcomment -%}

{%- comment -%} ── SVG icon library (inline, unique per icon_type) ── {%- endcomment -%}
{%- liquid
  assign icons = ''
-%}

<div class="pvb-outer" id="pvb-{{ section.id }}">
  <div class="pvb-wrap">

    {%- comment -%} ── HEADER ── {%- endcomment -%}
    <div class="pvb-header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pvb-eyebrow">
          <svg class="pvb-eyebrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4" stroke-width="2.5"/></svg>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pvb-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pvb-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── BENEFIT CARDS ── {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="pvb-cards-outer">
        <ul class="pvb-cards" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit_card' -%}
              <li class="pvb-card" {{ block.shopify_attributes }}>

                <div class="pvb-card-top">

                  {%- comment -%} Icon: image_picker overrides icon_type SVG {%- endcomment -%}
                  <div class="pvb-icon-wrap" aria-hidden="true">
                    {%- if block.settings.icon != blank -%}
                      <div class="pvb-icon">
                        <img
                          src="{{ block.settings.icon | image_url: width: 80 }}"
                          alt=""
                          width="40" height="40"
                          loading="lazy"
                          class="pvb-icon-img"
                        >
                      </div>
                    {%- else -%}
                      {%- assign icon_type = block.settings.icon_type | default: 'shield' -%}
                      <div class="pvb-icon pvb-icon--svg">
                        {%- case icon_type -%}

                          {%- when 'leash' -%}
                            {%- comment -%} No-pull / leash control {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M4 17h2a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2H4"/>
                              <path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2"/>
                              <path d="M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0"/>
                              <line x1="8" y1="12" x2="10" y2="12"/>
                            </svg>

                          {%- when 'heart' -%}
                            {%- comment -%} Comfort / care {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>

                          {%- when 'sliders' -%}
                            {%- comment -%} Adjustable fit {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="4" y1="6" x2="20" y2="6"/>
                              <line x1="4" y1="12" x2="20" y2="12"/>
                              <line x1="4" y1="18" x2="20" y2="18"/>
                              <circle cx="9" cy="6" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/>
                              <circle cx="9" cy="6" r="2.5"/>
                              <circle cx="15" cy="12" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/>
                              <circle cx="15" cy="12" r="2.5"/>
                              <circle cx="9" cy="18" r="2.5" fill="currentColor" stroke="none" opacity="0.25"/>
                              <circle cx="9" cy="18" r="2.5"/>
                            </svg>

                          {%- when 'diamond' -%}
                            {%- comment -%} Tactical durability / premium {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <polygon points="12 2 22 9 18 22 6 22 2 9"/>
                              <line x1="2" y1="9" x2="22" y2="9"/>
                              <polyline points="6 9 12 2 18 9 12 22 6 9"/>
                            </svg>

                          {%- when 'compass' -%}
                            {%- comment -%} Adventure / exploration {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="12" cy="12" r="10"/>
                              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" opacity="0.2" stroke="none"/>
                              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                            </svg>

                          {%- when 'shield' -%}
                            {%- comment -%} Protection / vet recommended {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                              <path d="M9 12l2 2 4-4" stroke-width="2"/>
                            </svg>

                          {%- when 'paw' -%}
                            {%- comment -%} Dog / pet friendly {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <circle cx="6.5" cy="6.5" r="1.5"/>
                              <circle cx="17.5" cy="6.5" r="1.5"/>
                              <circle cx="4" cy="11" r="1.5"/>
                              <circle cx="20" cy="11" r="1.5"/>
                              <path d="M12 13.5c-3 0-6 2-6 4.5s2.5 3 6 3 6-.5 6-3-3-4.5-6-4.5z"/>
                            </svg>

                          {%- when 'star' -%}
                            {%- comment -%} Quality / top-rated {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>

                          {%- when 'truck' -%}
                            {%- comment -%} Fast shipping {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <rect x="1" y="3" width="15" height="13" rx="2"/>
                              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                              <circle cx="5.5" cy="18.5" r="2.5"/>
                              <circle cx="18.5" cy="18.5" r="2.5"/>
                            </svg>

                          {%- else -%}
                            {%- comment -%} Default fallback: shield {%- endcomment -%}
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>

                        {%- endcase -%}
                      </div>
                    {%- endif -%}
                  </div>

                  <h3 class="pvb-card-title">{{ block.settings.title | escape }}</h3>
                  <p class="pvb-card-desc">{{ block.settings.description | escape }}</p>
                </div>

                {%- comment -%} BOTTOM: image {%- endcomment -%}
                <div class="pvb-card-img-wrap">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        alt: block.settings.image_alt | default: block.settings.title,
                        class: 'pvb-card-img',
                        widths: '300, 400, 600'
                    }}
                  {%- else -%}
                    <div class="pvb-card-img-placeholder" aria-hidden="true">
                      <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="16" width="48" height="36" rx="4"/><circle cx="22" cy="28" r="5"/><path d="M8 44 l14-12 8 8 10-10 14 14"/></svg>
                      <span>Upload image</span>
                    </div>
                  {%- endif -%}
                </div>

              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} Mobile scroll dots — JS driven {%- endcomment -%}
      <div class="pvb-dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit_card' -%}
            <span class="pvb-dot{% if forloop.first %} pvb-dot--active{% endif %}"></span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── TRUST STRIP ── {%- endcomment -%}
    <div class="pvb-trust-strip" role="list" aria-label="Trust badges">

      <div class="pvb-trust-item" role="listitem">
        <svg class="pvb-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4" stroke-width="2"/></svg>
        <span>{{ section.settings.trust_1_label | default: 'Vet Recommended' }}</span>
      </div>

      <div class="pvb-trust-item" role="listitem">
        <svg class="pvb-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>{{ section.settings.trust_2_label | default: 'Loved by 10,000+ Dogs' }}</span>
      </div>

      <div class="pvb-trust-item" role="listitem">
        <svg class="pvb-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        <span>{{ section.settings.trust_3_label | default: '30-Day Risk-Free Trial' }}</span>
      </div>

      <div class="pvb-trust-item" role="listitem">
        <svg class="pvb-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>{{ section.settings.trust_4_label | default: 'Fast &amp; Free Shipping' }}</span>
      </div>

    </div>

  </div>
</div>

<style>
/* ============================================================
   PawVoyage Product Benefits — scoped to #pvb-{{ section.id }}
   ============================================================ */
#pvb-{{ section.id }} {
  --pvb-green:      #12350e;
  --pvb-gold:       #c98a1a;
  --pvb-gold-light: #f5e6bc;
  --pvb-cream:      #fdf7ee;
  --pvb-cream-dk:   #f5edd8;
  --pvb-white:      #ffffff;
  --pvb-text:       #1f241d;
  --pvb-text-sec:   #4a5246;
  --pvb-border:     rgba(31,36,29,0.10);
  --pvb-radius:     16px;
  --pvb-radius-sm:  10px;
  --pvb-shadow:     0 4px 20px rgba(18,53,14,0.09);
  --pvb-font:       'Inter', system-ui, -apple-system, sans-serif;
}

.pvb-outer {
  background: var(--pvb-cream);
  padding: 5.6rem 0 4rem;
}

.pvb-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 3rem;
}

/* ── Header ── */
.pvb-header { margin-bottom: 3.6rem; }

.pvb-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--pvb-font);
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--pvb-gold);
  margin: 0 0 1rem;
}

.pvb-eyebrow-icon {
  width: 15px; height: 15px;
  flex-shrink: 0;
  color: var(--pvb-gold);
}

.pvb-heading {
  font-family: var(--pvb-font);
  font-size: clamp(2.8rem, 4vw, 4.4rem);
  font-weight: 900;
  color: var(--pvb-green);
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0 0 1rem;
}

.pvb-subheading {
  font-size: 1.6rem;
  color: var(--pvb-text-sec);
  line-height: 1.5;
  margin: 0;
  max-width: 520px;
}

/* ── Cards ── */
.pvb-cards-outer { overflow: hidden; }

.pvb-cards {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1.4rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.pvb-card {
  background: var(--pvb-white);
  border: 1px solid var(--pvb-border);
  border-radius: var(--pvb-radius);
  box-shadow: var(--pvb-shadow);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.2s, transform 0.2s;
}

.pvb-card:hover {
  box-shadow: 0 8px 32px rgba(18,53,14,0.14);
  transform: translateY(-3px);
}

/* Card top */
.pvb-card-top {
  padding: 2rem 1.6rem 1.4rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;   /* ← CENTER everything horizontally */
  gap: 0.8rem;
}

/* Icon wrapper — always centered */
.pvb-icon-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
  margin-bottom: 0.4rem;
}

.pvb-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: var(--pvb-gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pvb-icon-img {
  width: 28px; height: 28px;
  object-fit: contain;
  display: block;
}

.pvb-icon--svg svg {
  width: 26px; height: 26px;
  color: var(--pvb-gold);
}

.pvb-card-title {
  font-family: var(--pvb-font);
  font-size: 1.55rem;
  font-weight: 800;
  color: var(--pvb-green);
  line-height: 1.25;
  margin: 0;
  text-align: center;
}

.pvb-card-desc {
  font-size: 1.3rem;
  color: var(--pvb-text-sec);
  line-height: 1.55;
  margin: 0;
  text-align: center;
}

/* Card image */
.pvb-card-img-wrap {
  flex-shrink: 0;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: var(--pvb-cream-dk);
}

.pvb-card-img-wrap img {
  width: 100%;
  height: 100%
}

.pvb-card-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.pvb-card:hover .pvb-card-img { transform: scale(1.04); }

.pvb-card-img-placeholder {
  width: 100%; height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  color: var(--pvb-text-sec);
  opacity: 0.45;
}

.pvb-card-img-placeholder svg { width: 40px; height: 40px; }
.pvb-card-img-placeholder span { font-size: 1.1rem; font-weight: 500; }

/* ── Trust strip ── */
.pvb-trust-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pvb-white);
  border: 1px solid var(--pvb-border);
  border-radius: var(--pvb-radius-sm);
  margin-top: 3.2rem;
  overflow: hidden;
}

.pvb-trust-item {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 1.4rem 2rem;
  flex: 1;
  justify-content: center;
  font-family: var(--pvb-font);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--pvb-text);
  border-right: 1px solid var(--pvb-border);
  transition: background 0.2s;
}

.pvb-trust-item:last-child { border-right: none; }
.pvb-trust-item:hover { background: var(--pvb-cream); }

.pvb-trust-icon {
  width: 18px; height: 18px;
  flex-shrink: 0;
  color: var(--pvb-green);
}

/* ── Tablet ── */
@media screen and (max-width: 1099px) {
  .pvb-wrap { padding: 0 2rem; }
  .pvb-cards { grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .pvb-trust-strip { flex-wrap: wrap; }
  .pvb-trust-item { flex: 1 1 48%; border-right: none; border-bottom: 1px solid var(--pvb-border); }
  .pvb-trust-item:nth-child(odd) { border-right: 1px solid var(--pvb-border); }
  .pvb-trust-item:nth-last-child(-n+2) { border-bottom: none; }
}

/* ── Scroll dots (hidden on desktop) ── */
.pvb-dots {
  display: none;
}

/* ── Mobile ── */
@media screen and (max-width: 749px) {
  .pvb-outer {
    padding: 3.2rem 0 3rem;
  }

  .pvb-wrap {
    padding: 0 0;
  }

  /* Header: add side padding */
  .pvb-header {
    padding: 0 1.8rem;
    margin-bottom: 2rem;
  }

  .pvb-heading {
    font-size: 2.6rem;
    letter-spacing: -0.01em;
  }

  .pvb-eyebrow {
    font-size: 1.05rem;
  }

  .pvb-subheading {
    font-size: 1.35rem;
    max-width: 100%;
  }

  /* ── Cards: full-bleed swipe carousel ── */
  .pvb-cards-outer {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.4rem 1.8rem 1.2rem;
  }

  .pvb-cards-outer::-webkit-scrollbar { display: none; }

  .pvb-cards {
    grid-template-columns: unset;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 1.4rem;
    align-items: stretch;
    /* trailing space so last card doesn't clip */
    padding-right: 1.8rem;
  }

  /* Each card: 78vw so next card peeks in */
  .pvb-card {
    flex: 0 0 78vw;
    min-width: 0;
    max-width: 300px;
    scroll-snap-align: start;
    /* card shadow feels premium */
    box-shadow: 0 6px 24px rgba(18,53,14,0.12);
    border-radius: 18px;
  }

  .pvb-card-top {
    padding: 1.8rem 1.6rem 1.2rem;
    gap: 0.6rem;
  }

  .pvb-icon {
    width: 48px;
    height: 48px;
  }

  .pvb-card-title {
    font-size: 1.5rem;
  }

  .pvb-card-desc {
    font-size: 1.25rem;
  }

  .pvb-card-img-wrap {
    aspect-ratio: 3 / 2;
  }

  /* ── Scroll dots ── */
  .pvb-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 1.4rem;
    padding: 0 1.8rem;
  }

  .pvb-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pvb-border);
    transition: background 0.25s, width 0.25s;
    flex-shrink: 0;
  }

  .pvb-dot--active {
    width: 20px;
    border-radius: 3px;
    background: var(--pvb-gold);
  }

  /* ── Trust strip: horizontal pill scroll ── */
  .pvb-trust-strip {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background: transparent;
    border: none;
    border-radius: 0;
    margin-top: 2.4rem;
    padding: 0 1.8rem;
    gap: 0.8rem;
    justify-content: flex-start;
  }

  .pvb-trust-strip::-webkit-scrollbar { display: none; }

  .pvb-trust-item {
    flex: 0 0 auto;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.4rem;
    background: var(--pvb-white);
    border: 1.5px solid var(--pvb-border);
    border-radius: 999px;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--pvb-text);
    box-shadow: 0 2px 8px rgba(18,53,14,0.07);
    /* override grid styles */
    border-bottom: 1.5px solid var(--pvb-border);
    border-right: 1.5px solid var(--pvb-border);
    min-width: unset;
  }

  .pvb-trust-item:nth-child(odd) {
    border-right: 1.5px solid var(--pvb-border);
  }

  .pvb-trust-item:nth-last-child(-n+2) {
    border-bottom: 1.5px solid var(--pvb-border);
  }

  .pvb-trust-icon {
    width: 16px;
    height: 16px;
    color: var(--pvb-gold);
  }
}

@media screen and (max-width: 389px) {
  .pvb-card { flex: 0 0 84vw; }
}
</style>

<script>
(function () {
  var outer = document.querySelector('#pvb-{{ section.id }} .pvb-cards-outer');
  var dots  = document.querySelectorAll('#pvb-{{ section.id }} .pvb-dot');
  if (!outer || !dots.length) return;

  function updateDots() {
    var cards = outer.querySelectorAll('.pvb-card');
    if (!cards.length) return;
    var cardW    = cards[0].offsetWidth + 14; /* gap ~14px */
    var active   = Math.round(outer.scrollLeft / cardW);
    dots.forEach(function (d, i) {
      d.classList.toggle('pvb-dot--active', i === active);
    });
  }

  outer.addEventListener('scroll', updateDots, { passive: true });
  window.addEventListener('resize', updateDots, { passive: true });
})();
</script>

