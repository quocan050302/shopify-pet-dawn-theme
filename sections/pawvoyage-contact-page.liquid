    { "type": "text", "id": "field_name", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "field_name_placeholder", "label": "Name placeholder", "default": "Your name" },
    { "type": "text", "id": "field_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "field_email_placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "field_order", "label": "Order number label", "default": "Order Number" },
    { "type": "text", "id": "field_order_optional", "label": "Optional text", "default": "optional" },
    { "type": "text", "id": "field_order_placeholder", "label": "Order placeholder", "default": "e.g. #12345" },
    { "type": "text", "id": "field_message", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "field_message_placeholder", "label": "Message placeholder", "default": "Tell us how we can help..." },
    { "type": "text", "id": "form_button", "label": "Submit button text", "default": "Send Message" },
    { "type": "text", "id": "form_trust_text", "label": "Form trust text", "default": "Your information is safe with us. We'll never share your details." },
    { "type": "text", "id": "form_success", "label": "Success message", "default": "Thanks for reaching out! We'll reply within 24–48 hours." },

    { "type": "header", "content": "Quick FAQ" },
    { "type": "text", "id": "faq_heading", "label": "FAQ section heading", "default": "Quick answers before you message us" },
    { "type": "url", "id": "faq_link", "label": "View all FAQs link" },
    { "type": "text", "id": "faq_link_text", "label": "View all FAQs text", "default": "View all FAQs" },
    { "type": "text", "id": "faq_q1", "label": "FAQ 1 question", "default": "How do I choose the right size?" },
    { "type": "textarea", "id": "faq_a1", "label": "FAQ 1 answer", "default": "Measure your dog's chest girth (just behind the front legs) and compare to our size chart. When between sizes, choose the larger." },
    { "type": "text", "id": "faq_q2", "label": "FAQ 2 question", "default": "How long does shipping take?" },
    { "type": "textarea", "id": "faq_a2", "label": "FAQ 2 answer", "default": "Standard shipping takes 5–7 business days. Expedited options are available at checkout." },
    { "type": "text", "id": "faq_q3", "label": "FAQ 3 question", "default": "What if the harness doesn't fit?" },
    { "type": "textarea", "id": "faq_a3", "label": "FAQ 3 answer", "default": "No worries! We offer hassle-free exchanges within 30 days of purchase. Contact us with your order number." },
    { "type": "text", "id": "faq_q4", "label": "FAQ 4 question", "default": "Can I return or exchange my order?" },
    { "type": "textarea", "id": "faq_a4", "label": "FAQ 4 answer", "default": "Yes. We accept returns within 30 days if the item is unused and in original condition. See our returns policy for details." },

    { "type": "header", "content": "Trust Strip" },
    { "type": "text", "id": "trust_1_title", "label": "Trust 1 title", "default": "Secure Checkout" },
    { "type": "text", "id": "trust_1_desc", "label": "Trust 1 description", "default": "Your payment is 100% secure" },
    { "type": "text", "id": "trust_2_title", "label": "Trust 2 title", "default": "30-Day Easy Returns" },
    { "type": "text", "id": "trust_2_desc", "label": "Trust 2 description", "default": "Love it or return it. No hassle." },
    { "type": "text", "id": "trust_3_title", "label": "Trust 3 title", "default": "Fast Shipping" },
    { "type": "text", "id": "trust_3_desc", "label": "Trust 3 description", "default": "Quick delivery, right to your door" },
    { "type": "text", "id": "trust_4_title", "label": "Trust 4 title", "default": "Friendly Pet Support" },
    { "type": "text", "id": "trust_4_desc", "label": "Trust 4 description", "default": "Real people who love pets" }
  ],
  "presets": [
    { "name": "PV Contact Page" }
  ]
