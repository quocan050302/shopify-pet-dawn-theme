    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Contact PawVoyage" },
    { "type": "textarea", "id": "hero_subheading", "label": "Hero subheading", "default": "Have a question about sizing, shipping, returns, or your order? Our support team is ready to help you and your pup." },
