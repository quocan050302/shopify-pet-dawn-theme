<section class="pv-cta-sec">
  <div class="page-width">
    <div class="pv-cta-inner">
      <h2>Ready for Calmer Walks?</h2>
      <a href="#ProductInfo-{{ section.id }}" class="pv-cta-btn" onclick="window.scrollTo({top:0, behavior:'smooth'}); return false;">Add to Cart</a>
    </div>
  </div>
</section>
<style>
  .pv-cta-sec { padding: 8rem 0; background: #FFF7EA; text-align: center; }
  .pv-cta-inner { background: #12350E; padding: 6rem 2rem; border-radius: 24px; color: #FFF7EA; max-width: 90rem; margin: 0 auto; box-shadow: 0 16px 48px rgba(18,53,14,0.15); }
  .pv-cta-inner h2 { font-size: clamp(2.8rem, 4vw, 4rem); font-weight: 800; color: #FFF7EA; margin: 0 0 3.2rem; }
  .pv-cta-btn { display: inline-flex; justify-content: center; align-items: center; background: #D99A2B; color: #12350E; font-size: 1.8rem; font-weight: 800; padding: 1.8rem 4rem; border-radius: 999px; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 8px 24px rgba(217,154,43,0.3); }
  .pv-cta-btn:hover { background: #E0A846; transform: translateY(-4px); box-shadow: 0 12px 32px rgba(217,154,43,0.4); }
</style>
{% schema %}
{ "name": "PV Bottom CTA", "presets": [{ "name": "PV Bottom CTA" }] }
{% endschema %}
