{{ 'pawvoyage-brand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_product = all_products[section.settings.product]
-%}

<section class="pv-featured section-{{ section.id }}" id="pv-featured-{{ section.id }}">
  <div class="page-width">
    <div class="pv-featured__layout">
      
      <!-- Product Image -->
      <div class="pv-featured__image-col">
        <div class="pv-featured__image-wrap">
          {%- if featured_product != blank and featured_product.featured_image != blank -%}
            {%- assign fp_alt = featured_product.featured_image.alt | escape -%}
            {{ featured_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '450, 600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: fp_alt, class: 'pv-featured__img' }}
          {%- elsif section.settings.fallback_image != blank -%}
            {{ section.settings.fallback_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '450, 600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: 'PawVoyage Harness', class: 'pv-featured__img' }}
          {%- else -%}
            <div class="pv-featured__img-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.show_floating_badges -%}
          <div class="pv-featured__floating-badges">
            {%- if section.settings.floating_badge_1_text != blank -%}
              <div class="pvf-floating-badge pvf-floating-badge--1">
                <span class="pvf-floating-badge-icon">{{ section.settings.floating_badge_1_icon }}</span>
                <span class="pvf-floating-badge-text">{{ section.settings.floating_badge_1_text }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.floating_badge_2_text != blank -%}
              <div class="pvf-floating-badge pvf-floating-badge--2">
                <span class="pvf-floating-badge-icon">{{ section.settings.floating_badge_2_icon }}</span>
                <span class="pvf-floating-badge-text">{{ section.settings.floating_badge_2_text }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.floating_badge_3_text != blank -%}
              <div class="pvf-floating-badge pvf-floating-badge--3">
                <span class="pvf-floating-badge-icon">{{ section.settings.floating_badge_3_icon }}</span>
                <span class="pvf-floating-badge-text">{{ section.settings.floating_badge_3_text }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="pv-featured__info-col">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pv-featured__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if featured_product != blank -%}
          <h2 class="pv-featured__title">{{ featured_product.title }}</h2>
        {%- else -%}
          <h2 class="pv-featured__title">{{ section.settings.fallback_title | default: 'PawVoyage No-Pull Tactical Dog Harness' }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="pv-featured__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <!-- Price Area -->
        <div class="pv-featured__price-area">
          {%- if featured_product != blank -%}
            {%- if featured_product.compare_at_price > featured_product.price -%}
              <span class="pv-featured__price-label">Now</span>
              <span class="pv-featured__price-current">{{ featured_product.price | money }}</span>
              <span class="pv-featured__price-compare">Was {{ featured_product.compare_at_price | money }}</span>
              <span class="pv-featured__price-save">Save {{ featured_product.compare_at_price | minus: featured_product.price | money }}</span>
            {%- else -%}
              <span class="pv-featured__price-current">{{ featured_product.price | money }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="pv-featured__price-label">Now</span>
            <span class="pv-featured__price-current">{{ section.settings.fallback_price | default: '$49.99' }}</span>
            <span class="pv-featured__price-compare">Was {{ section.settings.fallback_compare_price | default: '$79.99' }}</span>
          {%- endif -%}
        </div>

        <!-- Benefits -->
        <ul class="pv-featured__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature_bullet' -%}
              <li class="pv-featured__feature" {{ block.shopify_attributes }}>
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="11" fill="#12350E"/><path d="M6 11.5l3.5 3.5 6.5-7" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <!-- Optional Mini Comparison Box -->
        {%- assign has_mini_comp = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'mini_comparison' -%}
            {%- assign has_mini_comp = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_mini_comp -%}
          <div class="pv-featured__mini-comp">
            <p class="pv-featured__mini-comp-title">Why dog owners choose it:</p>
            <ul class="pv-featured__mini-comp-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'mini_comparison' -%}
                  <li {{ block.shopify_attributes }}>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13 5L6 12L3 9" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {{ block.settings.text }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <!-- CTA Row -->
        <div class="pv-featured__cta-row">
          {%- if featured_product != blank -%}
            <a href="{{ featured_product.url }}" class="pv-featured__btn" id="pv-featured-btn-{{ section.id }}">
              {{ section.settings.cta_label | default: 'Shop The Harness' }}
            </a>
          {%- else -%}
            <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="pv-featured__btn" id="pv-featured-btn-{{ section.id }}">
              {{ section.settings.cta_label | default: 'Shop The Harness' }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.trust_microcopy != blank -%}
          <div class="pv-featured__trust-micro">
            {{ section.settings.trust_microcopy }}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<style>
  .pv-featured { background: #FAF7F2; padding: 4rem 0; }
  @media screen and (min-width: 750px) {
    .pv-featured { padding: 8rem 0; }
  }
  .pv-featured__layout { display: grid; grid-template-columns: 1fr; gap: 4rem; align-items: center; }
  @media screen and (min-width: 990px) {
    .pv-featured__layout { grid-template-columns: 1.1fr 0.9fr; gap: 6rem; align-items: start; }
  }

  /* Image Column */
  .pv-featured__image-col { position: relative; display: flex; flex-direction: column; }
  .pv-featured__image-wrap { position: relative; border-radius: 24px; overflow: hidden; box-shadow: 0 24px 64px rgba(31,36,29,0.12); }
  .pv-featured__img { width: 100%; height: auto; display: block; transition: transform 0.6s ease; object-fit: cover; aspect-ratio: 4/5; }
  @media screen and (min-width: 990px) { .pv-featured__img { aspect-ratio: auto; } }
  .pv-featured__image-wrap:hover .pv-featured__img { transform: scale(1.03); }
  .pv-featured__img-placeholder { background: #E8E0D5; display: flex; align-items: center; justify-content: center; aspect-ratio: 1; }

  /* Floating Badges */
  .pv-featured__floating-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }
  .pvf-floating-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(20, 60, 30, 0.08);
    box-shadow: 0 8px 24px rgba(20, 45, 25, 0.08);
    border-radius: 999px;
    padding: 1.2rem 1.6rem;
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f3b18;
    z-index: 3;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pvf-floating-badge-icon {
    font-size: 1.6rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .pv-featured__floating-badges {
      display: block;
      margin-top: 0;
    }
    .pvf-floating-badge {
      position: absolute;
      font-size: 1.5rem;
      padding: 1.2rem 1.8rem;
      box-shadow: 0 16px 40px rgba(20, 45, 25, 0.12);
      animation: pvf-float 6s ease-in-out infinite;
    }
    .pvf-floating-badge--1 { top: 12%; left: -6%; animation-delay: 0s; }
    .pvf-floating-badge--2 { top: 45%; right: -6%; animation-delay: 1.5s; }
    .pvf-floating-badge--3 { bottom: 15%; left: -4%; animation-delay: 3s; }

    .pvf-floating-badge:hover {
      animation-play-state: paused;
      transform: translateY(-4px) !important;
      box-shadow: 0 20px 48px rgba(20, 45, 25, 0.16);
    }
  }

  @keyframes pvf-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pvf-floating-badge { animation: none !important; }
  }

  /* Info Column */
  .pv-featured__info-col { display: flex; flex-direction: column; }
  .pv-featured__eyebrow { display: inline-block; align-self: flex-start; background: #D99A2B; color: #FFF7EA; font-size: 1.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.6rem 1.6rem; border-radius: 999px; box-shadow: 0 4px 12px rgba(217,154,43,0.25); margin-bottom: 2rem; }
  .pv-featured__title { font-size: clamp(3rem, 4vw, 4.4rem); font-weight: 800; color: #12350E; margin: 0 0 1.6rem; line-height: 1.1; letter-spacing: -0.02em; }
  .pv-featured__subheading { font-size: 1.6rem; color: #4A5246; line-height: 1.6; margin: 0 0 3.2rem; max-width: 50rem; }

  /* Price Area */
  .pv-featured__price-area { display: flex; align-items: center; flex-wrap: wrap; gap: 1.2rem; margin-bottom: 3.2rem; padding-bottom: 3.2rem; border-bottom: 1px solid rgba(18,53,14,0.1); }
  .pv-featured__price-label { font-size: 1.4rem; font-weight: 700; color: #6D7569; text-transform: uppercase; letter-spacing: 0.05em; }
  .pv-featured__price-current { font-size: 3.2rem; font-weight: 800; color: #12350E; line-height: 1; }
  .pv-featured__price-compare { font-size: 1.8rem; color: #8F998A; text-decoration: line-through; margin-left: 0.4rem; }
  .pv-featured__price-save { font-size: 1.3rem; font-weight: 700; background: rgba(217,154,43,0.15); color: #B37A17; padding: 0.4rem 1rem; border-radius: 999px; margin-left: 0.8rem; }

  /* Benefits */
  .pv-featured__features { list-style: none; margin: 0 0 3.2rem; padding: 0; display: flex; flex-direction: column; gap: 1.6rem; }
  .pv-featured__feature { display: flex; align-items: center; gap: 1.4rem; font-size: 1.6rem; font-weight: 600; color: #1F241D; }

  /* Mini Comparison */
  .pv-featured__mini-comp { background: rgba(18,53,14,0.03); border: 1px solid rgba(18,53,14,0.08); border-radius: 16px; padding: 2.4rem; margin-bottom: 4rem; }
  .pv-featured__mini-comp-title { font-size: 1.4rem; font-weight: 700; color: #12350E; margin: 0 0 1.2rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .pv-featured__mini-comp-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.8rem; }
  .pv-featured__mini-comp-list li { display: flex; align-items: center; gap: 1rem; font-size: 1.5rem; color: #4A5246; font-weight: 500; }

  /* CTA */
  .pv-featured__cta-row { margin-bottom: 1.6rem; }
  .pv-featured__btn { display: flex; justify-content: center; align-items: center; width: 100%; background: #12350E; color: #FFF7EA; font-size: 1.8rem; font-weight: 700; padding: 1.8rem 4rem; border-radius: 999px; text-decoration: none; transition: all 0.3s ease; box-shadow: 0 8px 24px rgba(18,53,14,0.3); }
  @media screen and (min-width: 750px) { .pv-featured__btn { display: inline-flex; width: auto; } }
  .pv-featured__btn:hover { background: #1F4A16; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(18,53,14,0.4); color: #FFF7EA; text-decoration: none; }

  /* Trust Microcopy */
  .pv-featured__trust-micro { font-size: 1.3rem; color: #6D7569; font-weight: 600; text-align: center; }
  @media screen and (min-width: 750px) { .pv-featured__trust-micro { text-align: left; padding-left: 2rem; } }

  /* ══ MOBILE CRO OPTIMIZATIONS ══ */
  @media screen and (max-width: 749px) {
    /* Section: tighter padding */
    .pv-featured { padding: 2.4rem 0 3rem; }

    /* Layout gap */
    .pv-featured__layout { gap: 2rem; }

    /* Image: landscape ratio on mobile → less space, content visible sooner */
    .pv-featured__img { aspect-ratio: 3/2; }

    /* Floating badges: smaller, tighter row below image */
    .pv-featured__floating-badges { gap: .8rem; margin-top: 1.4rem; }
    .pvf-floating-badge { font-size: 1.25rem; padding: .9rem 1.3rem; gap: .6rem; }
    .pvf-floating-badge-icon { font-size: 1.35rem; }

    /* Info column: tighter spacing */
    .pv-featured__eyebrow { margin-bottom: 1.2rem; font-size: 1.1rem; }
    .pv-featured__title { font-size: clamp(2.6rem, 7vw, 3.2rem); margin-bottom: 1rem; }

    /* Hide subheading on mobile — saves crucial vertical space */
    .pv-featured__subheading { display: none; }

    /* Price: tighter bottom */
    .pv-featured__price-area {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      gap: .8rem;
    }
    .pv-featured__price-current { font-size: 2.8rem; }

    /* Features: tighter */
    .pv-featured__features { gap: 1.2rem; margin-bottom: 2rem; }
    .pv-featured__feature { font-size: 1.5rem; gap: 1.1rem; }

    /* Mini-comp box: smaller padding */
    .pv-featured__mini-comp { padding: 1.6rem; margin-bottom: 2.4rem; }
    .pv-featured__mini-comp-list li { font-size: 1.4rem; }

    /* CTA: full width, prominent tap target */
    .pv-featured__btn {
      font-size: 1.55rem;
      padding: 1.4rem 2rem;
      box-shadow: 0 10px 30px rgba(18,53,14,0.35);
      letter-spacing: -.01em;
    }
    .pv-featured__cta-row { margin-bottom: 1.2rem; }

    /* Trust microcopy: center */
    .pv-featured__trust-micro { font-size: 1.25rem; }
  }

</style>

{% schema %}
{
  "name": "PV Featured Product",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "header", "content": "Floating Image Badges" },
    { "type": "checkbox", "id": "show_floating_badges", "label": "Show floating badges on image", "default": true },
    { "type": "text", "id": "floating_badge_1_icon", "label": "Badge 1 Icon", "default": "✓" },
    { "type": "text", "id": "floating_badge_1_text", "label": "Badge 1 Text", "default": "No-pull control" },
    { "type": "text", "id": "floating_badge_2_icon", "label": "Badge 2 Icon", "default": "☁" },
    { "type": "text", "id": "floating_badge_2_text", "label": "Badge 2 Text", "default": "Comfort padded fit" },
    { "type": "text", "id": "floating_badge_3_icon", "label": "Badge 3 Icon", "default": "⛰" },
    { "type": "text", "id": "floating_badge_3_text", "label": "Badge 3 Text", "default": "Adventure ready" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow/Badge", "default": "BEST SELLER" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Designed for dog owners who want more control, more comfort, and less pulling on every walk." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop The Harness" },
    { "type": "url", "id": "cta_link", "label": "CTA link (if no product)" },
    { "type": "text", "id": "trust_microcopy", "label": "Trust Microcopy", "default": "Secure checkout • 30-day easy returns • Free shipping today" },
    { "type": "header", "content": "Fallback Data (If no product selected)" },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback image" },
    { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "PawVoyage No-Pull Tactical Dog Harness" },
    { "type": "text", "id": "fallback_price", "label": "Fallback price", "default": "$49.99" },
    { "type": "text", "id": "fallback_compare_price", "label": "Fallback compare price", "default": "$79.99" }
  ],
  "blocks": [
    {
      "type": "feature_bullet",
      "name": "Feature bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Feature text", "default": "Helps reduce pulling" }
      ]
    },
    {
      "type": "mini_comparison",
      "name": "Mini comparison bullet",
      "settings": [
        { "type": "text", "id": "text", "label": "Comparison text", "default": "More control than a collar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PV Featured Product",
      "blocks": [
        { "type": "feature_bullet", "settings": { "text": "Helps reduce pulling" } },
        { "type": "feature_bullet", "settings": { "text": "Comfortable padded chest fit" } },
        { "type": "feature_bullet", "settings": { "text": "Secure tactical design" } },
        { "type": "feature_bullet", "settings": { "text": "Built for daily walks & travel" } },
        { "type": "mini_comparison", "settings": { "text": "More control than a collar" } },
        { "type": "mini_comparison", "settings": { "text": "More comfortable than cheap harnesses" } },
        { "type": "mini_comparison", "settings": { "text": "More secure for active dogs" } }
      ]
    }
  ]
}
{% endschema %}
