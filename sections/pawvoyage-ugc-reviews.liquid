{%- liquid
  assign show_arrows = section.settings.show_arrows
  assign show_cta    = section.settings.show_cta
-%}
{%- style -%}
/* ══ PawVoyage UGC Reviews — fully scoped ══ */
#pvugc-{{ section.id }} {
  background: #FAF7F0;
  padding: 80px 2rem;
  font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  overflow: hidden;
}
@media(max-width:749px){ #pvugc-{{ section.id }} { padding: 30px 0; } }

#pvugc-{{ section.id }} .pvugc-wrap {
  max-width: 1500px;
  margin: 0 auto;
  padding: 0 1.6rem;
}
@media(max-width:749px){
  #pvugc-{{ section.id }} .pvugc-wrap { padding: 0; }
  /* Restore side padding for text/header sections individually */
  #pvugc-{{ section.id }} .pvugc-header,
  #pvugc-{{ section.id }} .pvugc-stats,
  #pvugc-{{ section.id }} .pvugc-bottom { padding-left: 1.6rem; padding-right: 1.6rem; }
}

/* ── Header ── */
#pvugc-{{ section.id }} .pvugc-header { text-align: center; margin-bottom: 3.2rem; }
#pvugc-{{ section.id }} .pvugc-eyebrow {
  display: inline-block;
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: #D4A843;
  margin-bottom: 1rem;
}
#pvugc-{{ section.id }} .pvugc-heading {
  font-size: clamp(3.2rem, 4.5vw, 5.6rem);
  font-weight: 900;
  color: #133316;
  line-height: 1.15;
  letter-spacing: -.025em;
  margin: 0 0 1rem;
}
#pvugc-{{ section.id }} .pvugc-sub {
  font-size: clamp(1.45rem,2vw,1.7rem);
  color: #4A5748;
  line-height: 1.6;
  margin: 0 auto;
  max-width: 540px;
}

/* ── Stats row ── */
#pvugc-{{ section.id }} .pvugc-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3.2rem;
  flex-wrap: wrap;
  margin: 2.4rem 0 3.6rem;
}
#pvugc-{{ section.id }} .pvugc-stat {
  display: flex;
  align-items: center;
  gap: .7rem;
  font-size: 1.4rem;
  font-weight: 700;
  color: #2A3228;
}
#pvugc-{{ section.id }} .pvugc-stat-icon { display:flex; align-items:center; }
#pvugc-{{ section.id }} .pvugc-stat-icon svg { width:22px; height:22px; }
#pvugc-{{ section.id }} .pvugc-stat-sep {
  width: 1px;
  height: 28px;
  background: rgba(19,51,22,.15);
}
@media(max-width:599px){
  #pvugc-{{ section.id }} .pvugc-stat-sep { display:none; }
  #pvugc-{{ section.id }} .pvugc-stats { gap:1.8rem; }
}

/* ── Carousel container ── */
#pvugc-{{ section.id }} .pvugc-carousel-outer {
  position: relative;
}
#pvugc-{{ section.id }} .pvugc-track {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 8px;
  padding-left: 1.6rem;
  padding-right: 1.6rem;
}
#pvugc-{{ section.id }} .pvugc-track::-webkit-scrollbar { display: none; }

/* Desktop: 5 cards */
#pvugc-{{ section.id }} .pvugc-card {
  flex: 0 0 calc((100% - 4*20px) / 5);
  min-width: 200px;
  max-width: 280px;
  scroll-snap-align: start;
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(30,60,40,.08);
  border-radius: 18px;
  box-shadow: 0 14px 36px rgba(20,45,25,.08);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform .25s ease, box-shadow .25s ease;
}
#pvugc-{{ section.id }} .pvugc-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 22px 48px rgba(20,45,25,.14);
}
/* Tablet: 3 cards */
@media(max-width:1199px) and (min-width:750px){
  #pvugc-{{ section.id }} .pvugc-card {
    flex: 0 0 calc((100% - 2*20px) / 3);
    max-width: none;
  }
}
/* Mobile: 1.15 cards */
@media(max-width:749px){
  #pvugc-{{ section.id }} .pvugc-card {
    flex: 0 0 80vw;
    max-width: 80vw;
    min-width: 80vw;
  }
  #pvugc-{{ section.id }} .pvugc-track {
    padding-left: 1.6rem;
    padding-right: 1.6rem;
    scroll-padding-left: 1.6rem;  /* align snap to left gutter */
  }
  /* Fix: Safari collapses padding-right in overflow-x containers */
  #pvugc-{{ section.id }} .pvugc-track::after {
    content: '';
    flex: 0 0 1.6rem;
    min-width: 1.6rem;
  }
}

/* ── Card image ── */
#pvugc-{{ section.id }} .pvugc-card-img {
  width: 100%;
  aspect-ratio: 4/5;
  object-fit: cover;
  display: block;
  background: #EDE8DC;
}
#pvugc-{{ section.id }} .pvugc-card-placeholder {
  width: 100%;
  aspect-ratio: 1/1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg,#EDE8DC 0%,#D9D0C0 100%);
  color: #8A9486;
  font-size: 1.15rem;
  font-weight: 600;
  gap: .7rem;
}
#pvugc-{{ section.id }} .pvugc-card-placeholder svg { width:32px; height:32px; opacity:.45; }

/* Mobile: compact image — no distortion, taller than before */
@media(max-width:749px){
  #pvugc-{{ section.id }} .pvugc-card-img,
  #pvugc-{{ section.id }} .pvugc-card-placeholder {
    aspect-ratio: 4 / 3;
    max-height: 200px;
    object-fit: cover;   /* never squish or stretch */
  }
}

/* ── Card body ── */
#pvugc-{{ section.id }} .pvugc-card-body {
  padding: 1.4rem 1.4rem 1.6rem;
  display: flex;
  flex-direction: column;
  gap: .8rem;
  flex: 1;
}

/* Stars */
#pvugc-{{ section.id }} .pvugc-card-stars {
  display: flex;
  gap: 2px;
}
#pvugc-{{ section.id }} .pvugc-star { color:#D4A843; font-size:1.5rem; line-height:1; }
#pvugc-{{ section.id }} .pvugc-star-empty { color:#D9D0C0; font-size:1.5rem; line-height:1; }

/* Review text */
#pvugc-{{ section.id }} .pvugc-card-text {
  font-size: 1.25rem;
  color: #2A3228;
  line-height: 1.5;
  margin: 0;
  flex: 1;
}
#pvugc-{{ section.id }} .pvugc-card-text::before { content: '\201C'; }
#pvugc-{{ section.id }} .pvugc-card-text::after  { content: '\201D'; }

/* Reviewer */
#pvugc-{{ section.id }} .pvugc-card-reviewer {
  display: flex;
  flex-direction: column;
  gap: .15rem;
  padding-top: .4rem;
  border-top: 1px solid rgba(19,51,22,.07);
}
#pvugc-{{ section.id }} .pvugc-reviewer-name {
  font-size: 1.25rem;
  font-weight: 800;
  color: #133316;
}
#pvugc-{{ section.id }} .pvugc-dog-info {
  font-size: 1.1rem;
  color: #6B7568;
  font-weight: 500;
}

/* Verified badge */
#pvugc-{{ section.id }} .pvugc-verified {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  font-size: 1.1rem;
  font-weight: 700;
  color: #133316;
}
#pvugc-{{ section.id }} .pvugc-verified svg {
  width: 14px;
  height: 14px;
  stroke: #133316;
  flex-shrink: 0;
}

/* ── Carousel arrows ── */
#pvugc-{{ section.id }} .pvugc-arrow {
  display: none;
}
@media(min-width:750px){
  #pvugc-{{ section.id }} .pvugc-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid rgba(19,51,22,.12);
    box-shadow: 0 4px 16px rgba(19,51,22,.12);
    cursor: pointer;
    z-index: 10;
    transition: box-shadow .2s ease, transform .2s ease, background .2s ease;
  }
  #pvugc-{{ section.id }} .pvugc-arrow:hover {
    background: #133316;
    box-shadow: 0 8px 24px rgba(19,51,22,.22);
    transform: translateY(-50%) scale(1.08);
  }
  #pvugc-{{ section.id }} .pvugc-arrow:hover svg { stroke: #fff; }
  #pvugc-{{ section.id }} .pvugc-arrow svg { width:18px; height:18px; stroke:#133316; stroke-width:2.2; transition:stroke .2s; }
  #pvugc-{{ section.id }} .pvugc-arrow--prev { left: -20px; }
  #pvugc-{{ section.id }} .pvugc-arrow--next { right: -20px; }
  #pvugc-{{ section.id }} .pvugc-arrow:disabled,
  #pvugc-{{ section.id }} .pvugc-arrow[disabled] { opacity:.35; pointer-events:none; }
}

/* ── Bottom CTA ── */
#pvugc-{{ section.id }} .pvugc-bottom {
  text-align: center;
  margin-top: 3.6rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.8rem;
}
#pvugc-{{ section.id }} .pvugc-bottom-text {
  font-size: 1.4rem;
  color: #4A5748;
  font-weight: 500;
  margin: 0;
}
@media(max-width:749px){
  #pvugc-{{ section.id }} .pvugc-bottom { display: none !important; }
}
#pvugc-{{ section.id }} .pvugc-cta {
  display: inline-flex;
  align-items: center;
  gap: .7rem;
  background: #133316;
  color: #fff;
  font-size: 1.55rem;
  font-weight: 800;
  padding: 1.5rem 3.2rem;
  border-radius: 999px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(19,51,22,.22);
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
  letter-spacing: -.01em;
}
#pvugc-{{ section.id }} .pvugc-cta:hover {
  background: #1A4A20;
  transform: translateY(-2px);
  box-shadow: 0 14px 32px rgba(19,51,22,.28);
  color: #fff;
}
#pvugc-{{ section.id }} .pvugc-cta svg { width:17px; height:17px; stroke:#fff; stroke-width:2.2; }
@media(max-width:749px){
  #pvugc-{{ section.id }} .pvugc-cta { width: calc(100% - 2.8rem); justify-content: center; }
}
/* ── Count-up gold highlight ── */
#pvugc-{{ section.id }} .pv-count-highlight {
  position: relative;
  display: inline-block;
  background: linear-gradient(90deg, #D99A2B 0%, #B87918 40%, #E4B24A 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  white-space: nowrap;
}

/* Underline sweep — starts hidden, grows left→right after count-up */
#pvugc-{{ section.id }} .pv-count-highlight::after {
  content: '';
  position: absolute;
  left: 4%;
  right: 4%;
  bottom: 0.04em;
  height: 0.07em;
  border-radius: 999px;
  background: linear-gradient(90deg, #D99A2B, #E4B24A);
  transform: scaleX(0);
  transform-origin: left;
  opacity: 0.85;
}

#pvugc-{{ section.id }} .pv-count-highlight.is-animated::after {
  animation: pvUgcUnderline 0.65s ease-out 0.05s forwards;
}

#pvugc-{{ section.id }} .pv-count-highlight.is-complete {
  animation: pvUgcGlow 0.9s ease-out both;
}

/* ── Stat 3 highlight chip ── */
#pvugc-{{ section.id }} .pvugc-stat--highlight {
  font-weight: 800;
  color: #133316;
  background: rgba(217,154,43,0.10);
  padding: 0.5rem 1.1rem 0.5rem 0.7rem;
  border-radius: 999px;
  border: 1px solid rgba(217,154,43,0.24);
}
#pvugc-{{ section.id }} .pvugc-stat--highlight .pvugc-stat-icon svg {
  stroke: #D4A843;
}

/* ── Keyframes ── */
@keyframes pvUgcUnderline {
  to { transform: scaleX(1); }
}
@keyframes pvUgcGlow {
  0%   { filter: drop-shadow(0 0 0 rgba(217,154,43,0)); }
  45%  { filter: drop-shadow(0 0 18px rgba(217,154,43,0.30)); }
  100% { filter: drop-shadow(0 0 0 rgba(217,154,43,0)); }
}

/* Respect prefers-reduced-motion */
@media (prefers-reduced-motion: reduce) {
  #pvugc-{{ section.id }} .pv-count-highlight,
  #pvugc-{{ section.id }} .pv-count-highlight::after {
    animation: none !important;
    transform: none !important;
  }
}
{%- endstyle -%}

<!-- ===== UGC REVIEWS SECTION ===== -->
<section id="pvugc-{{ section.id }}" aria-labelledby="pvugc-heading-{{ section.id }}">
  <div class="pvugc-wrap">

    <!-- Header -->
    <div class="pvugc-header">
      {%- if section.settings.eyebrow_text != blank -%}
        <p class="pvugc-eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}
      <h2
        class="pvugc-heading"
        id="pvugc-heading-{{ section.id }}"
        aria-label="Loved by over 10,000 dog owners"
      >
        Loved by
        <span class="pv-count-highlight">
          <span class="pv-count-number" aria-hidden="true" data-target="10000">10,000+</span>
        </span>
        Dog Owners
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pvugc-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Stats row -->
    <div class="pvugc-stats" aria-label="Trust statistics">
      <div class="pvugc-stat">
        <span class="pvugc-stat-icon">
          <svg viewBox="0 0 24 24" fill="#D4A843" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </span>
        {{ section.settings.stat_1_text | default: '4.9/5 Average Rating' }}
      </div>
      <div class="pvugc-stat-sep" aria-hidden="true"></div>
      <div class="pvugc-stat">
        <span class="pvugc-stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#133316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        {{ section.settings.stat_2_text | default: '1,247 Reviews' }}
      </div>
      <div class="pvugc-stat-sep" aria-hidden="true"></div>
      <div class="pvugc-stat pvugc-stat--highlight" aria-label="Over 10,000 happy dogs">
        <span class="pvugc-stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D4A843" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
        {{ section.settings.stat_3_text | default: '10,000+ Happy Dogs' }}
      </div>
    </div>

    <!-- Carousel -->
    <div class="pvugc-carousel-outer">

      <!-- Prev arrow -->
      {%- if show_arrows -%}
      <button
        class="pvugc-arrow pvugc-arrow--prev"
        id="pvugc-prev-{{ section.id }}"
        aria-label="Previous reviews"
        aria-controls="pvugc-track-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      {%- endif -%}

      <!-- Track -->
      <div class="pvugc-track" id="pvugc-track-{{ section.id }}" role="list" aria-label="Customer reviews">

        {%- for block in section.blocks -%}
          {%- if block.type == 'review_card' -%}
          {%- liquid
            assign rating_val = block.settings.rating | default: 5
            assign img = block.settings.review_image
          -%}
          <article class="pvugc-card" role="listitem" {{ block.shopify_attributes }}>

            <!-- Image -->
            {%- if img != blank -%}
              <img
                class="pvugc-card-img"
                src="{{ img | image_url: width: 600 }}"
                srcset="
                  {{ img | image_url: width: 300 }} 300w,
                  {{ img | image_url: width: 600 }} 600w"
                sizes="(max-width:749px) 80vw, 20vw"
                alt="{{ block.settings.review_image_alt | default: block.settings.reviewer_name | escape }}"
                width="600"
                height="750"
                loading="lazy"
              >
            {%- else -%}
              <div class="pvugc-card-placeholder" aria-label="Upload review image">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                Upload review image
              </div>
            {%- endif -%}

            <!-- Body -->
            <div class="pvugc-card-body">

              <!-- Stars -->
              <div class="pvugc-card-stars" aria-label="{{ rating_val }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating_val -%}
                    <span class="pvugc-star" aria-hidden="true">★</span>
                  {%- else -%}
                    <span class="pvugc-star-empty" aria-hidden="true">★</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- Review text -->
              {%- if block.settings.review_text != blank -%}
                <p class="pvugc-card-text">{{ block.settings.review_text }}</p>
              {%- endif -%}

              <!-- Reviewer -->
              <div class="pvugc-card-reviewer">
                {%- if block.settings.reviewer_name != blank -%}
                  <span class="pvugc-reviewer-name">{{ block.settings.reviewer_name }}</span>
                {%- endif -%}
                {%- if block.settings.dog_info != blank -%}
                  <span class="pvugc-dog-info">{{ block.settings.dog_info }}</span>
                {%- endif -%}
              </div>

              <!-- Verified -->
              {%- if block.settings.verified_text != blank -%}
              <div class="pvugc-verified">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {{ block.settings.verified_text }}
              </div>
              {%- endif -%}

            </div>
          </article>
          {%- endif -%}
        {%- endfor -%}

      </div><!-- /pvugc-track -->

      <!-- Next arrow -->
      {%- if show_arrows -%}
      <button
        class="pvugc-arrow pvugc-arrow--next"
        id="pvugc-next-{{ section.id }}"
        aria-label="Next reviews"
        aria-controls="pvugc-track-{{ section.id }}"
      >
        <svg viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      {%- endif -%}

    </div><!-- /pvugc-carousel-outer -->

    <!-- Bottom CTA -->
    {%- if show_cta -%}
    <div class="pvugc-bottom">
      {%- if section.settings.bottom_text != blank -%}
        <p class="pvugc-bottom-text">{{ section.settings.bottom_text }}</p>
      {%- endif -%}
      <a
        href="{{ section.settings.cta_link | default: '#' }}"
        class="pvugc-cta"
        id="pvugc-cta-{{ section.id }}"
      >
        {{ section.settings.cta_text | default: 'Read More Reviews →' }}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    {%- endif -%}

  </div><!-- /pvugc-wrap -->
</section>

{%- if show_arrows -%}
<script>
(function(){
  var track = document.getElementById('pvugc-track-{{ section.id }}');
  var prev  = document.getElementById('pvugc-prev-{{ section.id }}');
  var next  = document.getElementById('pvugc-next-{{ section.id }}');
  if (!track) return;

  function getScrollAmount() {
    var card = track.querySelector('.pvugc-card');
    if (!card) return 280;
    return card.offsetWidth + 20;
  }

  function updateArrows() {
    if (!prev || !next) return;
    prev.disabled = track.scrollLeft <= 4;
    next.disabled = track.scrollLeft >= (track.scrollWidth - track.clientWidth - 4);
  }

  if (prev) prev.addEventListener('click', function(){
    track.scrollBy({ left: -getScrollAmount() * 2, behavior: 'smooth' });
  });
  if (next) next.addEventListener('click', function(){
    track.scrollBy({ left: getScrollAmount() * 2, behavior: 'smooth' });
  });

  track.addEventListener('scroll', updateArrows, { passive: true });
  updateArrows();
})();
</script>
{%- endif -%}

<!-- Count-up animation for 10,000+ -->
<script>
(function(){
  var section  = document.getElementById('pvugc-{{ section.id }}');
  if (!section) return;
  var number   = section.querySelector('.pv-count-number');
  var highlight = section.querySelector('.pv-count-highlight');
  if (!number || !highlight) return;

  var target      = Number(number.dataset.target || 10000);
  var hasAnimated = false;

  function fmt(val) {
    return Math.floor(val).toLocaleString('en-US') + '+';
  }

  function animateCount() {
    if (hasAnimated) return;
    hasAnimated = true;

    /* Respect reduced-motion: show final value instantly */
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      number.textContent = '10,000+';
      highlight.classList.add('is-animated');
      highlight.classList.add('is-complete');
      return;
    }

    var duration = 1500;
    var startTime = null;

    function tick(now) {
      if (!startTime) startTime = now;
      var progress = Math.min((now - startTime) / duration, 1);
      /* ease-out cubic */
      var eased = 1 - Math.pow(1 - progress, 3);
      number.textContent = fmt(target * eased);

      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        number.textContent = '10,000+';
        highlight.classList.add('is-animated');
        setTimeout(function() {
          highlight.classList.add('is-complete');
        }, 680);
      }
    }

    requestAnimationFrame(tick);
  }

  /* IntersectionObserver — fire at 35% visibility, once only */
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          animateCount();
          observer.disconnect();
        }
      });
    }, { threshold: 0.35 });
    observer.observe(section);
  } else {
    /* Fallback for old browsers */
    animateCount();
  }
})();
</script>

