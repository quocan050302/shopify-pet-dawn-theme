{{ 'pawvoyage-brand.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_pos     = section.settings.bg_position | default: 'center right'
  assign desktop_img = section.settings.image_desktop
  assign mobile_img  = section.settings.image_mobile
-%}

{%- style -%}
  #pv-hero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.hero_height_mobile }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(135deg, #FAF7F0 0%, #EAE3D6 60%, #D5C9B5 100%);
  }

  @media screen and (min-width: 990px) {
    #pv-hero-{{ section.id }} { min-height: {{ section.settings.hero_height_desktop }}px; }
  }

  {%- if desktop_img != blank -%}
  #pv-hero-{{ section.id }} {
    background-image: url('{{ desktop_img | image_url: width: 2400 }}');
    background-size: cover;
    background-position: {{ bg_pos }};
    background-repeat: no-repeat;
  }
  {%- endif -%}

  @media screen and (max-width: 749px) {
    {%- if mobile_img != blank -%}
    #pv-hero-{{ section.id }} {
      background-image: url('{{ mobile_img | image_url: width: 900 }}');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
    }
    {%- elsif desktop_img != blank -%}
    #pv-hero-{{ section.id }} {
      background-image: url('{{ desktop_img | image_url: width: 1200 }}');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
    }
    {%- endif -%}
  }
{%- endstyle -%}

<section id="pv-hero-{{ section.id }}" class="pv-hero">
  <!-- Gradient overlay (decorative) -->
  <div class="pv-hero__overlay" aria-hidden="true"></div>
  <div class="page-width pv-hero__content-wrap">
    <div class="pv-hero__grid">
      <!-- Left Column: Content -->
      <div class="pv-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pv-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="pv-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pv-hero__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="pv-hero__bullets">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit_bullet' -%}
                <li class="pv-hero__bullet" {{ block.shopify_attributes }}>
                  <span class="pv-hero__bullet-icon">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7L5.5 10.5L12 3.5" stroke="#102f0c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="pv-hero__cta-group">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_link | default: '#' }}" class="pv-hero__cta pv-hero__cta--primary" id="pv-hero-cta-1-{{ section.id }}">
              {{ section.settings.cta_label }}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M10 5l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_link_2 | default: '#' }}" class="pv-hero__cta pv-hero__cta--secondary" id="pv-hero-cta-2-{{ section.id }}">{{ section.settings.cta_label_2 }}</a>
          {%- endif -%}
        </div>
        
        <div class="pv-hero__trust-micro">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="#D99A2B"/></svg>
          Loved by dog owners • Secure checkout • Easy returns
        </div>
      </div><!-- end .pv-hero__content -->
    </div><!-- end .pv-hero__grid -->
  </div><!-- end .page-width -->
</section>

<style>
  .pv-hero { }
  .pv-hero__content-wrap { position:relative; z-index:2; width:100%; padding-top:6rem; padding-bottom:6rem; }
  .pv-hero__grid { display: grid; grid-template-columns: 1fr; gap: 0; align-items: center; }

  /* Full-width overlay: left heavy, fades right */
  .pv-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      rgba(250, 247, 240, 0.97) 0%,
      rgba(250, 247, 240, 0.97) 15%,
      rgba(250, 247, 240, 0.80) 40%,
      rgba(250, 247, 240, 0.25) 65%,
      transparent 100%
    );
  }

  @media (max-width: 749px) {
    .pv-hero__overlay {
      background: linear-gradient(
        to bottom,
        rgba(250, 247, 240, 0.97) 0%,
        rgba(250, 247, 240, 0.93) 50%,
        rgba(250, 247, 240, 0.45) 78%,
        transparent 100%
      );
    }
  }

  /* Left Column Styling */
  .pv-hero__eyebrow { display:inline-block; font-size:1.1rem; font-weight:800; letter-spacing:0.15em; text-transform:uppercase; color:#D99A2B; margin-bottom:1.6rem; border:1px solid rgba(217,154,43,0.3); background: rgba(217,154,43,0.05); padding:0.6rem 1.4rem; border-radius:999px; }
  .pv-hero__heading { font-size:clamp(3.6rem,5vw,5.6rem); font-weight:800; color:#12350E; line-height:1.1; letter-spacing:-0.02em; margin:0 0 2rem; max-width:72rem; }
  .pv-hero__subheading { font-size:clamp(1.5rem,2vw,1.8rem); color:#4A5246; line-height:1.65; max-width:56rem; margin:0 0 3.2rem; }
  
  .pv-hero__bullets { list-style:none; margin:0 0 4rem; padding:0; display:flex; flex-direction: column; gap:1.4rem; }
  .pv-hero__bullet { display:inline-flex; align-items:center; gap:1.2rem; font-size:1.6rem; font-weight:600; color:#1F241D; }
  .pv-hero__bullet-icon { display:inline-flex; align-items:center; justify-content:center; width:2.4rem; height:2.4rem; background:#E6F0E6; color: #12350E; border-radius:50%; flex-shrink:0; }
  .pv-hero__bullet-icon svg { stroke: #12350E; }
  
  .pv-hero__cta-group { display:flex; flex-wrap:wrap; gap:1.6rem; align-items:center; margin-bottom: 2rem; }
  .pv-hero__cta { display:inline-flex; align-items:center; gap:0.8rem; font-size:1.6rem; font-weight:800; padding:1.6rem 3.2rem; border-radius:999px; text-decoration:none; transition:all 0.3s ease; }
  
  .pv-hero__cta--primary { background:#12350E; color:#FFF7EA; box-shadow:0 8px 24px rgba(18,53,14,0.15); border: 2px solid #12350E; }
  .pv-hero__cta--primary:hover { background:#1A4A14; border-color:#1A4A14; transform:translateY(-3px); box-shadow:0 12px 32px rgba(18,53,14,0.25); color:#FFF7EA; }
  
  .pv-hero__cta--secondary { background:transparent; color:#12350E; border:2px solid rgba(18,53,14,0.15); }
  .pv-hero__cta--secondary:hover { background:rgba(18,53,14,0.05); border-color:#12350E; transform:translateY(-3px); color:#12350E; }
  
  .pv-hero__trust-micro { display: flex; align-items: center; gap: 0.8rem; font-size: 1.3rem; color: #6F7568; font-weight: 500; }
  
  @media (max-width:749px) { 
    .pv-hero__cta-group { flex-direction:column; align-items:stretch; } 
    .pv-hero__cta { justify-content: center; } 
    .pv-hero__trust-micro { justify-content: center; text-align: center; }
  }

  /* Right Column Visual Styling */
  .pv-hero__visual { position: relative; display: flex; justify-content: center; padding: 2rem 0; }
  .pv-hero__card-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 85%; height: 85%; background: radial-gradient(circle, rgba(217,154,43,0.3) 0%, rgba(217,154,43,0) 70%); z-index: 0; filter: blur(45px); }
  .pv-hero__card { position: relative; z-index: 1; border-radius: 24px; overflow: visible; box-shadow: 0 24px 48px rgba(18,53,14,0.08); width: 100%; max-width: 480px; background: #FFFFFF; }
  .pv-hero__card-img { width: 100%; height: auto; display: block; border-radius: 24px; object-fit: cover; aspect-ratio: 4/5; }
  .pv-hero__card-placeholder { background: #F0EAE0; display: flex; align-items: center; justify-content: center; }
  
  .pv-hero__badge { position: absolute; background: #FFFFFF; color: #12350E; font-size: 1.3rem; font-weight: 700; padding: 1rem 1.8rem; border-radius: 999px; box-shadow: 0 12px 32px rgba(18,53,14,0.1); white-space: nowrap; border: 1px solid rgba(18,53,14,0.05); }
  .pv-hero__badge--1 { top: 10%; left: -8%; animation: float1 6s ease-in-out infinite; }
  .pv-hero__badge--2 { bottom: 25%; right: -12%; animation: float2 7s ease-in-out infinite; }
  .pv-hero__badge--3 { bottom: 5%; left: 8%; animation: float3 8s ease-in-out infinite; }

  @media (max-width: 749px) {
    .pv-hero__badge { font-size: 1.1rem; padding: 0.8rem 1.4rem; }
    .pv-hero__badge--1 { left: 5%; top: -3%; }
    .pv-hero__badge--2 { right: 5%; bottom: 15%; }
    .pv-hero__badge--3 { left: 10%; bottom: -3%; }
    .pv-hero__bullets { flex-direction: column; }
    .pv-hero__bullet { background:rgba(18,53,14,0.03); padding: 0.8rem 1.6rem; border-radius: 12px; font-size: 1.4rem; }
    .pv-hero__bullet-icon { display: flex; }
  }

  @keyframes float1 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes float2 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  @keyframes float3 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) {
    .pv-hero__badge { animation: none; }
  }
</style>

{% schema %}
{
  "name": "PV Hero Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
      { "type": "image_picker", "id": "image_desktop", "label": "Desktop background image", "info": "Recommended: 2400×900px. Place the dog on the right side of your photo." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile background image", "info": "Optional. Falls back to desktop image if blank. Recommended: 900×1100px." },
    { "type": "select", "id": "bg_position", "label": "Desktop background position", "default": "center right", "options": [
      { "value": "center center", "label": "Center center" },
      { "value": "center right",  "label": "Center right (default)" },
      { "value": "center left",   "label": "Center left" },
      { "value": "top center",    "label": "Top center" },
      { "value": "bottom center", "label": "Bottom center" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "No-Pull Tactical Harness" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Walks Without Pulling. Adventures Without Stress." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "The PawVoyage No-Pull Tactical Harness helps keep your dog secure, comfortable, and easier to control — from daily walks to outdoor adventures." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop The Harness" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_label_2", "label": "Secondary CTA label", "default": "See How It Works" },
    { "type": "url", "id": "cta_link_2", "label": "Secondary CTA link" },
    { "type": "range", "id": "hero_height_mobile", "min": 480, "max": 1000, "step": 20, "unit": "px", "label": "Mobile height", "default": 600 },
    { "type": "range", "id": "hero_height_desktop", "min": 560, "max": 1000, "step": 20, "unit": "px", "label": "Desktop height", "default": 740 }
  ],
  "blocks": [
    { "type": "benefit_bullet", "name": "Benefit bullet", "settings": [ { "type": "text", "id": "text", "label": "Benefit text", "default": "No-pull control" } ] }
  ],
  "presets": [
    {
      "name": "PV Hero Banner",
      "blocks": [
        { "type": "benefit_bullet", "settings": { "text": "No-pull control" } },
        { "type": "benefit_bullet", "settings": { "text": "Comfortable padded fit" } },
        { "type": "benefit_bullet", "settings": { "text": "Built for walks & travel" } }
      ]
    }
  ]
}
{% endschema %}
