{{ 'pawvoyage-brand.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #pv-hero-{{ section.id }} {
    position: relative;
    min-height: {{ section.settings.hero_height_mobile }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: radial-gradient(circle at 75% 30%, #173f12 0%, #102f0c 40%, #0b2108 100%);
  }
  @media screen and (min-width: 990px) {
    #pv-hero-{{ section.id }} { min-height: {{ section.settings.hero_height_desktop }}px; }
  }
{%- endstyle -%}

<section id="pv-hero-{{ section.id }}" class="pv-hero">
  <div class="page-width pv-hero__content-wrap">
    <div class="pv-hero__grid">
      <!-- Left Column: Content -->
      <div class="pv-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="pv-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="pv-hero__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pv-hero__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="pv-hero__bullets">
            {%- for block in section.blocks -%}
              {%- if block.type == 'benefit_bullet' -%}
                <li class="pv-hero__bullet" {{ block.shopify_attributes }}>
                  <span class="pv-hero__bullet-icon">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7L5.5 10.5L12 3.5" stroke="#102f0c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="pv-hero__cta-group">
          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_link | default: '#' }}" class="pv-hero__cta pv-hero__cta--primary" id="pv-hero-cta-1-{{ section.id }}">
              {{ section.settings.cta_label }}
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M10 5l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_label_2 != blank -%}
            <a href="{{ section.settings.cta_link_2 | default: '#' }}" class="pv-hero__cta pv-hero__cta--secondary" id="pv-hero-cta-2-{{ section.id }}">{{ section.settings.cta_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column: Visual Area -->
      <div class="pv-hero__visual">
        <div class="pv-hero__card-glow"></div>
        <div class="pv-hero__card">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 900 | image_tag: class: 'pv-hero__card-img', loading: 'eager', fetchpriority: 'high', widths: '450, 600, 900', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image.alt | escape }}
          {%- else -%}
            <div class="pv-hero__card-img pv-hero__card-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          
          <div class="pv-hero__badge pv-hero__badge--1">
            🐾 No-pull control
          </div>
          <div class="pv-hero__badge pv-hero__badge--2">
            ☁️ Comfort padded fit
          </div>
          <div class="pv-hero__badge pv-hero__badge--3">
            ⛰️ Adventure ready
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pv-hero { background-color: #102f0c; }
  .pv-hero__content-wrap { position:relative; z-index:2; width:100%; padding-top:6rem; padding-bottom:6rem; }
  .pv-hero__grid { display: grid; grid-template-columns: 1fr; gap: 4rem; align-items: center; }
  
  @media screen and (min-width: 990px) {
    .pv-hero__grid { grid-template-columns: 1.1fr 0.9fr; gap: 6rem; }
  }

  /* Left Column Styling */
  .pv-hero__eyebrow { display:inline-block; font-size:1.1rem; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#C4853A; margin-bottom:1.6rem; border:1px solid rgba(196,133,58,0.4); padding:0.4rem 1.4rem; border-radius:999px; }
  .pv-hero__heading { font-size:clamp(3.6rem,5vw,5.6rem); font-weight:800; color:#FAF7F2; line-height:1.1; letter-spacing:-0.02em; margin:0 0 2rem; max-width:72rem; }
  .pv-hero__subheading { font-size:clamp(1.5rem,2vw,1.8rem); color:rgba(250,247,242,0.85); line-height:1.65; max-width:56rem; margin:0 0 3.2rem; }
  .pv-hero__bullets { list-style:none; margin:0 0 4rem; padding:0; display:flex; flex-direction: column; gap:1.4rem; }
  .pv-hero__bullet { display:inline-flex; align-items:center; gap:1.2rem; font-size:1.5rem; font-weight:600; color:#FAF7F2; }
  .pv-hero__bullet-icon { display:inline-flex; align-items:center; justify-content:center; width:2.4rem; height:2.4rem; background:#C4853A; border-radius:50%; flex-shrink:0; }
  .pv-hero__cta-group { display:flex; flex-wrap:wrap; gap:1.6rem; align-items:center; }
  .pv-hero__cta { display:inline-flex; align-items:center; gap:0.8rem; font-size:1.6rem; font-weight:700; padding:1.4rem 3.2rem; border-radius:999px; text-decoration:none; transition:all 0.28s ease; }
  .pv-hero__cta--primary { background:#C4853A; color:#102f0c; border:2px solid #C4853A; box-shadow:0 4px 20px rgba(196,133,58,0.4); }
  .pv-hero__cta--primary:hover { background:#D9A05A; border-color:#D9A05A; transform:translateY(-3px); box-shadow:0 8px 32px rgba(196,133,58,0.5); color:#102f0c; text-decoration:none; }
  .pv-hero__cta--secondary { background:transparent; color:#FAF7F2; border:2px solid rgba(250,247,242,0.4); }
  .pv-hero__cta--secondary:hover { background:rgba(250,247,242,0.1); border-color:rgba(250,247,242,0.8); transform:translateY(-3px); color:#FAF7F2; text-decoration:none; }
  @media (max-width:749px) { .pv-hero__cta-group { flex-direction:column; align-items:stretch; } .pv-hero__cta { font-size:1.5rem; padding:1.2rem 2.4rem; justify-content: center; } }

  /* Right Column Visual Styling */
  .pv-hero__visual { position: relative; display: flex; justify-content: center; padding: 2rem 0; }
  .pv-hero__card-glow { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 85%; height: 85%; background: radial-gradient(circle, rgba(196,133,58,0.45) 0%, rgba(196,133,58,0) 70%); z-index: 0; filter: blur(45px); }
  .pv-hero__card { position: relative; z-index: 1; border-radius: 24px; overflow: visible; box-shadow: 0 32px 64px rgba(0,0,0,0.5); width: 100%; max-width: 480px; background: #FAF7F2; }
  .pv-hero__card-img { width: 100%; height: auto; display: block; border-radius: 24px; object-fit: cover; aspect-ratio: 4/5; }
  .pv-hero__card-placeholder { background: #E8E0D5; display: flex; align-items: center; justify-content: center; }
  
  .pv-hero__badge { position: absolute; background: #FAF7F2; color: #102f0c; font-size: 1.3rem; font-weight: 700; padding: 0.8rem 1.6rem; border-radius: 999px; box-shadow: 0 12px 32px rgba(0,0,0,0.25); white-space: nowrap; border: 1px solid rgba(0,0,0,0.05); }
  .pv-hero__badge--1 { top: 10%; left: -8%; animation: float1 6s ease-in-out infinite; }
  .pv-hero__badge--2 { bottom: 25%; right: -12%; animation: float2 7s ease-in-out infinite; }
  .pv-hero__badge--3 { bottom: 5%; left: 8%; animation: float3 8s ease-in-out infinite; }

  @media (max-width: 749px) {
    .pv-hero__badge { font-size: 1.1rem; padding: 0.6rem 1.2rem; }
    .pv-hero__badge--1 { left: 5%; top: -3%; }
    .pv-hero__badge--2 { right: 5%; bottom: 15%; }
    .pv-hero__badge--3 { left: 10%; bottom: -3%; }
    .pv-hero__bullets { flex-direction: row; flex-wrap: wrap; }
    .pv-hero__bullet { background:rgba(250,247,242,0.1); padding: 0.6rem 1.2rem; border-radius: 999px; font-size: 1.3rem; }
    .pv-hero__bullet-icon { display: none; }
  }

  @keyframes float1 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes float2 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  @keyframes float3 { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) {
    .pv-hero__badge { animation: none; }
  }
</style>

{% schema %}
{
  "name": "PV Hero Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product card image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "No-Pull Tactical Harness" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Walks Without Pulling. Adventures Without Stress." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "The PawVoyage No-Pull Tactical Harness helps keep your dog secure, comfortable, and easier to control — from daily walks to outdoor adventures." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop The Harness" },
    { "type": "url", "id": "cta_link", "label": "Primary CTA link" },
    { "type": "text", "id": "cta_label_2", "label": "Secondary CTA label", "default": "See How It Works" },
    { "type": "url", "id": "cta_link_2", "label": "Secondary CTA link" },
    { "type": "range", "id": "hero_height_mobile", "min": 480, "max": 1000, "step": 20, "unit": "px", "label": "Mobile height", "default": 600 },
    { "type": "range", "id": "hero_height_desktop", "min": 560, "max": 1000, "step": 20, "unit": "px", "label": "Desktop height", "default": 740 }
  ],
  "blocks": [
    { "type": "benefit_bullet", "name": "Benefit bullet", "settings": [ { "type": "text", "id": "text", "label": "Benefit text", "default": "No-pull control" } ] }
  ],
  "presets": [
    {
      "name": "PV Hero Banner",
      "blocks": [
        { "type": "benefit_bullet", "settings": { "text": "No-pull control" } },
        { "type": "benefit_bullet", "settings": { "text": "Comfortable padded fit" } },
        { "type": "benefit_bullet", "settings": { "text": "Built for walks & travel" } }
      ]
    }
  ]
}
{% endschema %}
