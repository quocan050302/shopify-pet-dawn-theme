{%- liquid
  assign hero_img   = section.settings.desktop_background_image
  assign hero_img_m = section.settings.mobile_background_image
  assign feat_prod  = section.settings.sticky_product
  assign show_sticky = section.settings.show_sticky_atc
-%}

{%- style -%}
/* ── PawVoyage Hero Conversion — scoped to section ── */
#pvhc-{{ section.id }} {
  position: relative;
  min-height: auto;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #FAF7F0;
  font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
}
@media (min-width: 750px) { #pvhc-{{ section.id }} { min-height: 680px; } }
@media (min-width: 990px) { #pvhc-{{ section.id }} { min-height: 760px; } }

/* Background image container */
#pvhc-{{ section.id }} .pvhc-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-color: #c8d8c0; /* fallback colour */
  overflow: hidden;
}
#pvhc-{{ section.id }} .pvhc-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center right;
  display: block;
}
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-bg-img {
    object-position: center center;
  }
  #pvhc-{{ section.id }} .pvhc-bg-img--desktop { display: none; }
}
@media (min-width: 750px) {
  #pvhc-{{ section.id }} .pvhc-bg-img--mobile { display: none; }
}

/* Left overlay — smooth cream gradient matching reference */
#pvhc-{{ section.id }} .pvhc-overlay {
  display: block !important;
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: linear-gradient(
    to right,
    #FAF7F0 0%,
    #FAF7F0 28%,
    rgba(250,247,240,0.96) 35%,
    rgba(250,247,240,0.88) 42%,
    rgba(250,247,240,0.65) 50%,
    rgba(250,247,240,0.30) 58%,
    rgba(250,247,240,0.08) 66%,
    rgba(250,247,240,0.00) 75%
  );
}
/* ── MOBILE HERO COMPLETE OVERRIDE (max-width 749px) ── */
@media (max-width: 749px) {
  /* Root section: flat cream bg, no min-height, no overflow needed for bg image */
  #pvhc-{{ section.id }} {
    display: block;
    min-height: unset !important;
    background: #FFF7EA;
    overflow: visible;
    padding: 0;
  }

  /* Hide desktop bg + overlay completely on mobile */
  #pvhc-{{ section.id }} .pvhc-bg,
  #pvhc-{{ section.id }} .pvhc-overlay {
    display: none !important;
  }

  /* Content wrap: just the top text area */
  #pvhc-{{ section.id }} .pvhc-wrap {
    padding: 22px 24px 0;
    position: relative;
    z-index: 1;
  }

  /* Hide benefit strip (bottom strip) — replaced by trust bar */
  #pvhc-{{ section.id }} .pvhc-strip { display: none !important; }

  /* Hide desktop callouts */
  #pvhc-{{ section.id }} .pvhc-callouts { display: none !important; }
}

/* Keep original overlay on desktop only */
@media (min-width: 750px) {
  #pvhc-{{ section.id }} .pvhc-overlay {
    display: block !important;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      #FAF7F0 0%,
      #FAF7F0 28%,
      rgba(250,247,240,0.96) 35%,
      rgba(250,247,240,0.88) 42%,
      rgba(250,247,240,0.65) 50%,
      rgba(250,247,240,0.30) 58%,
      rgba(250,247,240,0.08) 66%,
      rgba(250,247,240,0.00) 75%
    );
  }
}

/* Content wrap */
#pvhc-{{ section.id }} .pvhc-wrap {
  position: relative;
  z-index: 2;
  max-width: 1360px;
  margin: 0 auto;
  width: 100%;
  padding: 6rem 2rem;
}
@media (min-width: 750px) {
  #pvhc-{{ section.id }} .pvhc-wrap { padding: 6rem 2rem; }
}
/* Mobile: override the 6rem base rule above */
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-wrap { padding: 16px 20px 0 !important; }
}

/* Left column */
#pvhc-{{ section.id }} .pvhc-left {
  max-width: 560px;
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Social proof row */
#pvhc-{{ section.id }} .pvhc-proof {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
#pvhc-{{ section.id }} .pvhc-avatars {
  display: flex;
  margin-right: .4rem;
}
#pvhc-{{ section.id }} .pvhc-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2px solid #FAF7F0;
  object-fit: cover;
  margin-left: -8px;
  background: #d0c8b8;
}
#pvhc-{{ section.id }} .pvhc-avatar:first-child { margin-left: 0; }
#pvhc-{{ section.id }} .pvhc-proof-text {
  display: flex;
  flex-direction: column;
  gap: .2rem;
}
#pvhc-{{ section.id }} .pvhc-proof-trust {
  font-size: 1.15rem;
  font-weight: 700;
  color: #2A3228;
  line-height: 1;
}
#pvhc-{{ section.id }} .pvhc-proof-rating {
  display: flex;
  align-items: center;
  gap: .4rem;
  font-size: 1.1rem;
  color: #4A5748;
  font-weight: 600;
}
#pvhc-{{ section.id }} .pvhc-stars { color: #D4A843; letter-spacing: 1px; font-size: 1.2rem; }

/* Headline */
#pvhc-{{ section.id }} .pvhc-headline {
  font-size: clamp(3.6rem, 5.5vw, 6rem);
  font-weight: 900;
  color: #133316;
  line-height: 1.0;
  letter-spacing: -.03em;
  margin: 0 0 1.6rem;
}
#pvhc-{{ section.id }} .pvhc-headline-accent { color: #1A5C1E; }
@media (max-width: 749px) {
  /* Tighten social proof margin */
  #pvhc-{{ section.id }} .pvhc-proof { margin-bottom: 8px; }

  #pvhc-{{ section.id }} .pvhc-headline {
    font-size: clamp(38px, 11vw, 49px);
    margin-top: 0;
    margin-bottom: 6px;
    line-height: 0.95;
  }
  /* Reset browser <p> default margins inside Shopify richtext headline */
  #pvhc-{{ section.id }} .pvhc-headline p {
    margin: 0;
    padding: 0;
  }
}

/* Subheadline */
#pvhc-{{ section.id }} .pvhc-sub {
  font-size: clamp(1.5rem, 2vw, 1.75rem);
  color: #3A4838;
  line-height: 1.6;
  margin: 0 0 2.2rem;
  max-width: 500px;
  font-weight: 500;
}
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-sub {
    font-size: 1.4rem;
    margin-top: 0;
    margin-bottom: 14px;
    line-height: 1.4;
  }
}

/* Benefit icon row — Desktop */
#pvhc-{{ section.id }} .pvhc-benefits {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
  margin-bottom: 2.8rem;
}
#pvhc-{{ section.id }} .pvhc-ben {
  display: flex;
  align-items: center;
  gap: .7rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #133316;
}
#pvhc-{{ section.id }} .pvhc-ben-icon {
  width: 32px;
  height: 32px;
  background: rgba(19,51,22,.10);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
#pvhc-{{ section.id }} .pvhc-ben-icon svg { width: 16px; height: 16px; stroke: #133316; }

/* ── Mobile benefit grid (3-col) ── */
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-benefits {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
    flex-wrap: unset;
  }
  #pvhc-{{ section.id }} .pvhc-ben {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 7px;
    font-size: 1.15rem;
    font-weight: 800;
    color: #1F241D;
    background: none;
    padding: 0;
    border: none;
  }
  #pvhc-{{ section.id }} .pvhc-ben-icon {
    width: 46px;
    height: 46px;
    background: #FFFFFF;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(7,31,6,0.09);
    flex-shrink: 0;
  }
  #pvhc-{{ section.id }} .pvhc-ben-icon svg { width: 20px; height: 20px; stroke: #12350E; }
}

/* CTA — Desktop */
#pvhc-{{ section.id }} .pvhc-cta-wrap { margin-bottom: 1.4rem; }
#pvhc-{{ section.id }} .pvhc-cta {
  display: inline-flex;
  align-items: center;
  gap: .8rem;
  background: #133316;
  color: #fff;
  font-size: 1.75rem;
  font-weight: 800;
  padding: 1.7rem 3.6rem;
  border-radius: 999px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  box-shadow: 0 10px 28px rgba(19,51,22,.25);
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
  letter-spacing: -.01em;
}
#pvhc-{{ section.id }} .pvhc-cta:hover {
  background: #1A4A20;
  transform: translateY(-2px);
  box-shadow: 0 16px 36px rgba(19,51,22,.30);
  color: #fff;
}
/* Hide default CTA wrap on mobile — replaced by .pvhc-mobile-cta */
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-cta-wrap { display: none !important; }
}

/* Guarantee microcopy */
#pvhc-{{ section.id }} .pvhc-guarantee {
  display: flex;
  align-items: center;
  gap: 1.4rem;
  flex-wrap: wrap;
  font-size: 1.25rem;
  color: #4A5748;
  font-weight: 600;
  margin-bottom: 0;
}
#pvhc-{{ section.id }} .pvhc-guarantee span {
  display: flex;
  align-items: center;
  gap: .5rem;
}
#pvhc-{{ section.id }} .pvhc-guarantee svg { width: 14px; height: 14px; stroke: #133316; flex-shrink: 0; }
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-guarantee { display: none !important; }
}

/* ── CALLOUT LABELS (desktop only) ── */
#pvhc-{{ section.id }} .pvhc-callouts {
  display: none;
}
@media (min-width: 990px) {
  #pvhc-{{ section.id }} .pvhc-callouts {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
}
#pvhc-{{ section.id }} .pvhc-callout {
  position: absolute;
  display: flex;
  align-items: center;
  gap: .6rem;
  background: rgba(10,25,12,.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: #fff;
  font-size: 1.1rem;
  font-weight: 700;
  padding: .65rem 1.2rem .65rem .8rem;
  border-radius: 999px;
  letter-spacing: .02em;
  white-space: nowrap;
  pointer-events: auto;
}
#pvhc-{{ section.id }} .pvhc-callout-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #D4A843;
  flex-shrink: 0;
}
/* Callout positions */
#pvhc-{{ section.id }} .pvhc-callout--1 { top: 18%; right: 36%; }
#pvhc-{{ section.id }} .pvhc-callout--2 { top: 46%; right: 14%; }
#pvhc-{{ section.id }} .pvhc-callout--3 { bottom: 28%; right: 24%; }

/* Mobile callout chips */
#pvhc-{{ section.id }} .pvhc-callout-chips {
  display: none !important;
}
#pvhc-{{ section.id }} .pvhc-chip {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  background: rgba(19,51,22,.08);
  color: #133316;
  font-size: 1.1rem;
  font-weight: 700;
  padding: .55rem 1.2rem;
  border-radius: 999px;
  border: 1px solid rgba(19,51,22,.14);
}
#pvhc-{{ section.id }} .pvhc-chip-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #D4A843;
  flex-shrink: 0;
}

/* ── BENEFIT STRIP (desktop) ── */
#pvhc-{{ section.id }} .pvhc-strip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  padding: 0 2rem 1.6rem;
  pointer-events: none;
}
#pvhc-{{ section.id }} .pvhc-strip-inner {
  max-width: 1360px;
  margin: 0 auto;
  background: rgba(255,255,255,0.90);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.6);
  border-radius: 20px;
  padding: 1.6rem 2rem;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.6rem;
  pointer-events: auto;
  box-shadow: 0 8px 32px rgba(19,51,22,.08);
}
#pvhc-{{ section.id }} .pvhc-strip-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}
#pvhc-{{ section.id }} .pvhc-strip-icon {
  width: 38px;
  height: 38px;
  background: rgba(19,51,22,.08);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
#pvhc-{{ section.id }} .pvhc-strip-icon svg { width: 18px; height: 18px; stroke: #133316; }
#pvhc-{{ section.id }} .pvhc-strip-title {
  font-size: 1.35rem;
  font-weight: 800;
  color: #133316;
  margin: 0 0 .3rem;
}
#pvhc-{{ section.id }} .pvhc-strip-text {
  font-size: 1.2rem;
  color: #4A5748;
  line-height: 1.45;
  margin: 0;
}

/* ── MOBILE-ONLY NEW ELEMENTS ── */
/* Mobile image card */
@media (max-width: 749px) {
  #pvhc-{{ section.id }} .pvhc-mobile-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 3;   /* shorter — landscape vs portrait */
    overflow: hidden;
    display: block;
    margin-top: 4px;
    border-radius: 16px;
    overflow: hidden;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  /* Bottom gradient so CTA reads over image */
  #pvhc-{{ section.id }} .pvhc-mobile-img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 120px;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(7,31,6,0.45) 100%);
    pointer-events: none;
  }
  /* Floating badge on image */
  #pvhc-{{ section.id }} .pvhc-mobile-badge {
    position: absolute;
    left: 20px;
    top: 40%;
    transform: translateY(-50%);
    background: #FFFFFF;
    color: #12350E;
    border-radius: 999px;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    box-shadow: 0 10px 28px rgba(7,31,6,0.18);
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #D99A2B;
    flex-shrink: 0;
  }
  /* Mobile CTA — overlaps bottom of image */
  #pvhc-{{ section.id }} .pvhc-mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: -24px 20px 0;
    min-height: 48px;
    border-radius: 14px;
    background: #12350E;
    color: #FFF7EA;
    font-size: 1.55rem;
    font-weight: 900;
    text-decoration: none;
    letter-spacing: -.02em;
    box-shadow: 0 12px 28px rgba(7,31,6,0.26);
    position: relative;
    z-index: 2;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-cta:hover,
  #pvhc-{{ section.id }} .pvhc-mobile-cta:active {
    background: #1A4A20;
    transform: translateY(-2px);
    color: #FFF7EA;
  }
  /* Trust bar below CTA */
  #pvhc-{{ section.id }} .pvhc-mobile-trustbar {
    margin-top: -8px;
    padding: 30px 16px 20px;
    background: #FFF7EA;
    border-radius: 20px 20px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    position: relative;
    z-index: 1;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 800;
    color: #1F241D;
    padding: 0 6px;
    line-height: 1.25;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-trust-item + .pvhc-mobile-trust-item {
    border-left: 1px solid rgba(31,36,29,0.12);
  }
  #pvhc-{{ section.id }} .pvhc-mobile-trust-icon {
    width: 28px;
    height: 28px;
    color: #D99A2B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  #pvhc-{{ section.id }} .pvhc-mobile-trust-icon svg {
    width: 22px;
    height: 22px;
    stroke: #D99A2B;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Hide these on mobile — they only exist for desktop */
  #pvhc-{{ section.id }} .pvhc-mobile-img-wrap,
  #pvhc-{{ section.id }} .pvhc-mobile-cta,
  #pvhc-{{ section.id }} .pvhc-mobile-trustbar {
    /* Show on mobile */
  }
}
/* Hide mobile-only elements on desktop */
@media (min-width: 750px) {
  #pvhc-{{ section.id }} .pvhc-mobile-img-wrap,
  #pvhc-{{ section.id }} .pvhc-mobile-cta,
  #pvhc-{{ section.id }} .pvhc-mobile-trustbar {
    display: none !important;
  }
}

/* ── STICKY ATC — Floating Card ── */
#pvhc-sticky-{{ section.id }} {
  /* Floating card: fixed + margin from all screen edges */
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(calc(100% + 30px));
  width: min(1180px, calc(100% - 48px));
  z-index: 9000;

  /* Glassmorphism card */
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-radius: 20px;
  border: 1px solid rgba(20, 45, 25, 0.08);
  box-shadow: 0 18px 50px rgba(20, 45, 25, 0.16);
  padding: 12px 18px;

  /* Slide-up animation (starts fully below viewport) */
  opacity: 0;
  transition:
    transform .38s cubic-bezier(.4, 0, .2, 1),
    opacity   .38s cubic-bezier(.4, 0, .2, 1);
  pointer-events: none;
}
#pvhc-sticky-{{ section.id }}.pvhc-sticky-visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
  pointer-events: auto;
}

/* Inner layout */
#pvhc-sticky-{{ section.id }} .pvhc-sticky-inner {
  display: flex;
  align-items: center;
  gap: 1.6rem;
}

/* Left: thumbnail + title + rating */
#pvhc-sticky-{{ section.id }} .pvhc-sticky-left {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 1;
  min-width: 0;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-thumb {
  width: 46px;
  height: 46px;
  border-radius: 9px;
  object-fit: cover;
  background: #EDE8DC;
  flex-shrink: 0;
  overflow: hidden;
  border: 1px solid rgba(20, 45, 25, 0.08);
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-meta {
  display: flex;
  flex-direction: column;
  gap: .15rem;
  min-width: 0;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: #133316;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-rating {
  display: flex;
  align-items: center;
  gap: .35rem;
  font-size: 1.05rem;
  color: #4A5748;
  font-weight: 500;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-stars {
  color: #D4A843;
  font-size: 1.05rem;
  letter-spacing: .5px;
}

/* Mid: price + microcopy */
#pvhc-sticky-{{ section.id }} .pvhc-sticky-mid {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: .2rem;
  flex-shrink: 0;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-prices {
  display: flex;
  align-items: center;
  gap: .6rem;
  flex-wrap: wrap;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-price {
  font-size: 1.65rem;
  font-weight: 800;
  color: #133316;
  line-height: 1;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-compare {
  font-size: 1.25rem;
  color: #9CA8A0;
  text-decoration: line-through;
  font-weight: 500;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-save {
  font-size: 1.0rem;
  font-weight: 800;
  color: #fff;
  background: #133316;
  padding: .2rem .7rem;
  border-radius: 5px;
  letter-spacing: .02em;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-micro {
  font-size: 1.0rem;
  color: #6B7568;
  font-weight: 500;
  white-space: nowrap;
}

/* Right: CTA button */
#pvhc-sticky-{{ section.id }} .pvhc-sticky-right { flex-shrink: 0; }
#pvhc-sticky-{{ section.id }} .pvhc-sticky-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  background: #133316;
  color: #fff;
  font-size: 1.4rem;
  font-weight: 800;
  padding: 1.1rem 2.2rem;
  border-radius: 999px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  box-shadow: 0 6px 18px rgba(19, 51, 22, 0.22);
  transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
  letter-spacing: -.01em;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-btn:hover {
  background: #1A4A20;
  transform: translateY(-1px);
  box-shadow: 0 10px 26px rgba(19, 51, 22, 0.28);
  color: #fff;
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-btn:active {
  transform: translateY(0);
  box-shadow: 0 4px 12px rgba(19, 51, 22, 0.20);
}
#pvhc-sticky-{{ section.id }} .pvhc-sticky-btn:disabled,
#pvhc-sticky-{{ section.id }} .pvhc-sticky-btn[disabled] {
  background: #9CA8A0;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* ── Mobile: compact floating pill ── */
@media (max-width: 749px) {
  #pvhc-sticky-{{ section.id }} {
    bottom: 14px;
    left: 12px;
    right: 12px;
    width: auto;
    transform: translateY(calc(100% + 24px));
    border-radius: 18px;
    padding: 10px 14px 10px 12px;
  }
  #pvhc-sticky-{{ section.id }}.pvhc-sticky-visible {
    transform: translateY(0);
    opacity: 1;
  }
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-inner {
    flex-direction: row;
    gap: 1rem;
    align-items: center;
  }
  /* Left: thumbnail + meta */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-left {
    flex: 1;
    min-width: 0;
    gap: .8rem;
  }
  /* Thumbnail smaller on mobile */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-thumb {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    flex-shrink: 0;
  }
  /* Title: single line, uses all available space */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-title {
    font-size: 1.2rem;
    max-width: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Rating: compact single line */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-rating {
    font-size: .95rem;
    white-space: nowrap;
    gap: .25rem;
  }
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-stars {
    font-size: .95rem;
  }
  /* Hide mid (price block) — price is in button */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-mid { display: none; }
  /* Right: CTA button */
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-right {
    flex-shrink: 0;
    margin-left: auto;
  }
  #pvhc-sticky-{{ section.id }} .pvhc-sticky-btn {
    font-size: 1.3rem;
    padding: .95rem 1.5rem;
    white-space: nowrap;
  }
}

/* No body padding needed — sticky bar floats above content */
{%- endstyle -%}

<!-- ===== HERO SECTION ===== -->
<section id="pvhc-{{ section.id }}" aria-label="{{ section.settings.headline | strip_html | escape }}">

