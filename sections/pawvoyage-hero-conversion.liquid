<!-- ===== STICKY ATC ===== -->
{%- if section.settings.show_sticky_atc -%}
{%- liquid
  assign s_prod = section.settings.sticky_product
  assign s_variant = nil
  if s_prod != blank
    assign s_variant = s_prod.selected_or_first_available_variant
  endif
-%}
<div
  id="pvhc-sticky-{{ section.id }}"
  role="complementary"
  aria-label="Quick add to cart"
  aria-hidden="true"
>
  <div class="pvhc-sticky-inner">

    <!-- Left: thumbnail + title + rating -->
    <div class="pvhc-sticky-left">
      <div class="pvhc-sticky-thumb">
        {%- if s_prod != blank and s_prod.featured_image != blank -%}
          <img src="{{ s_prod.featured_image | image_url: width: 120 }}" alt="{{ s_prod.title | escape }}" width="52" height="52" loading="lazy">
        {%- else -%}
          <svg viewBox="0 0 52 52" fill="none" style="width:52px;height:52px;"><rect width="52" height="52" fill="#D5C9B5" rx="10"/><text x="26" y="33" text-anchor="middle" font-size="24" fill="#8A9486">🐾</text></svg>
        {%- endif -%}
      </div>
      <div class="pvhc-sticky-meta">
        <span class="pvhc-sticky-title">
          {%- if section.settings.sticky_title != blank -%}
            {{ section.settings.sticky_title }}
          {%- elsif s_prod != blank -%}
            {{ s_prod.title }}
          {%- else -%}
            PawVoyage No-Pull Tactical Dog Harness
          {%- endif -%}
        </span>
        {%- if section.settings.sticky_rating_text != blank -%}
        <span class="pvhc-sticky-rating">
          <span class="pvhc-sticky-stars">★★★★★</span>
          {{ section.settings.sticky_rating_text }}
        </span>
        {%- endif -%}
      </div>
    </div>

    <!-- Mid: price + microcopy -->
    <div class="pvhc-sticky-mid">
      <div class="pvhc-sticky-prices">
        <span class="pvhc-sticky-price">
          {%- if section.settings.sticky_price_text != blank -%}
            {{ section.settings.sticky_price_text }}
          {%- elsif s_variant != nil -%}
            {{ s_variant.price | money }}
          {%- else -%}
            $49.99
          {%- endif -%}
        </span>
        {%- if section.settings.sticky_compare_price_text != blank -%}
        <span class="pvhc-sticky-compare">{{ section.settings.sticky_compare_price_text }}</span>
        {%- elsif s_variant != nil and s_variant.compare_at_price > s_variant.price -%}
        <span class="pvhc-sticky-compare">{{ s_variant.compare_at_price | money }}</span>
        {%- endif -%}
        {%- if section.settings.sticky_savings_text != blank -%}
        <span class="pvhc-sticky-save">{{ section.settings.sticky_savings_text }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.sticky_microcopy != blank -%}
      <span class="pvhc-sticky-micro">{{ section.settings.sticky_microcopy }}</span>
      {%- endif -%}
    </div>

    <!-- Right: Add to Cart -->
    <div class="pvhc-sticky-right">
      {%- if s_prod != blank and s_variant != nil -%}
        {%- liquid
          assign sold_out = false
          unless s_variant.available
            assign sold_out = true
          endunless
        -%}
        <form action="/cart/add" method="post" enctype="multipart/form-data" id="pvhc-sticky-form-{{ section.id }}">
          <input type="hidden" name="id" value="{{ s_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="pvhc-sticky-btn"
            id="pvhc-sticky-btn-{{ section.id }}"
            {%- if sold_out -%} disabled aria-disabled="true" {%- endif -%}
            aria-label="{{ section.settings.sticky_button_text | default: 'Add to Cart' }}"
          >
            {%- if sold_out -%}
              Sold Out
            {%- else -%}
              {{ section.settings.sticky_button_text | default: 'Add to Cart' }}
              {%- if s_variant.price != blank %} — {{ s_variant.price | money }}{%- endif -%}
            {%- endif -%}
          </button>
        </form>
      {%- else -%}
        <a
          href="{{ section.settings.cta_link | default: '/collections/all' }}"
          class="pvhc-sticky-btn"
          id="pvhc-sticky-btn-{{ section.id }}"
        >
          {{ section.settings.sticky_button_text | default: 'Shop Now' }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
(function(){
  var sticky = document.getElementById('pvhc-sticky-{{ section.id }}');
  if (!sticky) return;
  var shown         = false;
  var footerVisible = false;
  var threshold     = 300;

  /* ── helpers ── */
  function showBar() {
    if (shown) return;
    shown = true;
    sticky.classList.add('pvhc-sticky-visible');
    sticky.setAttribute('aria-hidden', 'false');

  }
  function hideBar() {
    if (!shown) return;
    shown = false;
    sticky.classList.remove('pvhc-sticky-visible');
    sticky.setAttribute('aria-hidden', 'true');

  }

  /* ── scroll threshold + near-bottom logic ── */
  function toggle() {
    if (footerVisible) return;          // footer in viewport — keep hidden

    var scrollY   = window.scrollY || window.pageYOffset;
    var nearBottom = (scrollY + window.innerHeight) >= (document.documentElement.scrollHeight - 120);

    if (nearBottom) {
      hideBar();                        // near page bottom — hide bar
    } else if (scrollY > threshold) {
      showBar();
    } else {
      hideBar();
    }
  }
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();

  /* ── hide bar + remove padding when footer enters viewport ── */
  var footer = document.querySelector('footer[id^="pvf-"], footer.pv-footer, footer');
  if (footer && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          footerVisible = true;
          hideBar();           // slide away + remove padding-bottom
        } else {
          footerVisible = false;
          toggle();            // re-check scroll position to possibly re-show
        }
      });
    }, { threshold: 0.01 });   // fire as soon as 1% of footer is visible
    io.observe(footer);
  }

  // AJAX cart integration (Dawn theme)
  var form = document.getElementById('pvhc-sticky-form-{{ section.id }}');
  if (form && window.fetch) {
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var btn = form.querySelector('.pvhc-sticky-btn');
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      var orig = btn.textContent;
      btn.textContent = 'Adding...';
      var fd = new FormData(form);
      fetch('/cart/add.js', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(){
          btn.textContent = '✓ Added!';
          // Trigger Dawn cart drawer if available
          document.dispatchEvent(new CustomEvent('cart:add'));
          if (window.Shopify && window.Shopify.onItemAdded) window.Shopify.onItemAdded();
          var cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer && typeof cartDrawer.open === 'function') cartDrawer.open();
          setTimeout(function(){
            btn.textContent = orig;
            btn.disabled = false;
          }, 2500);
        })
        .catch(function(){
          btn.textContent = orig;
          btn.disabled = false;
        });
    });
  }
})();
</script>
{%- endif -%}

