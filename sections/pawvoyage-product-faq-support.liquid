{%- comment -%}
  PawVoyage FAQ + Support Section
  sections/pawvoyage-product-faq-support.liquid
  v1.0
{%- endcomment -%}

<section class="pfq-outer" id="pfq-{{ section.id }}" aria-label="Frequently Asked Questions">
  <div class="pfq-wrap">
    <div class="pfq-layout">

      {%- comment -%} ═══ LEFT: FAQ COLUMN ═══ {%- endcomment -%}
      <div class="pfq-faq-col">

        {%- comment -%} Header {%- endcomment -%}
        <div class="pfq-header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="pfq-eyebrow">
              <svg class="pfq-eyebrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
              </svg>
              {{ section.settings.eyebrow }}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pfq-heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>

        {%- comment -%} Accordion {%- endcomment -%}
        <div class="pfq-accordion" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq_item' -%}
              <div class="pfq-faq-item" role="listitem" {{ block.shopify_attributes }}>
                <button
                  class="pfq-faq-btn"
                  aria-expanded="false"
                  aria-controls="pfq-panel-{{ section.id }}-{{ forloop.index }}"
                  id="pfq-btn-{{ section.id }}-{{ forloop.index }}"
                >
                  <span class="pfq-faq-question">{{ block.settings.question }}</span>
                  <svg class="pfq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
                <div
                  class="pfq-faq-panel"
                  id="pfq-panel-{{ section.id }}-{{ forloop.index }}"
                  role="region"
                  aria-labelledby="pfq-btn-{{ section.id }}-{{ forloop.index }}"
                >
                  <div class="pfq-faq-answer">{{ block.settings.answer }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- comment -%} Help center link {%- endcomment -%}
        {%- if section.settings.help_text != blank or section.settings.help_link_text != blank -%}
          <p class="pfq-help-center">
            {%- if section.settings.help_text != blank -%}
              {{ section.settings.help_text }}
            {%- endif -%}
            {%- if section.settings.help_link_text != blank -%}
              <a
                href="{{ section.settings.help_link | default: '#' }}"
                class="pfq-help-link"
                {% if section.settings.help_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
              >
                {{ section.settings.help_link_text }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}
          </p>
        {%- endif -%}

      </div>

      {%- comment -%} ═══ RIGHT: SUPPORT CARD ═══ {%- endcomment -%}
      <div class="pfq-support-col">
        <div class="pfq-support-card">

          {%- if section.settings.support_title != blank -%}
            <h3 class="pfq-support-title">{{ section.settings.support_title }}</h3>
          {%- endif -%}

          <ul class="pfq-support-items" role="list">

            <li class="pfq-support-item">
              <div class="pfq-support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div class="pfq-support-text">
                <strong class="pfq-support-item-title">{{ section.settings.support_1_title }}</strong>
                <span class="pfq-support-item-desc">{{ section.settings.support_1_desc }}</span>
              </div>
            </li>

            <li class="pfq-support-item">
              <div class="pfq-support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
              </div>
              <div class="pfq-support-text">
                <strong class="pfq-support-item-title">{{ section.settings.support_2_title }}</strong>
                <span class="pfq-support-item-desc">{{ section.settings.support_2_desc }}</span>
              </div>
            </li>

            <li class="pfq-support-item">
              <div class="pfq-support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>
                </svg>
              </div>
              <div class="pfq-support-text">
                <strong class="pfq-support-item-title">{{ section.settings.support_3_title }}</strong>
                <span class="pfq-support-item-desc">{{ section.settings.support_3_desc }}</span>
              </div>
            </li>

            <li class="pfq-support-item">
              <div class="pfq-support-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
                </svg>
              </div>
              <div class="pfq-support-text">
                <strong class="pfq-support-item-title">{{ section.settings.support_4_title }}</strong>
                <span class="pfq-support-item-desc">{{ section.settings.support_4_desc }}</span>
              </div>
            </li>

          </ul>

          {%- comment -%} CTA Button {%- endcomment -%}
          {%- if section.settings.cta_text != blank -%}
            <a
              href="{{ section.settings.cta_link | default: '#' }}"
              class="pfq-cta-btn"
              {% if section.settings.cta_link contains 'http' %}target="_blank" rel="noopener"{% endif %}
            >
              {{ section.settings.cta_text }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          {%- endif -%}

          {%- comment -%} Email {%- endcomment -%}
          {%- if section.settings.support_email != blank -%}
            <a href="mailto:{{ section.settings.support_email }}" class="pfq-email">
              {{ section.settings.support_email }}
            </a>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>
</section>

<style>
/* ============================================================
   PawVoyage FAQ + Support — scoped to #pfq-{{ section.id }}
   ============================================================ */
#pfq-{{ section.id }} {
  --pfq-green:      #12350e;
  --pfq-green-mid:  #1d4d18;
  --pfq-gold:       #c98a1a;
  --pfq-gold-btn:   #d4941f;
  --pfq-cream:      #fdf8f0;
  --pfq-white:      #ffffff;
  --pfq-text:       #1f241d;
  --pfq-text-sec:   #4a5246;
  --pfq-border:     rgba(31,36,29,0.09);
  --pfq-radius:     14px;
  --pfq-font:       'Inter', system-ui, -apple-system, sans-serif;
}

/* ── Outer ── */
.pfq-outer {
  background: var(--pfq-cream);
  padding: 5rem 0 4.4rem;
  overflow-x: hidden;
}

.pfq-wrap {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 3rem;
  box-sizing: border-box;
}

/* ── 2-Column Layout ── */
.pfq-layout {
  display: grid;
  grid-template-columns: 1fr 33%;
  gap: 4rem;
  align-items: start;
}

/* ══════════════════════
   FAQ COLUMN
   ══════════════════════ */
.pfq-faq-col {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* Header */
.pfq-header {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.pfq-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-family: var(--pfq-font);
  font-size: 1.1rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--pfq-gold);
  margin: 0;
}

.pfq-eyebrow-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

.pfq-heading {
  font-family: var(--pfq-font);
  font-size: clamp(2.6rem, 3vw, 3.6rem);
  font-weight: 900;
  color: var(--pfq-green);
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin: 0;
}

/* ── Accordion ── */
.pfq-accordion {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.pfq-faq-item {
  background: var(--pfq-white);
  border-radius: var(--pfq-radius);
  border: 1px solid var(--pfq-border);
  overflow: hidden;
  transition: box-shadow 0.2s;
}

.pfq-faq-item:has(.pfq-faq-btn[aria-expanded="true"]) {
  box-shadow: 0 4px 20px rgba(18,53,14,0.09);
}

.pfq-faq-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.2rem;
  padding: 1.5rem 1.8rem;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--pfq-font);
  -webkit-tap-highlight-color: transparent;
  transition: background 0.15s;
}

.pfq-faq-btn:hover {
  background: rgba(18,53,14,0.025);
}

.pfq-faq-question {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--pfq-text);
  line-height: 1.4;
  flex: 1;
}

.pfq-chevron {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--pfq-gold);
  transition: transform 0.3s ease;
}

.pfq-faq-btn[aria-expanded="true"] .pfq-chevron {
  transform: rotate(180deg);
}

/* Panel */
.pfq-faq-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.32s ease;
}

.pfq-faq-answer {
  padding: 0 1.8rem 1.6rem;
  font-family: var(--pfq-font);
  font-size: 1.35rem;
  color: var(--pfq-text-sec);
  line-height: 1.65;
  border-top: 1px solid var(--pfq-border);
  margin-top: 0;
  padding-top: 1.2rem;
}

/* Help center */
.pfq-help-center {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-family: var(--pfq-font);
  font-size: 1.3rem;
  color: var(--pfq-text-sec);
  margin: 0;
}

.pfq-help-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--pfq-gold);
  font-weight: 700;
  text-decoration: none;
  transition: opacity 0.15s;
}

.pfq-help-link:hover { opacity: 0.8; }

.pfq-help-link svg {
  width: 14px;
  height: 14px;
}

/* ══════════════════════
   SUPPORT CARD
   ══════════════════════ */
.pfq-support-col {
  position: sticky;
  top: 2rem;
}

.pfq-support-card {
  background: var(--pfq-green);
  border-radius: 18px;
  padding: 2.6rem 2.2rem;
  display: flex;
  flex-direction: column;
  gap: 1.8rem;
  box-shadow: 0 8px 32px rgba(18,53,14,0.22);
}

.pfq-support-title {
  font-family: var(--pfq-font);
  font-size: 2.4rem;
  font-weight: 900;
  color: var(--pfq-white);
  line-height: 1.2;
  letter-spacing: -0.015em;
  margin: 0;
}

/* Support items */
.pfq-support-items {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}

.pfq-support-item {
  display: flex;
  align-items: center;
  gap: 1.2rem;
}

.pfq-support-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.22);
  background: rgba(255,255,255,0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--pfq-white);
}

.pfq-support-icon svg {
  width: 20px;
  height: 20px;
}

.pfq-support-text {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.pfq-support-item-title {
  font-family: var(--pfq-font);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--pfq-white);
  line-height: 1.25;
}

.pfq-support-item-desc {
  font-size: 1.2rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.3;
}

/* Divider */
.pfq-support-divider {
  border: none;
  border-top: 1px solid rgba(255,255,255,0.12);
  margin: 0;
}

/* CTA Button */
.pfq-cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  background: var(--pfq-gold-btn);
  color: var(--pfq-green);
  font-family: var(--pfq-font);
  font-size: 1.4rem;
  font-weight: 800;
  padding: 1.25rem 1.8rem;
  border-radius: 10px;
  text-decoration: none;
  transition: transform 0.15s, box-shadow 0.15s;
  letter-spacing: 0.01em;
}

.pfq-cta-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 14px rgba(201,138,26,0.4);
}

.pfq-cta-btn svg {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
}

/* Email */
.pfq-email {
  text-align: center;
  font-family: var(--pfq-font);
  font-size: 1.2rem;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  margin: 0;
  transition: color 0.15s;
}

.pfq-email:hover { color: rgba(255,255,255,0.85); }

/* ══════════════════════
   TABLET ≤ 1099px
   ══════════════════════ */
@media screen and (max-width: 1099px) {
  .pfq-wrap { padding: 0 2rem; }
  .pfq-outer { padding: 4rem 0 3.2rem; }

  .pfq-layout {
    grid-template-columns: 1fr 36%;
    gap: 2.4rem;
  }

  .pfq-support-col { position: static; }

  .pfq-heading { font-size: 2.8rem; }

  .pfq-support-title { font-size: 2rem; }
  .pfq-support-card { padding: 2rem 1.8rem; gap: 1.4rem; }
}

/* ══════════════════════
   MOBILE ≤ 749px
   ══════════════════════ */
@media screen and (max-width: 749px) {
  .pfq-outer { padding: 3.2rem 0 2.8rem; }

  .pfq-wrap {
    padding: 0 1.6rem;
    max-width: 100%;
  }

  /* Stack: FAQ first, card below */
  .pfq-layout {
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  .pfq-support-col { position: static; }

  .pfq-heading { font-size: 2.4rem; }

  .pfq-faq-question { font-size: 1.3rem; }
  .pfq-faq-btn { padding: 1.3rem 1.4rem; }
  .pfq-faq-answer { font-size: 1.25rem; padding: 0 1.4rem 1.4rem; padding-top: 1.1rem; }

  .pfq-help-center { font-size: 1.25rem; }

  .pfq-support-card { padding: 2rem 1.6rem; border-radius: 14px; }
  .pfq-support-title { font-size: 2rem; }
  .pfq-support-item-title { font-size: 1.3rem; }
  .pfq-support-item-desc { font-size: 1.1rem; }
  .pfq-support-icon { width: 40px; height: 40px; }
  .pfq-support-icon svg { width: 18px; height: 18px; }

  /* Full-width CTA */
  .pfq-cta-btn {
    width: 100%;
    min-height: 50px;
    font-size: 1.35rem;
    border-radius: 10px;
  }
}

/* ── Very small ── */
@media screen and (max-width: 389px) {
  .pfq-wrap { padding: 0 1.2rem; }
  .pfq-heading { font-size: 2.2rem; }
}
</style>

<script>
(function () {
  var section = document.getElementById('pfq-{{ section.id }}');
  if (!section) return;

  var buttons = section.querySelectorAll('.pfq-faq-btn');

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var isExpanded = this.getAttribute('aria-expanded') === 'true';

      /* Close all panels */
      buttons.forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
        var panel = document.getElementById(b.getAttribute('aria-controls'));
        if (panel) panel.style.maxHeight = '0';
      });

      /* If it was closed, open it */
      if (!isExpanded) {
        this.setAttribute('aria-expanded', 'true');
        var panel = document.getElementById(this.getAttribute('aria-controls'));
        if (panel) panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });

    /* Keyboard: Enter / Space */
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        btn.click();
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "FAQ + Support",
  "tag": "section",
  "class": "pfq-section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "FAQ Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "QUESTIONS? WE'RE HERE TO HELP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "header", "content": "Help Center Link" },
    { "type": "text",    "id": "help_text",      "label": "Text before link", "default": "Can't find what you're looking for? Visit our" },
    { "type": "text",    "id": "help_link_text",  "label": "Link text",        "default": "Help Center" },
    { "type": "url",     "id": "help_link",        "label": "Help Center URL" },
    { "type": "header", "content": "Support Card" },
    { "type": "textarea","id": "support_title",   "label": "Card title",       "default": "Need Help?\nWe're here for you." },
    { "type": "header", "content": "Support Item 1" },
    { "type": "text", "id": "support_1_title", "label": "Title", "default": "Real People" },
    { "type": "text", "id": "support_1_desc",  "label": "Description", "default": "Friendly support" },
    { "type": "header", "content": "Support Item 2" },
    { "type": "text", "id": "support_2_title", "label": "Title", "default": "Fast Response" },
    { "type": "text", "id": "support_2_desc",  "label": "Description", "default": "We reply quickly" },
    { "type": "header", "content": "Support Item 3" },
    { "type": "text", "id": "support_3_title", "label": "Title", "default": "Expert Advice" },
    { "type": "text", "id": "support_3_desc",  "label": "Description", "default": "We know dogs" },
    { "type": "header", "content": "Support Item 4" },
    { "type": "text", "id": "support_4_title", "label": "Title", "default": "30-Day Returns" },
    { "type": "text", "id": "support_4_desc",  "label": "Description", "default": "No hassle" },
    { "type": "header", "content": "CTA Button" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Contact Support" },
    { "type": "url",  "id": "cta_link", "label": "Button URL" },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "help@pawvoyage.com" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question", "default": "What is your question?" },
        { "type": "textarea", "id": "answer",   "label": "Answer",   "default": "Your answer goes here." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ + Support",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How does the no-pull front clip work?",
            "answer": "The front clip attaches at the chest and gently redirects your dog back toward you when they pull forward. This discourages pulling behavior over time without discomfort."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is the harness comfortable for all-day wear?",
            "answer": "Yes. The padded chest plate and breathable mesh materials make it suitable for extended wear. It is designed to distribute pressure evenly so your dog stays comfortable throughout the day."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "Measure your dog's chest girth (just behind the front legs) and neck base, then compare with our size chart. When between sizes, we recommend choosing the larger size for a comfortable fit."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I use it for training?",
            "answer": "Absolutely. The front clip and top handle make it ideal for training sessions. The top handle gives you extra control in crowded areas, while the front clip reinforces positive behavior."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is it safe for small dogs?",
            "answer": "Yes. The adjustable straps and secure quick-release buckles ensure a snug, safe fit for smaller breeds. Always check the fit before each walk."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean the harness?",
            "answer": "Hand wash with mild soap and cold water, then air dry completely before the next use. Do not machine wash or tumble dry, as this may damage the buckles and webbing."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "page"]
  }
}
{% endschema %}
