{%- style -%}
/* ══ PawVoyage Comparison Table — fully scoped ══ */
#pvct-{{ section.id }} {
  background: #FAF7F0;
  padding: 72px 2rem;
  font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  overflow: hidden;
}
@media(max-width:749px){ #pvct-{{ section.id }} { padding: 30px 0; } }

#pvct-{{ section.id }} .pvct-outer {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 4rem;
  padding: 0 2rem;
}

/* ── Header (centered above table) ── */
#pvct-{{ section.id }} .pvct-intro {
  text-align: center;
}
#pvct-{{ section.id }} .pvct-eyebrow {
  display: inline-block;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: #D4A843;
  margin-bottom: 1.2rem;
}
#pvct-{{ section.id }} .pvct-heading {
  font-size: clamp(3.2rem, 5vw, 5.6rem);
  font-weight: 900;
  color: #133316;
  line-height: 1.08;
  letter-spacing: -.025em;
  margin: 0 0 1.6rem;
}
#pvct-{{ section.id }} .pvct-sub {
  font-size: 1.7rem;
  color: #4A5748;
  line-height: 1.65;
  margin: 0 auto 2rem;
  max-width: 640px;
}
#pvct-{{ section.id }} .pvct-seo-body {
  font-size: 1.5rem;
  color: #6B7568;
  line-height: 1.7;
  max-width: 700px;
  margin: 0 auto;
}

#pvct-{{ section.id }} .pvct-feat-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.3rem 0;
  border-top: 1px solid rgba(19,51,22,.08);
}
#pvct-{{ section.id }} .pvct-feat-item:last-child { border-bottom: 1px solid rgba(19,51,22,.08); }
#pvct-{{ section.id }} .pvct-feat-icon {
  width: 34px; height: 34px;
  background: rgba(19,51,22,.07);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}
#pvct-{{ section.id }} .pvct-feat-icon svg { width:16px; height:16px; stroke:#133316; stroke-width:1.8; }
#pvct-{{ section.id }} .pvct-feat-title { font-size: 1.5rem; font-weight: 700; color: #133316; margin: 0 0 .2rem; }
#pvct-{{ section.id }} .pvct-feat-desc  { font-size: 1.3rem; color: #6B7568; margin: 0; line-height: 1.4; }

/* ── Table scroll wrapper ── */
#pvct-{{ section.id }} .pvct-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border-radius: 20px;
  padding-top: 2rem;
  margin-top: -2rem;
  padding-bottom: 1rem;
}
@media(max-width:899px){
  #pvct-{{ section.id }} .pvct-outer {
    padding: 0 1.6rem;
  }
  #pvct-{{ section.id }} .pvct-img-zoom {
    display: none !important;
  }
  #pvct-{{ section.id }} .pvct-col-img-wrap {
    pointer-events: none;
  }
}

/* ── Table grid ── */
#pvct-{{ section.id }} .pvct-table {
  min-width: 780px;
  border-radius: 20px;
  box-shadow: 0 8px 36px rgba(19,51,22,.09);
  background: #fff;
  border: 1px solid rgba(19,51,22,.09);
}
#pvct-{{ section.id }} .pvct-head-cell:first-child { border-top-left-radius: 19px; }
#pvct-{{ section.id }} .pvct-head-cell:last-child { border-top-right-radius: 19px; }
#pvct-{{ section.id }} .pvct-row:last-child > div:first-child { border-bottom-left-radius: 19px; }
#pvct-{{ section.id }} .pvct-row:last-child > div:last-child { border-bottom-right-radius: 19px; }

/* Column grid inside table: [features] [pv] [trad] [basic] */
#pvct-{{ section.id }} .pvct-row {
  display: grid;
  grid-template-columns: 34% 22% 22% 22%;
  border-bottom: 1px solid rgba(19,51,22,.07);
}
#pvct-{{ section.id }} .pvct-row:last-child { border-bottom: none; }

/* ── Header row ── */
#pvct-{{ section.id }} .pvct-head { align-items: stretch; }
#pvct-{{ section.id }} .pvct-head-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 2rem 1rem 1.4rem;
  text-align: center;
  background: #FAF7F0;
  gap: .9rem;
}
#pvct-{{ section.id }} .pvct-head-cell.pvct-pv-col {
  background: #133316;
  position: relative;
  border-top-left-radius: 18px;
  border-top-right-radius: 18px;
  box-shadow: 0 -8px 24px rgba(212, 168, 67, 0.12), inset 0 2px 0 rgba(212, 168, 67, 0.4), inset 2px 0 0 rgba(212, 168, 67, 0.4), inset -2px 0 0 rgba(212, 168, 67, 0.4);
  z-index: 2;
}

/* ── Best Badge ── */
#pvct-{{ section.id }} .pvct-best-badge {
  background: #D4A843;
  color: #133316;
  font-size: 1.1rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 0.4rem 1.4rem;
  border-radius: 999px;
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(212, 168, 67, 0.3);
}

/* ── Images & Zoom ── */
#pvct-{{ section.id }} .pvct-col-img-wrap {
  position: relative;
  width: 90px; height: 90px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  border-radius: 12px;
  transition: background 0.3s ease;
}
#pvct-{{ section.id }} .pvct-col-img-wrap:hover,
#pvct-{{ section.id }} .pvct-col-img-wrap:focus {
  background: rgba(19,51,22,0.04);
  outline: none;
}
#pvct-{{ section.id }} .pvct-pv-col .pvct-col-img-wrap:hover,
#pvct-{{ section.id }} .pvct-pv-col .pvct-col-img-wrap:focus {
  background: rgba(255,255,255,0.08);
}

#pvct-{{ section.id }} .pvct-col-img {
  width: 100%; height: 100%;
  object-fit: contain;
  border-radius: 10px;
  background: rgba(19,51,22,0.06);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
}
#pvct-{{ section.id }} .pvct-pv-col .pvct-col-img {
  background: transparent;
  /* Glow, brighter, contrast */
  filter: drop-shadow(0 0 16px rgba(212, 168, 67, 0.3)) brightness(1.2) contrast(1.1);
}
#pvct-{{ section.id }} .pvct-col-img-wrap--pv {
  background: radial-gradient(circle, rgba(212,168,67,0.18) 0%, rgba(212,168,67,0) 65%);
}

#pvct-{{ section.id }} .pvct-col-img-wrap:hover .pvct-col-img,
#pvct-{{ section.id }} .pvct-col-img-wrap:focus .pvct-col-img {
  transform: scale(1.08);
  box-shadow: 0 8px 24px rgba(19,51,22,0.12);
}

/* ── Zoom Preview Modal ── */
#pvct-{{ section.id }} .pvct-img-zoom {
  position: absolute;
  top: 50%;
  left: calc(100% + 14px);
  transform: translateY(-50%) scale(0.9);
  width: 220px; height: 220px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 20px 48px rgba(19,51,22,0.18), 0 0 0 1px rgba(19,51,22,0.06);
  padding: 12px;
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
}
#pvct-{{ section.id }} .pvct-img-zoom--left {
  left: auto;
  right: calc(100% + 14px);
}
#pvct-{{ section.id }} .pvct-col-img-wrap:hover .pvct-img-zoom,
#pvct-{{ section.id }} .pvct-col-img-wrap:focus .pvct-img-zoom {
  opacity: 1;
  visibility: visible;
  transform: translateY(-50%) scale(1);
}
#pvct-{{ section.id }} .pvct-img-zoom img {
  width: 100%; height: 100%;
  object-fit: contain;
  border-radius: 8px;
}

#pvct-{{ section.id }} .pvct-col-img-ph {
  width: 80px; height: 80px;
  border-radius: 10px;
  background: rgba(19,51,22,.08);
  display: flex; align-items: center; justify-content: center;
}
#pvct-{{ section.id }} .pvct-col-img-ph svg { width:28px; height:28px; stroke:#8A9486; }

#pvct-{{ section.id }} .pvct-col-title {
  font-size: 1.45rem;
  font-weight: 800;
  line-height: 1.3;
  color: #133316;
  margin: 0;
}
#pvct-{{ section.id }} .pvct-pv-col .pvct-col-title { color: #fff; }

#pvct-{{ section.id }} .pvct-pv-microcopy {
  font-size: 1.2rem;
  color: rgba(255,255,255,0.75);
  margin: 0.4rem 0 0;
  line-height: 1.35;
  font-weight: 500;
}

/* ── Data rows ── */
#pvct-{{ section.id }} .pvct-feat-col {
  padding: 1.4rem 1.6rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: #FAF7F0;
}
#pvct-{{ section.id }} .pvct-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  padding: 1.4rem .8rem;
  font-size: 1.4rem;
  font-weight: 700;
}
/* PawVoyage column highlight */
#pvct-{{ section.id }} .pvct-cell.pvct-pv-col {
  background: rgba(19,51,22,.03);
  position: relative;
  z-index: 2;
  box-shadow: inset 2px 0 0 rgba(212, 168, 67, 0.4), inset -2px 0 0 rgba(212, 168, 67, 0.4);
}
#pvct-{{ section.id }} .pvct-row:last-child .pvct-cell.pvct-pv-col {
  border-bottom-left-radius: 18px;
  border-bottom-right-radius: 18px;
  box-shadow: inset 0 -2px 0 rgba(212, 168, 67, 0.4), inset 2px 0 0 rgba(212, 168, 67, 0.4), inset -2px 0 0 rgba(212, 168, 67, 0.4);
}

/* ── Status indicators ── */
#pvct-{{ section.id }} .pvct-status {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  font-size: 1.4rem;
  font-weight: 700;
  white-space: nowrap;
}
#pvct-{{ section.id }} .pvct-status-icon {
  width: 20px; height: 20px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
/* Yes — green */
#pvct-{{ section.id }} .pvct-yes .pvct-status-icon { background: #133316; }
#pvct-{{ section.id }} .pvct-yes .pvct-status-icon svg { stroke: #fff; }
#pvct-{{ section.id }} .pvct-yes .pvct-status-text { color: #133316; }
/* No — red */
#pvct-{{ section.id }} .pvct-no .pvct-status-icon { background: transparent; border: 1.5px solid #C84B31; }
#pvct-{{ section.id }} .pvct-no .pvct-status-icon svg { stroke: #C84B31; }
#pvct-{{ section.id }} .pvct-no .pvct-status-text { color: #C84B31; }
/* Limited/orange */
#pvct-{{ section.id }} .pvct-limited .pvct-status-icon { background: transparent; border: 1.5px solid #D4A843; }
#pvct-{{ section.id }} .pvct-limited .pvct-status-icon svg { stroke: #D4A843; }
#pvct-{{ section.id }} .pvct-limited .pvct-status-text { color: #9B7928; }

#pvct-{{ section.id }} .pvct-status-icon svg { width:11px; height:11px; stroke-width:2.8; }

/* ── Mobile Redesign ── */
@media (max-width: 749px) {
  #pvct-{{ section.id }} .pvct-table-wrap {
    display: none;
  }
  #pvct-{{ section.id }} {
    padding: 44px 16px;
  }
  #pvct-{{ section.id }} .pvct-outer {
    padding: 0;
    gap: 0;
  }
  #pvct-{{ section.id }} .pvct-intro {
    margin-bottom: 24px;
  }
  #pvct-{{ section.id }} .pvct-heading {
    font-size: clamp(30px, 8vw, 42px);
    line-height: 1.05;
  }
  #pvct-{{ section.id }} .pvct-sub {
    font-size: 15px;
    line-height: 1.45;
    max-width: 320px;
    margin: 10px auto 0;
  }
  
  .pv-compare__mobile {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pv-compare__best-card {
    position: relative;
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 14px;
    align-items: center;
    padding: 14px;
    border-radius: 20px;
    background: #12350E;
    color: #FFF7EA;
    box-shadow: 0 14px 34px rgba(7,31,6,.16);
    margin-bottom: 8px;
  }
  .pv-compare__best-badge {
    position: absolute;
    top: -12px;
    right: 14px;
    background: #D99A2B;
    color: #12350E;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: .04em;
    box-shadow: 0 4px 12px rgba(212, 168, 67, 0.3);
  }
  .pv-compare__best-image {
    width: 84px;
    height: 84px;
    border-radius: 14px;
    object-fit: contain;
    background: rgba(255,255,255,.12);
  }
  .pv-compare__best-title {
    font-size: 16px;
    font-weight: 800;
    margin: 0 0 4px;
    color: #FFF7EA;
  }
  .pv-compare__best-desc {
    font-size: 13px;
    color: rgba(255,247,234,0.8);
    margin: 0;
    line-height: 1.4;
  }
  .pv-compare__feature-card {
    background: #FFFFFF;
    border: 1px solid rgba(31,36,29,.12);
    border-radius: 20px;
    padding: 18px 16px;
    box-shadow: 0 10px 26px rgba(7,31,6,.07);
  }
  .pv-compare__feature-head {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 12px;
    align-items: start;
    margin-bottom: 16px;
  }
  .pv-compare__feature-icon {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #F3EFE5;
    color: #12350E;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pv-compare__feature-icon svg {
    width: 20px;
    height: 20px;
    stroke: #12350E;
    fill: none;
    stroke-width: 1.8;
  }
  .pv-compare__feature-title {
    font-size: 17px;
    line-height: 1.25;
    font-weight: 900;
    color: #12350E;
    margin: 0;
  }
  .pv-compare__feature-desc {
    font-size: 13px;
    color: #6F7568;
    margin: 4px 0 0;
  }
  .pv-compare__rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pv-compare__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 46px;
    padding: 10px 14px;
    border-radius: 12px;
    background: #FAF3E7;
    font-size: 14px;
    color: #1F241D;
  }
  .pv-compare__row-label {
    font-weight: 500;
  }
  .pv-compare__row--winner {
    background: rgba(18,53,14,.09);
    border: 1px solid rgba(18,53,14,.18);
    color: #12350E;
  }
  .pv-compare__row--winner .pv-compare__row-label {
    font-weight: 800;
  }
  .pv-compare__val {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
  }
  .pv-compare__value--yes { color: #12350E; }
  .pv-compare__value--no { color: #C9483A; }
  .pv-compare__value--limited { color: #B87918; }
  .pv-compare__value--sometimes { color: #B87918; }
  .pv-compare__value--average { color: #B87918; }
  .pv-compare__value--some { color: #B87918; }
  .pv-compare__value--minimal { color: #B87918; }
  
  .pv-compare__val-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pv-compare__val-icon svg { width: 14px; height: 14px; stroke-width: 2.5; stroke: currentColor; fill: none; }
  
  .pv-compare__cta-card {
    background: #12350E;
    border-radius: 20px;
    padding: 28px 24px;
    text-align: center;
    margin-top: 12px;
  }
  .pv-compare__cta-heading {
    font-size: 24px;
    font-weight: 900;
    color: #FFF7EA;
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .pv-compare__cta-text {
    font-size: 15px;
    color: rgba(255,247,234,0.85);
    margin: 0 0 20px;
    line-height: 1.5;
  }
  .pv-compare__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: #D99A2B;
    color: #12350E;
    font-size: 16px;
    font-weight: 800;
    padding: 16px 24px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(217,154,43,0.3);
  }
}

@media (min-width: 750px) {
  .pv-compare__mobile {
    display: none;
  }
}
{%- endstyle -%}

{%- liquid
  assign pv_img   = section.settings.pawvoyage_image
  assign tr_img   = section.settings.traditional_image
  assign ba_img   = section.settings.basic_image
-%}

<!-- ===== COMPARISON TABLE SECTION ===== -->
<section id="pvct-{{ section.id }}" aria-labelledby="pvct-heading-{{ section.id }}">
<div class="pvct-outer">

  <!-- ══ LEFT INTRO ══ -->
  <div class="pvct-intro">
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="pvct-eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}
    <h2 class="pvct-heading" id="pvct-heading-{{ section.id }}">{{ section.settings.heading | default: 'PawVoyage vs. The Rest' | newline_to_br }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="pvct-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.seo_body != blank -%}
      <p class="pvct-seo-body">{{ section.settings.seo_body }}</p>
    {%- endif -%}

  </div><!-- /pvct-intro -->

  <!-- ══ RIGHT TABLE (desktop) ══ -->
  <div class="pvct-table-wrap">
    <div class="pvct-scroll">
      <div class="pvct-table" role="table" aria-label="Product comparison">

        <!-- Header row -->
        <div class="pvct-row pvct-head" role="row">
          <!-- empty feature cell -->
          <div class="pvct-head-cell pvct-head-empty" role="columnheader"></div>

          <!-- PawVoyage -->
          <div class="pvct-head-cell pvct-pv-col" role="columnheader">
            <div class="pvct-best-badge">Best Choice</div>
            <div class="pvct-col-img-wrap pvct-col-img-wrap--pv" tabindex="0" role="button" aria-haspopup="true">
              {%- if pv_img != blank -%}
                <img class="pvct-col-img pvct-col-img--pv" src="{{ pv_img | image_url: width: 200 }}" alt="{{ section.settings.pawvoyage_image_alt | default: 'PawVoyage No-Pull Harness' | escape }}" width="80" height="80" loading="lazy">
                <div class="pvct-img-zoom">
                  <img src="{{ pv_img | image_url: width: 480 }}" alt="{{ section.settings.pawvoyage_image_alt | default: 'PawVoyage No-Pull Harness' | escape }}" width="240" height="240" loading="lazy">
                </div>
              {%- else -%}
                <div class="pvct-col-img-ph"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
              {%- endif -%}
            </div>
            <p class="pvct-col-title">{{ section.settings.pawvoyage_col_title | default: 'PawVoyage No-Pull Harness' }}</p>
          </div>

          <!-- Traditional -->
          <div class="pvct-head-cell" role="columnheader">
            <div class="pvct-col-img-wrap" tabindex="0" role="button" aria-haspopup="true">
              {%- if tr_img != blank -%}
                <img class="pvct-col-img" src="{{ tr_img | image_url: width: 200 }}" alt="{{ section.settings.traditional_image_alt | default: 'Traditional Harness' | escape }}" width="80" height="80" loading="lazy">
                <div class="pvct-img-zoom">
                  <img src="{{ tr_img | image_url: width: 480 }}" alt="{{ section.settings.traditional_image_alt | default: 'Traditional Harness' | escape }}" width="240" height="240" loading="lazy">
                </div>
              {%- else -%}
                <div class="pvct-col-img-ph"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
              {%- endif -%}
            </div>
            <p class="pvct-col-title">{{ section.settings.traditional_col_title | default: 'Traditional Harness' }}</p>
          </div>

          <!-- Basic -->
          <div class="pvct-head-cell" role="columnheader">
            <div class="pvct-col-img-wrap" tabindex="0" role="button" aria-haspopup="true">
              {%- if ba_img != blank -%}
                <img class="pvct-col-img" src="{{ ba_img | image_url: width: 200 }}" alt="{{ section.settings.basic_image_alt | default: 'Basic No-Pull Harness' | escape }}" width="80" height="80" loading="lazy">
                <div class="pvct-img-zoom pvct-img-zoom--left">
                  <img src="{{ ba_img | image_url: width: 480 }}" alt="{{ section.settings.basic_image_alt | default: 'Basic No-Pull Harness' | escape }}" width="240" height="240" loading="lazy">
                </div>
              {%- else -%}
                <div class="pvct-col-img-ph"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
              {%- endif -%}
            </div>
            <p class="pvct-col-title">{{ section.settings.basic_col_title | default: 'Basic No-Pull Harness' }}</p>
          </div>
        </div><!-- /header row -->

        <!-- Data rows -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'comparison_row' -%}
          {%- liquid
            assign pv_st  = block.settings.pawvoyage_status  | default: 'yes'
            assign tr_st  = block.settings.traditional_status | default: 'no'
            assign ba_st  = block.settings.basic_status       | default: 'no'
            assign pv_val = block.settings.pawvoyage_value    | default: 'Yes'
            assign tr_val = block.settings.traditional_value  | default: 'No'
            assign ba_val = block.settings.basic_value        | default: 'No'
          -%}
          <div class="pvct-row" role="row" {{ block.shopify_attributes }}>

            <!-- Feature label -->
            <div class="pvct-feat-col" role="rowheader">
              <div class="pvct-feat-item" style="border:none;padding:.3rem 0;">
                <div class="pvct-feat-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'comfort' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                    {%- when 'sliders' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                    {%- when 'handle' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                    {%- when 'diamond' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
                    {%- when 'moon' -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- endcase -%}
                </div>
                <div>
                  <p class="pvct-feat-title">{{ block.settings.feature_title }}</p>
                  {%- if block.settings.feature_description != blank -%}
                    <p class="pvct-feat-desc">{{ block.settings.feature_description }}</p>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- PawVoyage cell -->
            <div class="pvct-cell pvct-pv-col" role="cell">
              <span class="pvct-status pvct-{{ pv_st }}">
                <span class="pvct-status-icon">
                  {%- if pv_st == 'yes' -%}<svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif pv_st == 'no' -%}<svg viewBox="0 0 24 24" fill="none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke-width="2"/></svg>
                  {%- endif -%}
                </span>
                <span class="pvct-status-text">{{ pv_val }}</span>
              </span>
            </div>

            <!-- Traditional cell -->
            <div class="pvct-cell" role="cell">
              <span class="pvct-status pvct-{{ tr_st }}">
                <span class="pvct-status-icon">
                  {%- if tr_st == 'yes' -%}<svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif tr_st == 'no' -%}<svg viewBox="0 0 24 24" fill="none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke-width="2"/></svg>
                  {%- endif -%}
                </span>
                <span class="pvct-status-text">{{ tr_val }}</span>
              </span>
            </div>

            <!-- Basic cell -->
            <div class="pvct-cell" role="cell">
              <span class="pvct-status pvct-{{ ba_st }}">
                <span class="pvct-status-icon">
                  {%- if ba_st == 'yes' -%}<svg viewBox="0 0 24 24" fill="none"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif ba_st == 'no' -%}<svg viewBox="0 0 24 24" fill="none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" stroke-width="2"/></svg>
                  {%- endif -%}
                </span>
                <span class="pvct-status-text">{{ ba_val }}</span>
              </span>
            </div>

          </div><!-- /pvct-row -->
          {%- endif -%}
        {%- endfor -%}

      </div><!-- /pvct-table -->
    </div><!-- /pvct-scroll -->
  </div><!-- /pvct-table-wrap -->

  <!-- ══ MOBILE STACKED CARDS ══ -->
  <div class="pv-compare__mobile">
    <!-- Best Choice Card -->
    <div class="pv-compare__best-card">
      <div class="pv-compare__best-badge">BEST CHOICE</div>
      {%- if pv_img != blank -%}
        <img class="pv-compare__best-image" src="{{ pv_img | image_url: width: 200 }}" alt="{{ section.settings.pawvoyage_col_title | escape }}" loading="lazy" width="84" height="84">
      {%- else -%}
        <div class="pv-compare__best-image" style="display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.12);"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" style="width:32px;height:32px;"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
      {%- endif -%}
      <div>
        <h3 class="pv-compare__best-title">{{ section.settings.pawvoyage_col_title | default: 'PawVoyage No-Pull Harness' }}</h3>
        <p class="pv-compare__best-desc">Built for control, comfort, and adventure.</p>
      </div>
    </div>

    <!-- Feature Cards -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'comparison_row' -%}
        {%- liquid
          assign pv_st  = block.settings.pawvoyage_status  | default: 'yes'
          assign tr_st  = block.settings.traditional_status | default: 'no'
          assign ba_st  = block.settings.basic_status       | default: 'no'
          assign pv_val = block.settings.pawvoyage_value    | default: 'Yes'
          assign tr_val = block.settings.traditional_value  | default: 'No'
          assign ba_val = block.settings.basic_value        | default: 'No'
        -%}
        <div class="pv-compare__feature-card" {{ block.shopify_attributes }}>
          <div class="pv-compare__feature-head">
            <div class="pv-compare__feature-icon">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'comfort' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                {%- when 'sliders' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                {%- when 'handle' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                {%- when 'diamond' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/><line x1="12" y1="22" x2="12" y2="15.5"/><polyline points="22 8.5 12 15.5 2 8.5"/></svg>
                {%- when 'moon' -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              {%- endcase -%}
            </div>
            <div>
              <h4 class="pv-compare__feature-title">{{ block.settings.feature_title }}</h4>
              {%- if block.settings.feature_description != blank -%}
                <p class="pv-compare__feature-desc">{{ block.settings.feature_description }}</p>
              {%- endif -%}
            </div>
          </div>
          <div class="pv-compare__rows">
            <div class="pv-compare__row pv-compare__row--winner">
              <span class="pv-compare__row-label">{{ section.settings.pawvoyage_col_title | default: 'PawVoyage No-Pull Harness' | split: ' ' | first }}</span>
              <span class="pv-compare__val pv-compare__value--{{ pv_st }}">
                <span class="pv-compare__val-icon">
                  {%- if pv_st == 'yes' -%}<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif pv_st == 'no' -%}<svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/></svg>{%- endif -%}
                </span>
                {{ pv_val }}
              </span>
            </div>
            <div class="pv-compare__row">
              <span class="pv-compare__row-label">{{ section.settings.traditional_col_title | default: 'Traditional Harness' }}</span>
              <span class="pv-compare__val pv-compare__value--{{ tr_st }}">
                <span class="pv-compare__val-icon">
                  {%- if tr_st == 'yes' -%}<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif tr_st == 'no' -%}<svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/></svg>{%- endif -%}
                </span>
                {{ tr_val }}
              </span>
            </div>
            <div class="pv-compare__row">
              <span class="pv-compare__row-label">{{ section.settings.basic_col_title | default: 'Basic No-Pull' | remove: ' Harness' }}</span>
              <span class="pv-compare__val pv-compare__value--{{ ba_st }}">
                <span class="pv-compare__val-icon">
                  {%- if ba_st == 'yes' -%}<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- elsif ba_st == 'no' -%}<svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/></svg>{%- endif -%}
                </span>
                {{ ba_val }}
              </span>
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <!-- Mobile CTA -->
    <div class="pv-compare__cta-card">
      <h3 class="pv-compare__cta-heading">{{ section.settings.cta_heading | default: 'Ready for calmer walks?' }}</h3>
      <p class="pv-compare__cta-text">{{ section.settings.cta_text | default: 'Choose the harness built for control, comfort, and everyday adventures.' }}</p>
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="pv-compare__cta-btn">
        {{ section.settings.cta_label | default: 'Shop PawVoyage Harness' }}
      </a>
    </div>
  </div><!-- /pv-compare__mobile -->

</div><!-- /pvct-outer -->
</section>

{% schema %}
{
  "name": "PV Comparison Table",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header","footer"] },
  "settings": [
    { "type": "text",     "id": "eyebrow_text", "label": "Eyebrow", "default": "DESIGNED DIFFERENT. BUILT BETTER." },
    { "type": "textarea", "id": "heading",      "label": "Heading",  "default": "PawVoyage vs.\nThe Rest" },
    { "type": "textarea", "id": "subheading",   "label": "Subheading", "default": "See why dog owners choose the tactical no-pull harness that actually works." },
    { "type": "textarea", "id": "seo_body", "label": "SEO Body Text", "info": "Optional paragraph below the subheading. Use natural keyword-rich language for SEO." },

    { "type": "header", "content": "Column Titles" },
    { "type": "text", "id": "pawvoyage_col_title",   "label": "PawVoyage column title",   "default": "PawVoyage No-Pull Harness" },
    { "type": "text", "id": "traditional_col_title", "label": "Traditional column title", "default": "Traditional Harness" },
    { "type": "text", "id": "basic_col_title",       "label": "Basic column title",       "default": "Basic No-Pull Harness" },

    { "type": "header", "content": "Column Images" },
    { "type": "image_picker", "id": "pawvoyage_image",   "label": "PawVoyage product image",   "info": "Recommended: 200x200px, transparent PNG." },
    { "type": "text",         "id": "pawvoyage_image_alt","label": "PawVoyage image alt",       "default": "PawVoyage No-Pull Harness" },
    { "type": "image_picker", "id": "traditional_image",  "label": "Traditional harness image", "info": "Recommended: 200x200px." },
    { "type": "text",         "id": "traditional_image_alt","label": "Traditional image alt",   "default": "Traditional Harness" },
    { "type": "image_picker", "id": "basic_image",        "label": "Basic no-pull image",       "info": "Recommended: 200x200px." },
    { "type": "text",         "id": "basic_image_alt",    "label": "Basic image alt",           "default": "Basic No-Pull Harness" },
    { "type": "header", "content": "Mobile CTA" },
    { "type": "text", "id": "cta_heading", "label": "CTA Heading", "default": "Ready for calmer walks?" },
    { "type": "text", "id": "cta_text", "label": "CTA Text", "default": "Choose the harness built for control, comfort, and everyday adventures." },
    { "type": "text", "id": "cta_label", "label": "CTA Button Label", "default": "Shop PawVoyage Harness" },
    { "type": "url", "id": "cta_link", "label": "CTA Button Link" }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield",   "label": "Shield" },
            { "value": "comfort",  "label": "Comfort / Padding" },
            { "value": "sliders",  "label": "Sliders / Adjustable" },
            { "value": "handle",   "label": "Handle / Coffee Cup" },
            { "value": "diamond",  "label": "Diamond / Durable" },
            { "value": "moon",     "label": "Moon / Reflective" },
            { "value": "check",    "label": "Checkmark" }
          ],
          "default": "shield"
        },
        { "type": "text",     "id": "feature_title",       "label": "Feature title",       "default": "Feature Name" },
        { "type": "text",     "id": "feature_description", "label": "Feature description", "default": "Brief description" },
        {
          "type": "select", "id": "pawvoyage_status", "label": "PawVoyage status",
          "options": [
            { "value": "yes",       "label": "Yes (green check)" },
            { "value": "no",        "label": "No (red X)" },
            { "value": "limited",   "label": "Limited (orange)" },
            { "value": "sometimes", "label": "Sometimes (orange)" },
            { "value": "average",   "label": "Average (orange)" },
            { "value": "some",      "label": "Some (orange)" },
            { "value": "minimal",   "label": "Minimal (orange)" }
          ],
          "default": "yes"
        },
        { "type": "text", "id": "pawvoyage_value", "label": "PawVoyage display text", "default": "Yes" },
        {
          "type": "select", "id": "traditional_status", "label": "Traditional status",
          "options": [
            { "value": "yes",       "label": "Yes (green check)" },
            { "value": "no",        "label": "No (red X)" },
            { "value": "limited",   "label": "Limited (orange)" },
            { "value": "sometimes", "label": "Sometimes (orange)" },
            { "value": "average",   "label": "Average (orange)" },
            { "value": "some",      "label": "Some (orange)" },
            { "value": "minimal",   "label": "Minimal (orange)" }
          ],
          "default": "no"
        },
        { "type": "text", "id": "traditional_value", "label": "Traditional display text", "default": "No" },
        {
          "type": "select", "id": "basic_status", "label": "Basic status",
          "options": [
            { "value": "yes",       "label": "Yes (green check)" },
            { "value": "no",        "label": "No (red X)" },
            { "value": "limited",   "label": "Limited (orange)" },
            { "value": "sometimes", "label": "Sometimes (orange)" },
            { "value": "average",   "label": "Average (orange)" },
            { "value": "some",      "label": "Some (orange)" },
            { "value": "minimal",   "label": "Minimal (orange)" }
          ],
          "default": "no"
        },
        { "type": "text", "id": "basic_value", "label": "Basic display text", "default": "No" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PV Comparison Table",
      "settings": {
        "eyebrow_text": "DESIGNED DIFFERENT. BUILT BETTER.",
        "heading": "PawVoyage vs.\nThe Rest",
        "subheading": "See why dog owners choose the tactical no-pull harness that actually works.",
        "pawvoyage_col_title": "PawVoyage No-Pull Harness",
        "traditional_col_title": "Traditional Harness",
        "basic_col_title": "Basic No-Pull Harness"
      },
      "blocks": [
        { "type": "comparison_row", "settings": { "icon": "shield",   "feature_title": "No-Pull Front Clip",       "feature_description": "Gently redirects pulling",         "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "no",        "traditional_value": "No",        "basic_status": "sometimes", "basic_value": "Sometimes" } },
        { "type": "comparison_row", "settings": { "icon": "comfort",  "feature_title": "Padded Chest Comfort",     "feature_description": "Soft padding prevents chafing",    "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "no",        "traditional_value": "No",        "basic_status": "minimal",   "basic_value": "Minimal"   } },
        { "type": "comparison_row", "settings": { "icon": "sliders",  "feature_title": "Adjustable 4-Point Fit",   "feature_description": "Perfect fit for more dogs",        "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "limited",   "traditional_value": "Limited",   "basic_status": "limited",   "basic_value": "Limited"   } },
        { "type": "comparison_row", "settings": { "icon": "handle",   "feature_title": "Top Handle",               "feature_description": "Extra control when needed",        "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "no",        "traditional_value": "No",        "basic_status": "no",        "basic_value": "No"        } },
        { "type": "comparison_row", "settings": { "icon": "diamond",  "feature_title": "Durable Tactical Build",   "feature_description": "Built for everyday adventure",     "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "average",   "traditional_value": "Average",   "basic_status": "no",        "basic_value": "No"        } },
        { "type": "comparison_row", "settings": { "icon": "moon",     "feature_title": "Reflective for Night Safety","feature_description": "Better visibility in low light", "pawvoyage_status": "yes", "pawvoyage_value": "Yes", "traditional_status": "some",      "traditional_value": "Some",      "basic_status": "no",        "basic_value": "No"        } }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
