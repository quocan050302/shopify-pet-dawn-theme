<section class="pv-measure-sec">
  <div class="page-width">
    <div class="pv-measure-inner">
      <h2 class="pv-section-title">How to Measure for the Perfect Fit</h2>
      <div class="pv-measure-steps">
        <div class="pv-step">
          <div class="pv-step-num">1</div>
          <p>Measure chest girth at the widest part</p>
        </div>
        <div class="pv-step">
          <div class="pv-step-num">2</div>
          <p>Check neck fit to ensure it's snug</p>
        </div>
        <div class="pv-step">
          <div class="pv-step-num">3</div>
          <p>Choose your size from our chart</p>
        </div>
        <div class="pv-step">
          <div class="pv-step-num">4</div>
          <p>Adjust the 4 straps for a secure fit</p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .pv-measure-sec { padding: 6rem 0; background: #12350E; color: #FFF7EA; text-align: center; }
  .pv-measure-sec .pv-section-title { font-size: clamp(2.4rem, 4vw, 3.6rem); font-weight: 800; color: #FFF7EA; margin: 0 0 4rem; }
  .pv-measure-steps { display: grid; grid-template-columns: 1fr; gap: 2.4rem; max-width: 90rem; margin: 0 auto; }
  @media screen and (min-width: 750px) { .pv-measure-steps { grid-template-columns: repeat(4, 1fr); gap: 4rem; } }
  .pv-step { display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
  .pv-step-num { width: 4.8rem; height: 4.8rem; border-radius: 50%; background: #D99A2B; color: #12350E; font-size: 2rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .pv-step p { font-size: 1.5rem; font-weight: 600; margin: 0; line-height: 1.5; color: #FFF7EA; }
</style>
{% schema %}
{ "name": "PV How to Measure", "presets": [{ "name": "PV How to Measure" }] }
{% endschema %}
