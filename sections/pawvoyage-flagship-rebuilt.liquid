    flex-wrap: wrap;
    align-items: center;
    gap: 2.4rem;
  }
  .pvfr-footer-trust-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: #5C6758;
    font-size: 1.35rem;
    font-weight: 500;
  }
  .pvfr-footer-trust-item svg {
    color: #133316;
    width: 20px; height: 20px;
  }
</style>

