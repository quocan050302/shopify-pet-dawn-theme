    { "type": "header", "content": "CTA Block" },
    { "type": "text",     "id": "cta_heading",   "label": "Heading",    "default": "Still have questions?" },
    { "type": "textarea", "id": "cta_text",      "label": "Body text",  "default": "Our support team is here to help you choose the right fit for your dog." },
    { "type": "text",     "id": "cta_btn_text",  "label": "Button label","default": "Contact Us" },
