    { "type": "header", "content": "Order Support FAQs" },
    { "type": "text",     "id": "os_q1", "label": "Q1", "default": "Can I change or cancel my order?" },
    { "type": "textarea", "id": "os_a1", "label": "A1", "default": "Orders can be changed or cancelled within 1 hour of placement. After that, they may already be in processing. Email us immediately at support@pawvoyage.com and we'll do our best to help." },
    { "type": "text",     "id": "os_q2", "label": "Q2", "default": "I entered the wrong shipping address. What should I do?" },
