    { "type": "header", "content": "Product & Sizing FAQs" },
    { "type": "text",     "id": "p_q1", "label": "Q1", "default": "How do I choose the right harness size?" },
    { "type": "textarea", "id": "p_a1", "label": "A1", "default": "Measure your dog's chest girth — the widest point behind the front legs. Compare to our size chart on the product page. When between sizes, we recommend sizing up for comfort." },
    { "type": "text",     "id": "p_q2", "label": "Q2", "default": "What if my dog is between sizes?" },
    { "type": "textarea", "id": "p_a2", "label": "A2", "default": "Always choose the larger size. The PawVoyage harness has multiple adjustment points so it can be tightened to fit snugly and safely." },
    { "type": "text",     "id": "p_q3", "label": "Q3", "default": "Is the PawVoyage harness adjustable?" },
    { "type": "textarea", "id": "p_a3", "label": "A3", "default": "Yes! Every harness features fully adjustable chest and belly straps for a secure, custom fit. It's designed to work for dogs with deep chests, slim waists, and everything in between." },
    { "type": "text",     "id": "p_q4", "label": "Q4", "default": "Is it suitable for dogs that pull?" },
    { "type": "textarea", "id": "p_a4", "label": "A4", "default": "Absolutely. The PawVoyage No-Pull Tactical Harness features a front clip attachment that redirects pulling behavior and helps you maintain calm, controlled walks." },
    { "type": "text",     "id": "p_q5", "label": "Q5", "default": "Is the harness comfortable for daily walks?" },
    { "type": "textarea", "id": "p_a5", "label": "A5", "default": "Yes. It's padded with soft mesh lining that prevents chafing, and the wide straps distribute pressure evenly — making it comfortable even on long daily walks." },
    { "type": "header", "content": "Shipping & Delivery FAQs" },
    { "type": "text",     "id": "s_q1", "label": "Q1", "default": "How long does shipping take?" },
    { "type": "textarea", "id": "s_a1", "label": "A1", "default": "Standard shipping within the US takes 5–7 business days. Expedited options (2–3 business days) are available at checkout." },
    { "type": "text",     "id": "s_q2", "label": "Q2", "default": "Do you offer free shipping?" },
    { "type": "textarea", "id": "s_a2", "label": "A2", "default": "Yes! We offer free standard shipping on all orders over $50 within the United States." },
    { "type": "text",     "id": "s_q3", "label": "Q3", "default": "Where do you ship?" },
    { "type": "textarea", "id": "s_a3", "label": "A3", "default": "We currently ship to all 50 US states. International shipping may be available — contact us for details." },
    { "type": "text",     "id": "s_q4", "label": "Q4", "default": "How can I track my order?" },
    { "type": "textarea", "id": "s_a4", "label": "A4", "default": "Once your order ships, you'll receive a confirmation email with a tracking number. You can use it on the carrier's website to see real-time delivery updates." },
    { "type": "header", "content": "Returns & Refunds FAQs" },
    { "type": "text",     "id": "r_q1", "label": "Q1", "default": "What is your return policy?" },
    { "type": "textarea", "id": "r_a1", "label": "A1", "default": "We accept returns within 30 days of delivery for unused items in original condition and packaging. See our full Return & Refund Policy for details." },
    { "type": "text",     "id": "r_q2", "label": "Q2", "default": "Can I exchange for a different size?" },
    { "type": "textarea", "id": "r_a2", "label": "A2", "default": "Yes! Email us at support@pawvoyage.com with your order number and desired size. We'll guide you through a hassle-free exchange within 30 days of purchase." },
