{{ 'pawvoyage-brand.css' | asset_url | stylesheet_tag }}

<section class="pv-compare section-{{ section.id }}" id="pv-compare-{{ section.id }}">
  <div class="page-width">
    
    <div class="pv-compare__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="pv-section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="pv-section-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="pv-section-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.pain_hook != blank -%}
        <div class="pv-compare__pain-hook">{{ section.settings.pain_hook }}</div>
      {%- endif -%}
    </div>

    <!-- Desktop Table -->
    <div class="pv-compare__table-wrap small-hide">
      <table class="pv-compare__table" role="table">
        <thead>
          <tr>
            <th class="pv-compare__th pv-compare__th--feature">Feature</th>
            <th class="pv-compare__th pv-compare__th--pv">
              {%- if section.settings.pv_badge != blank -%}
                <span class="pv-compare__badge">{{ section.settings.pv_badge }}</span>
              {%- endif -%}
              <span class="pv-compare__brand-logo"></span>
              {{ section.settings.col1_label | default: 'PawVoyage Harness' }}
            </th>
            <th class="pv-compare__th pv-compare__th--other">{{ section.settings.col2_label | default: 'Regular Harness' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <tr class="pv-compare__row" {{ block.shopify_attributes }}>
                <td class="pv-compare__td pv-compare__td--feature">{{ block.settings.feature }}</td>
                <td class="pv-compare__td pv-compare__td--pv">
                  <div class="pv-compare__td-content">
                    <span class="pv-compare__icon pv-compare__icon--check">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="12" fill="#2F681E"/><path d="M7 12.5l3.5 3.5 6.5-7" stroke="#FFF7EA" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="pv-compare__text">{{ block.settings.pv_benefit }}</span>
                  </div>
                </td>
                <td class="pv-compare__td pv-compare__td--other">
                  <div class="pv-compare__td-content">
                    <span class="pv-compare__icon pv-compare__icon--cross">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#D95C5C" fill-opacity="0.1"/><path d="M6.5 6.5l7 7M13.5 6.5l-7 7" stroke="#D95C5C" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <span class="pv-compare__text">{{ block.settings.other_limitation }}</span>
                  </div>
                </td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <!-- Mobile Stacked Cards -->
    <div class="pv-compare__mobile-wrap medium-hide large-up-hide">
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="pv-compare__mobile-card" {{ block.shopify_attributes }}>
            <h3 class="pv-compare__mobile-feature">{{ block.settings.feature }}</h3>
            <div class="pv-compare__mobile-row pv-compare__mobile-row--pv">
              <span class="pv-compare__icon pv-compare__icon--check">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#2F681E"/><path d="M6 10.5l3 3 5.5-6" stroke="#FFF7EA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="pv-compare__text"><strong>{{ section.settings.col1_label | default: 'PawVoyage' }}:</strong> {{ block.settings.pv_benefit }}</span>
            </div>
            <div class="pv-compare__mobile-row pv-compare__mobile-row--other">
              <span class="pv-compare__icon pv-compare__icon--cross">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="#D95C5C" fill-opacity="0.1"/><path d="M5.5 5.5l7 7M12.5 5.5l-7 7" stroke="#D95C5C" stroke-width="1.8" stroke-linecap="round"/></svg>
              </span>
              <span class="pv-compare__text"><strong>{{ section.settings.col2_label | default: 'Regular' }}:</strong> {{ block.settings.other_limitation }}</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Summary Card -->
    {%- if section.settings.summary_heading != blank -%}
      <div class="pv-compare__summary">
        <h3 class="pv-compare__summary-heading">{{ section.settings.summary_heading }}</h3>
        <p class="pv-compare__summary-body">{{ section.settings.summary_body }}</p>
        
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="pv-compare__summary-cta" id="pv-compare-cta-{{ section.id }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.cta_microcopy != blank -%}
          <p class="pv-compare__summary-micro">{{ section.settings.cta_microcopy }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .pv-compare { background: #FFF7EA; padding: 10rem 0; color: #1F241D; }
  .pv-compare__header { text-align: center; margin-bottom: 6rem; display: flex; flex-direction: column; align-items: center; }
  .pv-section-subheading { max-width: 68rem; margin: 0 auto 2.4rem; color: #4A5246; font-size: 1.6rem; line-height: 1.6; }
  .pv-compare__pain-hook { display: inline-block; background: rgba(217, 154, 43, 0.15); border: 1px solid rgba(217, 154, 43, 0.3); color: #B37A17; font-size: 1.4rem; font-weight: 600; font-style: italic; padding: 0.8rem 2rem; border-radius: 999px; }

  /* Desktop Table */
  .pv-compare__table-wrap { overflow-x: auto; margin-bottom: 6rem; padding-top: 2rem; }
  .pv-compare__table { width: 100%; border-collapse: separate; border-spacing: 0; min-width: 800px; background: white; border: 1px solid rgba(31,36,29,0.05); border-radius: 24px; box-shadow: 0 16px 48px rgba(31,36,29,0.06); }
  .pv-compare__th { padding: 3.2rem 2.4rem; text-align: center; font-size: 1.8rem; font-weight: 800; }
  .pv-compare__th--feature { text-align: left; color: #6D7569; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.12em; width: 25%; border-bottom: 1px solid rgba(31,36,29,0.08); border-top-left-radius: 24px; }
  .pv-compare__th--pv { position: relative; background: #12350E; color: #FFF7EA; width: 40%; border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom: 1px solid #1F4A16; box-shadow: 0 0 0 2px #D99A2B inset; }
  .pv-compare__th--other { color: #6D7569; width: 35%; background: #F9F5EF; border-bottom: 1px solid rgba(31,36,29,0.08); border-top-right-radius: 24px; }
  
  .pv-compare__badge { position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: #D99A2B; color: #FFF7EA; font-size: 1.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.6rem 1.6rem; border-radius: 999px; box-shadow: 0 4px 12px rgba(217,154,43,0.3); white-space: nowrap; }
  .pv-compare__brand-logo { display: block; font-size: 2.8rem; margin-bottom: 0.8rem; line-height: 1; }

  .pv-compare__row:hover .pv-compare__td { background: #FDFBF8; }
  .pv-compare__row:hover .pv-compare__td--pv { background: rgba(18,53,14,0.06); }
  
  .pv-compare__td { padding: 2.4rem; border-bottom: 1px solid rgba(31,36,29,0.06); transition: background 0.2s ease; vertical-align: top; }
  .pv-compare__td--feature { font-size: 1.6rem; font-weight: 700; color: #1F241D; }
  .pv-compare__td--pv { background: rgba(18,53,14,0.03); border-left: 2px solid #D99A2B; border-right: 2px solid #D99A2B; }
  .pv-compare__row:last-child .pv-compare__td--pv { border-bottom: 2px solid #D99A2B; border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; }
  .pv-compare__td--other { background: #F9F5EF; color: #6D7569; }

  .pv-compare__td-content { display: flex; gap: 1.6rem; align-items: flex-start; text-align: left; }
  .pv-compare__icon { flex-shrink: 0; display: inline-flex; margin-top: 0.2rem; }
  .pv-compare__text { font-size: 1.5rem; line-height: 1.5; font-weight: 500; }
  .pv-compare__td--pv .pv-compare__text { color: #12350E; font-weight: 600; }

  /* Mobile Stacked Cards */
  .pv-compare__mobile-wrap { display: flex; flex-direction: column; gap: 2rem; margin-bottom: 5rem; }
  .pv-compare__mobile-card { background: white; border: 1px solid rgba(31,36,29,0.08); border-radius: 16px; padding: 2.4rem; box-shadow: 0 8px 24px rgba(31,36,29,0.04); }
  .pv-compare__mobile-feature { font-size: 1.6rem; font-weight: 800; color: #1F241D; margin: 0 0 1.6rem; padding-bottom: 1.2rem; border-bottom: 1px solid rgba(31,36,29,0.06); }
  .pv-compare__mobile-row { display: flex; gap: 1.2rem; align-items: flex-start; margin-bottom: 1.6rem; font-size: 1.4rem; line-height: 1.5; }
  .pv-compare__mobile-row:last-child { margin-bottom: 0; }
  .pv-compare__mobile-row--pv { color: #12350E; background: rgba(18,53,14,0.04); padding: 1.2rem; border-radius: 8px; border-left: 3px solid #D99A2B; }
  .pv-compare__mobile-row--other { color: #6D7569; padding: 0 1.2rem; }

  /* Summary Card */
  .pv-compare__summary { background: #12350E; color: #FFF7EA; text-align: center; padding: 5rem 2.4rem; border-radius: 24px; max-width: 80rem; margin: 0 auto; box-shadow: 0 20px 48px rgba(18,53,14,0.25); position: relative; overflow: hidden; }
  .pv-compare__summary::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(217,154,43,0.1) 0%, rgba(217,154,43,0) 60%); pointer-events: none; }
  .pv-compare__summary-heading { font-size: clamp(2.4rem, 4vw, 3.2rem); font-weight: 800; margin: 0 0 1.6rem; color: #FFF7EA; position: relative; z-index: 1; }
  .pv-compare__summary-body { font-size: 1.6rem; line-height: 1.6; color: #E8D2A6; max-width: 56rem; margin: 0 auto 3.2rem; position: relative; z-index: 1; }
  .pv-compare__summary-cta { display: inline-flex; justify-content: center; background: #D99A2B; color: #12350E; font-size: 1.6rem; font-weight: 800; padding: 1.6rem 4rem; border-radius: 999px; text-decoration: none; transition: all 0.3s ease; position: relative; z-index: 1; box-shadow: 0 8px 24px rgba(217,154,43,0.4); }
  .pv-compare__summary-cta:hover { background: #EBBB4D; transform: translateY(-3px); box-shadow: 0 12px 32px rgba(217,154,43,0.5); text-decoration: none; color: #12350E; }
  .pv-compare__summary-micro { margin: 2rem 0 0; font-size: 1.3rem; color: rgba(255,247,234,0.6); font-weight: 600; position: relative; z-index: 1; }
</style>

{% schema %}
{
  "name": "PV Benefit Comparison",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See The Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why PawVoyage Makes Walks Feel Easier" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every detail is designed to help you guide your dog with more control, comfort, and confidence — from quick walks to outdoor adventures." },
    { "type": "text", "id": "pain_hook", "label": "Pain Hook", "default": "Because walks should feel calm, not like a tug-of-war." },
    { "type": "text", "id": "pv_badge", "label": "Column 1 Badge", "default": "Recommended for Better Walks" },
    { "type": "text", "id": "col1_label", "label": "Column 1 Title", "default": "PawVoyage Harness" },
    { "type": "text", "id": "col2_label", "label": "Column 2 Title", "default": "Regular Harness" },
    { "type": "header", "content": "Summary Card" },
    { "type": "text", "id": "summary_heading", "label": "Summary Heading", "default": "Ready to Upgrade Your Walks?" },
    { "type": "textarea", "id": "summary_body", "label": "Summary Body", "default": "Choose a harness designed for no-pull control, padded comfort, and everyday adventure." },
    { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Shop The Harness" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" },
    { "type": "text", "id": "cta_microcopy", "label": "CTA Microcopy", "default": "Secure checkout • Easy returns • Built for daily walks" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature name", "default": "Pulling Control" },
        { "type": "textarea", "id": "pv_benefit", "label": "PawVoyage Benefit", "default": "Front & back clip options help redirect pulling for calmer, more controlled walks." },
        { "type": "textarea", "id": "other_limitation", "label": "Regular Harness Limitation", "default": "Often gives less control when dogs pull hard." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PV Benefit Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Pulling Control", "pv_benefit": "Front & back clip options help redirect pulling for calmer, more controlled walks.", "other_limitation": "Often gives less control when dogs pull hard." } },
        { "type": "row", "settings": { "feature": "Neck & Chest Comfort", "pv_benefit": "Padded chest support helps reduce pressure and rubbing during daily walks.", "other_limitation": "May shift, rub, or put pressure in the wrong areas." } },
        { "type": "row", "settings": { "feature": "Secure Fit", "pv_benefit": "Adjustable structure helps keep the harness stable and secure.", "other_limitation": "Can loosen, twist, or feel unstable during movement." } },
        { "type": "row", "settings": { "feature": "Durability", "pv_benefit": "Built with durable materials for active dogs and outdoor adventures.", "other_limitation": "Basic materials may wear out faster." } },
        { "type": "row", "settings": { "feature": "Safety Details", "pv_benefit": "Reflective accents and secure handling support safer walks in more conditions.", "other_limitation": "May lack visibility or easy handling features." } },
        { "type": "row", "settings": { "feature": "Travel Ready", "pv_benefit": "Designed for daily walks, hikes, road trips, and pet-friendly outings.", "other_limitation": "Usually built only for basic short walks." } }
      ]
    }
  ]
}
{% endschema %}
