<script>
(function(){
  var acc = document.getElementById('pvfaq2-acc-{{ section.id }}');
  if (!acc) return;
  var items = acc.querySelectorAll('[data-pvfaq2-item]');
  items.forEach(function(item){
    var btn   = item.querySelector('.pvfaq2-trigger');
    var panel = item.querySelector('.pvfaq2-panel');
    var plus  = item.querySelector('.pvfaq2-icon-plus');
    var minus = item.querySelector('.pvfaq2-icon-minus');
    if (!btn || !panel) return;

    // sync initial icon state
    if (item.classList.contains('pvfaq2-open')) {
      if (plus)  plus.style.display  = 'none';
      if (minus) minus.style.display = '';
    }

    btn.addEventListener('click', function(){
      var isOpen = item.classList.contains('pvfaq2-open');
      // close all
      items.forEach(function(el){
        el.classList.remove('pvfaq2-open');
        el.querySelector('.pvfaq2-trigger').setAttribute('aria-expanded','false');
        var p = el.querySelector('.pvfaq2-icon-plus');
        var m = el.querySelector('.pvfaq2-icon-minus');
        if (p) p.style.display = '';
        if (m) m.style.display = 'none';
      });
      // open clicked if it was closed
      if (!isOpen) {
        item.classList.add('pvfaq2-open');
        btn.setAttribute('aria-expanded','true');
        if (plus)  plus.style.display  = 'none';
        if (minus) minus.style.display = '';
      }
    });
  });
})();
</script>

