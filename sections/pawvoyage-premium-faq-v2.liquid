{%- style -%}
/* â•â• PawVoyage Premium FAQ v2 â€” fully scoped â•â• */
#pvfaq2-{{ section.id }} {
  background: #FAF7F0;
  padding: 80px 2rem;
  font-family: -apple-system,BlinkMacSystemFont,'Inter','Segoe UI',sans-serif;
}
@media(max-width:749px){ #pvfaq2-{{ section.id }} { padding: 52px 1.6rem; } }

#pvfaq2-{{ section.id }} .pvfaq2-wrap { max-width: 1280px; margin: 0 auto; }

/* â”€â”€ Header â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-header { text-align: center; margin-bottom: 3.2rem; }
#pvfaq2-{{ section.id }} .pvfaq2-eyebrow {
  display: inline-block; font-size: 1.1rem; font-weight: 800;
  letter-spacing: .15em; text-transform: uppercase; color: #D4A843; margin-bottom: .8rem;
}
#pvfaq2-{{ section.id }} .pvfaq2-heading {
  font-size: clamp(3rem,4.5vw,4.4rem); font-weight: 900; color: #133316;
  line-height: 1.1; letter-spacing: -.025em; margin: 0 0 1rem;
}
#pvfaq2-{{ section.id }} .pvfaq2-sub {
  font-size: clamp(1.45rem,2vw,1.7rem); color: #4A5748; line-height: 1.6; margin: 0 auto; max-width: 580px;
}

/* â”€â”€ Trust badge row â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-trust-row {
  display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 3.6rem;
}
@media(max-width:899px){ #pvfaq2-{{ section.id }} .pvfaq2-trust-row { grid-template-columns: repeat(2,1fr); } }
@media(max-width:479px){ #pvfaq2-{{ section.id }} .pvfaq2-trust-row { grid-template-columns: 1fr; } }
#pvfaq2-{{ section.id }} .pvfaq2-trust-card {
  background: #fff; border: 1px solid rgba(19,51,22,.08); border-radius: 16px;
  padding: 1.6rem; display: flex; align-items: flex-start; gap: 1rem;
  box-shadow: 0 4px 16px rgba(19,51,22,.06);
}
#pvfaq2-{{ section.id }} .pvfaq2-trust-icon {
  width: 40px; height: 40px; background: rgba(19,51,22,.07); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#pvfaq2-{{ section.id }} .pvfaq2-trust-icon svg { width: 20px; height: 20px; stroke: #133316; }
#pvfaq2-{{ section.id }} .pvfaq2-trust-title { font-size: 1.3rem; font-weight: 800; color: #133316; margin: 0 0 .3rem; }
#pvfaq2-{{ section.id }} .pvfaq2-trust-text  { font-size: 1.15rem; color: #4A5748; margin: 0; line-height: 1.4; }

/* â”€â”€ Main 2-col layout â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-main {
  display: grid; grid-template-columns: 1fr 340px; gap: 36px; align-items: start; margin-bottom: 3.6rem;
}
@media(max-width:989px){ #pvfaq2-{{ section.id }} .pvfaq2-main { grid-template-columns: 1fr; gap: 28px; } }

/* â”€â”€ FAQ Accordion â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-accordion { display: flex; flex-direction: column; gap: 10px; }

/* closed item */
#pvfaq2-{{ section.id }} .pvfaq2-item {
  background: #fff; border: 1px solid rgba(19,51,22,.09); border-radius: 14px;
  box-shadow: 0 2px 10px rgba(19,51,22,.05); overflow: hidden; transition: box-shadow .2s;
}
#pvfaq2-{{ section.id }} .pvfaq2-item.pvfaq2-open {
  border-color: #133316; box-shadow: 0 8px 28px rgba(19,51,22,.11);
}

/* trigger button */
#pvfaq2-{{ section.id }} .pvfaq2-trigger {
  width: 100%; display: flex; align-items: center; gap: 1.4rem;
  background: none; border: none; cursor: pointer; padding: 1.6rem 1.8rem;
  text-align: left; transition: background .15s;
}
#pvfaq2-{{ section.id }} .pvfaq2-trigger:hover { background: rgba(19,51,22,.03); }
#pvfaq2-{{ section.id }} .pvfaq2-num {
  flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%;
  background: rgba(19,51,22,.08); display: flex; align-items: center; justify-content: center;
  font-size: 1.05rem; font-weight: 800; color: #133316;
}
#pvfaq2-{{ section.id }} .pvfaq2-open .pvfaq2-num { background: #133316; color: #fff; }
#pvfaq2-{{ section.id }} .pvfaq2-question {
  flex: 1; font-size: 1.45rem; font-weight: 700; color: #133316; line-height: 1.35;
}
#pvfaq2-{{ section.id }} .pvfaq2-icon {
  flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
  border: 1.5px solid rgba(19,51,22,.2); display: flex; align-items: center; justify-content: center;
  transition: background .2s, border-color .2s;
}
#pvfaq2-{{ section.id }} .pvfaq2-open .pvfaq2-icon { background: #133316; border-color: #133316; }
#pvfaq2-{{ section.id }} .pvfaq2-icon svg { width: 14px; height: 14px; stroke: #133316; stroke-width: 2.5; transition: stroke .2s; }
#pvfaq2-{{ section.id }} .pvfaq2-open .pvfaq2-icon svg { stroke: #fff; }

/* answer panel */
#pvfaq2-{{ section.id }} .pvfaq2-panel {
  display: none; padding: 0 1.8rem 1.8rem;
}
#pvfaq2-{{ section.id }} .pvfaq2-open .pvfaq2-panel { display: block; }

/* inner answer layout */
#pvfaq2-{{ section.id }} .pvfaq2-answer-inner {
  display: grid; grid-template-columns: 120px 1fr; gap: 1.6rem; align-items: start; margin-bottom: 1.4rem;
}
#pvfaq2-{{ section.id }} .pvfaq2-answer-inner.no-img { grid-template-columns: 1fr; }
@media(max-width:479px){ #pvfaq2-{{ section.id }} .pvfaq2-answer-inner { grid-template-columns: 1fr; } }
#pvfaq2-{{ section.id }} .pvfaq2-faq-img {
  width: 120px; height: 130px; object-fit: cover; border-radius: 12px;
  background: #EDE8DC; display: block;
}
#pvfaq2-{{ section.id }} .pvfaq2-faq-img-placeholder {
  width: 120px; height: 130px; border-radius: 12px; background: #EDE8DC;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#pvfaq2-{{ section.id }} .pvfaq2-faq-img-placeholder svg { width:28px; height:28px; stroke:#8A9486; }
#pvfaq2-{{ section.id }} .pvfaq2-answer-text { font-size: 1.4rem; color: #2A3228; line-height: 1.6; margin: 0; }

/* mini benefit cards */
#pvfaq2-{{ section.id }} .pvfaq2-mini-benefits {
  display: flex; gap: 10px; flex-wrap: wrap;
}
#pvfaq2-{{ section.id }} .pvfaq2-mini-ben {
  display: flex; align-items: center; gap: .6rem; background: #F5F2EB;
  border: 1px solid rgba(19,51,22,.09); border-radius: 10px;
  padding: .75rem 1.1rem; font-size: 1.15rem; font-weight: 600; color: #133316;
}
#pvfaq2-{{ section.id }} .pvfaq2-mini-ben svg { width:15px; height:15px; stroke:#133316; flex-shrink:0; }

/* â”€â”€ Sidebar â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-sidebar { display: flex; flex-direction: column; gap: 16px; }
#pvfaq2-{{ section.id }} .pvfaq2-sidebar-img {
  width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 18px 18px 0 0;
  background: #D9D0C0; display: block;
}
#pvfaq2-{{ section.id }} .pvfaq2-sidebar-img-ph {
  width: 100%; aspect-ratio: 4/3; border-radius: 18px 18px 0 0; background: linear-gradient(135deg,#EDE8DC,#D0C8B8);
  display: flex; align-items: center; justify-content: center; color: #8A9486; font-size: 1.2rem; font-weight: 600;
}

/* help card */
#pvfaq2-{{ section.id }} .pvfaq2-help-card {
  background: #fff; border: 1px solid rgba(19,51,22,.09); border-radius: 0 0 18px 18px;
  box-shadow: 0 8px 24px rgba(19,51,22,.08); overflow: hidden;
}
#pvfaq2-{{ section.id }} .pvfaq2-help-header {
  display: flex; align-items: center; gap: 1.2rem; padding: 1.6rem 1.8rem 1.2rem;
  border-bottom: 1px solid rgba(19,51,22,.07);
}
#pvfaq2-{{ section.id }} .pvfaq2-help-icon {
  width: 44px; height: 44px; background: rgba(19,51,22,.08); border-radius: 50%;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#pvfaq2-{{ section.id }} .pvfaq2-help-icon svg { width:22px; height:22px; stroke:#133316; }
#pvfaq2-{{ section.id }} .pvfaq2-help-title { font-size: 1.5rem; font-weight: 800; color: #133316; margin: 0 0 .2rem; }
#pvfaq2-{{ section.id }} .pvfaq2-help-text  { font-size: 1.2rem; color: #4A5748; margin: 0; }
#pvfaq2-{{ section.id }} .pvfaq2-contact-item {
  display: flex; align-items: center; gap: 1.2rem; padding: 1.2rem 1.8rem;
  border-bottom: 1px solid rgba(19,51,22,.06); text-decoration: none;
  transition: background .15s;
}
#pvfaq2-{{ section.id }} .pvfaq2-contact-item:hover { background: rgba(19,51,22,.03); }
#pvfaq2-{{ section.id }} .pvfaq2-contact-icon {
  width: 36px; height: 36px; border-radius: 50%; border: 1px solid rgba(19,51,22,.14);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#pvfaq2-{{ section.id }} .pvfaq2-contact-icon svg { width:16px; height:16px; stroke:#133316; }
#pvfaq2-{{ section.id }} .pvfaq2-contact-body { flex: 1; }
#pvfaq2-{{ section.id }} .pvfaq2-contact-name { font-size: 1.25rem; font-weight: 700; color: #133316; }
#pvfaq2-{{ section.id }} .pvfaq2-contact-desc { font-size: 1.1rem; color: #6B7568; }
#pvfaq2-{{ section.id }} .pvfaq2-contact-arrow { color: #9CA8A0; font-size: 1.4rem; }

/* guarantee mini card */
#pvfaq2-{{ section.id }} .pvfaq2-guar-mini {
  background: linear-gradient(135deg,#FDF6E8 0%,#F5EDDA 100%);
  border: 1px solid rgba(212,168,67,.2); border-radius: 14px;
  padding: 1.6rem; text-align: center;
}
#pvfaq2-{{ section.id }} .pvfaq2-guar-mini svg { width:24px; height:24px; stroke:#D4A843; margin-bottom:.6rem; }
#pvfaq2-{{ section.id }} .pvfaq2-guar-mini-title { font-size: 1.3rem; font-weight: 800; color: #133316; margin: 0 0 .4rem; }
#pvfaq2-{{ section.id }} .pvfaq2-guar-mini-text  { font-size: 1.15rem; color: #4A5748; margin: 0; }

/* â”€â”€ Risk-free banner â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-banner {
  background: #fff; border: 1px solid rgba(19,51,22,.09); border-radius: 20px;
  padding: 2.4rem 2.8rem; box-shadow: 0 8px 28px rgba(19,51,22,.07);
  display: flex; align-items: center; gap: 2.4rem; margin-bottom: 3.2rem; flex-wrap: wrap;
}
#pvfaq2-{{ section.id }} .pvfaq2-seal {
  flex-shrink: 0; width: 100px; height: 100px; border-radius: 50%;
  background: #133316; display: flex; flex-direction: column; align-items: center;
  justify-content: center; color: #fff; text-align: center; padding: .8rem;
}
#pvfaq2-{{ section.id }} .pvfaq2-seal-badge { font-size: .9rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; line-height: 1.1; }
#pvfaq2-{{ section.id }} .pvfaq2-seal-days { font-size: 2.4rem; font-weight: 900; line-height: 1; margin: .15rem 0; }
#pvfaq2-{{ section.id }} .pvfaq2-seal-day  { font-size: .9rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
#pvfaq2-{{ section.id }} .pvfaq2-banner-body { flex: 1; min-width: 220px; }
#pvfaq2-{{ section.id }} .pvfaq2-banner-heading { font-size: clamp(2rem,2.8vw,2.8rem); font-weight: 900; color: #133316; margin: 0 0 .6rem; }
#pvfaq2-{{ section.id }} .pvfaq2-banner-text { font-size: 1.4rem; color: #4A5748; line-height: 1.55; margin: 0; }
#pvfaq2-{{ section.id }} .pvfaq2-banner-cta {
  display: inline-flex; align-items: center; gap: .7rem; background: #133316; color: #fff;
  font-size: 1.55rem; font-weight: 800; padding: 1.4rem 3rem; border-radius: 999px;
  text-decoration: none; white-space: nowrap; box-shadow: 0 8px 22px rgba(19,51,22,.22);
  transition: background .2s, transform .2s;
}
#pvfaq2-{{ section.id }} .pvfaq2-banner-cta:hover { background: #1A4A20; transform: translateY(-2px); color: #fff; }
#pvfaq2-{{ section.id }} .pvfaq2-banner-cta svg { width:16px; height:16px; stroke:#fff; stroke-width:2.2; }
@media(max-width:749px){
  #pvfaq2-{{ section.id }} .pvfaq2-banner { flex-direction: column; align-items: center; text-align: center; padding: 2rem 1.6rem; }
  #pvfaq2-{{ section.id }} .pvfaq2-banner-cta { width: 100%; justify-content: center; }
}

/* â”€â”€ Social proof row â”€â”€ */
#pvfaq2-{{ section.id }} .pvfaq2-proof { text-align: center; }
#pvfaq2-{{ section.id }} .pvfaq2-proof-label { font-size: 1.3rem; color: #4A5748; font-weight: 500; margin: 0 0 1.2rem; }
#pvfaq2-{{ section.id }} .pvfaq2-proof-row {
  display: flex; align-items: center; justify-content: center; gap: 1.2rem; flex-wrap: wrap;
}
#pvfaq2-{{ section.id }} .pvfaq2-avatars { display: flex; }
#pvfaq2-{{ section.id }} .pvfaq2-av {
  width: 38px; height: 38px; border-radius: 50%; border: 2.5px solid #FAF7F0;
  object-fit: cover; margin-left: -10px; background: #D9D0C0;
}
#pvfaq2-{{ section.id }} .pvfaq2-av:first-child { margin-left: 0; }
#pvfaq2-{{ section.id }} .pvfaq2-av-ph {
  width: 38px; height: 38px; border-radius: 50%; border: 2.5px solid #FAF7F0;
  background: #C8BEA8; margin-left: -10px; flex-shrink: 0;
}
#pvfaq2-{{ section.id }} .pvfaq2-av-ph:first-child { margin-left: 0; }
#pvfaq2-{{ section.id }} .pvfaq2-proof-rating { display: flex; align-items: center; gap: .5rem; font-size: 1.3rem; font-weight: 700; color: #2A3228; }
#pvfaq2-{{ section.id }} .pvfaq2-proof-stars { color: #D4A843; font-size: 1.4rem; letter-spacing: 1px; }
{%- endstyle -%}

<!-- ===== FAQ v2 SECTION ===== -->
<section id="pvfaq2-{{ section.id }}" aria-labelledby="pvfaq2-heading-{{ section.id }}">
<div class="pvfaq2-wrap">

  <!-- Header -->
  <div class="pvfaq2-header">
    {%- if section.settings.eyebrow_text != blank -%}<p class="pvfaq2-eyebrow">{{ section.settings.eyebrow_text }}</p>{%- endif -%}
    <h2 class="pvfaq2-heading" id="pvfaq2-heading-{{ section.id }}">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="pvfaq2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <!-- Trust badge row -->
  <div class="pvfaq2-trust-row">
    <div class="pvfaq2-trust-card">
      <div class="pvfaq2-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
      <div><p class="pvfaq2-trust-title">{{ section.settings.trust_1_title | default: '30-Day Risk-Free Trial' }}</p><p class="pvfaq2-trust-text">{{ section.settings.trust_1_text | default: 'Love it or get your money back.' }}</p></div>
    </div>
    <div class="pvfaq2-trust-card">
      <div class="pvfaq2-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
      <div><p class="pvfaq2-trust-title">{{ section.settings.trust_2_title | default: 'Free Shipping' }}</p><p class="pvfaq2-trust-text">{{ section.settings.trust_2_text | default: 'On all orders over $50.' }}</p></div>
    </div>
    <div class="pvfaq2-trust-card">
      <div class="pvfaq2-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
      <div><p class="pvfaq2-trust-title">{{ section.settings.trust_3_title | default: '10,000+ Happy Dogs' }}</p><p class="pvfaq2-trust-text">{{ section.settings.trust_3_text | default: 'Join thousands of satisfied dog owners.' }}</p></div>
    </div>
    <div class="pvfaq2-trust-card">
      <div class="pvfaq2-trust-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
      <div><p class="pvfaq2-trust-title">{{ section.settings.trust_4_title | default: 'Secure Checkout' }}</p><p class="pvfaq2-trust-text">{{ section.settings.trust_4_text | default: 'Your payment information is 100% protected.' }}</p></div>
    </div>
  </div>

  <!-- Main 2-col -->
  <div class="pvfaq2-main">

    <!-- LEFT: Accordion -->
    <div class="pvfaq2-accordion" id="pvfaq2-acc-{{ section.id }}">
      {%- assign faq_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pvfaq2_item' -%}
          {%- assign faq_index = faq_index | plus: 1 -%}
          {%- assign is_open = false -%}
          {%- if faq_index == 1 -%}{%- assign is_open = true -%}{%- endif -%}
          {%- if block.settings.open_by_default -%}{%- assign is_open = true -%}{%- endif -%}
          {%- assign num_str = faq_index | prepend: '0' | slice: -2, 2 -%}
          {%- assign panel_id = 'pvfaq2-panel-' | append: section.id | append: '-' | append: faq_index -%}
          {%- assign btn_id   = 'pvfaq2-btn-'   | append: section.id | append: '-' | append: faq_index -%}

          <div class="pvfaq2-item{% if is_open %} pvfaq2-open{% endif %}" data-pvfaq2-item {{ block.shopify_attributes }}>
            <button
              class="pvfaq2-trigger"
              id="{{ btn_id }}"
              aria-expanded="{{ is_open }}"
              aria-controls="{{ panel_id }}"
            >
              <span class="pvfaq2-num" aria-hidden="true">{{ num_str }}</span>
              <span class="pvfaq2-question">{{ block.settings.question | default: 'FAQ question' }}</span>
              <span class="pvfaq2-icon" aria-hidden="true">
                <svg class="pvfaq2-icon-plus"  viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <svg class="pvfaq2-icon-minus" viewBox="0 0 24 24" fill="none" style="display:none"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
            </button>
            <div class="pvfaq2-panel" id="{{ panel_id }}" role="region" aria-labelledby="{{ btn_id }}">
              {%- assign has_faq_img = false -%}
              {%- if block.settings.optional_image != blank -%}{%- assign has_faq_img = true -%}{%- endif -%}
              {%- assign section_img = section.settings.open_faq_image -%}
              {%- assign show_sec_img = false -%}
              {%- if section_img != blank -%}{%- assign show_sec_img = true -%}{%- endif -%}
              <div class="pvfaq2-answer-inner">
                {%- if has_faq_img -%}
                  <img class="pvfaq2-faq-img" src="{{ block.settings.optional_image | image_url: width: 300 }}" alt="{{ block.settings.optional_image_alt | default: block.settings.question | escape }}" width="120" height="130" loading="lazy">
                {%- elsif show_sec_img -%}
                  <img class="pvfaq2-faq-img" src="{{ section_img | image_url: width: 300 }}" alt="{{ section.settings.open_faq_image_alt | default: 'PawVoyage Harness' | escape }}" width="120" height="130" loading="lazy">
                {%- else -%}
                  <div class="pvfaq2-faq-img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
                {%- endif -%}
                <p class="pvfaq2-answer-text">{{ block.settings.answer | default: 'Answer goes here.' }}</p>
              </div>
              {%- assign b1 = block.settings.mini_benefit_1 -%}
              {%- assign b2 = block.settings.mini_benefit_2 -%}
              {%- assign b3 = block.settings.mini_benefit_3 -%}
              {%- if b1 == blank -%}{%- assign b1 = section.settings.mini_benefit_1 -%}{%- endif -%}
              {%- if b2 == blank -%}{%- assign b2 = section.settings.mini_benefit_2 -%}{%- endif -%}
              {%- if b3 == blank -%}{%- assign b3 = section.settings.mini_benefit_3 -%}{%- endif -%}
              {%- if b1 != blank or b2 != blank or b3 != blank -%}
              <div class="pvfaq2-mini-benefits">
                {%- if b1 != blank -%}<div class="pvfaq2-mini-ben"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ b1 }}</div>{%- endif -%}
                {%- if b2 != blank -%}<div class="pvfaq2-mini-ben"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ b2 }}</div>{%- endif -%}
                {%- if b3 != blank -%}<div class="pvfaq2-mini-ben"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ b3 }}</div>{%- endif -%}
              </div>
