{% comment %}
  PawVoyage — Blog Article Card Snippet
  Renders a single article card with image, tag, title, excerpt, meta.

  Accepts:
    - article     {Object}  Shopify article object (required)
    - card_size   {String}  'large' | 'small' | 'grid'  (default: 'grid')
    - show_excerpt {Boolean} Show excerpt text (default: true for large/grid, false for small)
{% endcomment %}

{%- liquid
  assign card_size     = card_size | default: 'grid'
  assign show_excerpt  = show_excerpt | default: nil

  # Reading time estimate
  assign word_count    = article.content | strip_html | split: ' ' | size
  assign reading_mins  = word_count | divided_by: 200 | at_least: 1

  # Primary tag — first tag becomes the category badge
  assign article_tag   = article.tags | first
  assign tag_label     = article_tag | replace: '-', ' '

  # Excerpt: use manually set excerpt, fallback to truncated content
  assign raw_excerpt   = article.excerpt_or_content | strip_html | strip

  # Truncate length based on card size
  if card_size == 'large'
    assign excerpt_len = 160
  else
    assign excerpt_len = 110
  endif
-%}

<article class="pv-blog-card pv-blog-card--{{ card_size }}">
  <a
    href="{{ article.url }}"
    class="pv-blog-card__link"
    aria-label="{{ article.title | escape }}"
  >

    {%- comment -%}── Image ────────────────────────────────────────────{%- endcomment -%}
    <div class="pv-blog-card__img-wrap">
      {%- if article.image -%}
        {{
          article.image
          | image_url: width: 800
          | image_tag:
            alt: article.image.alt | default: article.title,
            class: 'pv-blog-card__img',
            loading: 'lazy',
            widths: '400, 600, 800'
        }}
      {%- else -%}
        <div class="pv-blog-card__img-placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      {%- endif -%}

      {%- if article_tag -%}
        <span class="pv-blog-card__tag">{{ tag_label }}</span>
      {%- endif -%}
    </div>

    {%- comment -%}── Body ─────────────────────────────────────────────{%- endcomment -%}
    <div class="pv-blog-card__body">
      <h3 class="pv-blog-card__title">{{ article.title | escape }}</h3>

      {%- unless card_size == 'small' and show_excerpt == nil -%}
        {%- if raw_excerpt != blank -%}
          <p class="pv-blog-card__excerpt">
            {{- raw_excerpt | truncate: excerpt_len -}}
          </p>
        {%- endif -%}
      {%- endunless -%}

      {%- comment -%}── Meta: author · date · read time ─────────────────{%- endcomment -%}
      <div class="pv-blog-card__meta">
        {%- if article.author -%}
          <span class="pv-blog-card__author">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 21a8 8 0 0 1 16 0"/>
            </svg>
            {{ article.author }}
          </span>
          <span class="pv-blog-card__dot" aria-hidden="true">·</span>
        {%- endif -%}

        <time
          class="pv-blog-card__date"
          datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
        >
          {{- article.published_at | date: '%b %-d, %Y' -}}
        </time>

        <span class="pv-blog-card__dot" aria-hidden="true">·</span>
        <span class="pv-blog-card__read">{{ reading_mins }} min read</span>
      </div>
    </div>

  </a>
</article>
