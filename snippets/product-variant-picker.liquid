  <script>
  (function() {
    var dialog = document.getElementById('pv-size-guide-modal');
    if (!dialog) return;
    dialog.addEventListener('click', function(e) {
      var rect = dialog.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right ||
          e.clientY < rect.top  || e.clientY > rect.bottom) { dialog.close(); }
    });
    dialog.addEventListener('close', function() { document.body.style.overflow = ''; });
    var origShow = HTMLDialogElement.prototype.showModal.bind(dialog);
    dialog.showModal = function() { origShow(); document.body.style.overflow = 'hidden'; };
  })();
  </script>

  <style>
    /* Variant Picker Custom Styles */
