    .pv-step-badge { width: 2.4rem; height: 2.4rem; background: #12350E; color: #FFF7EA; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; font-weight: 800; }
    .pv-step-card p { font-size: 1.4rem; color: #1F241D; line-height: 1.5; margin: 0; }

    .pv-note-box { background: rgba(217,154,43,0.15); border: 1px solid rgba(217,154,43,0.3); border-radius: 8px; padding: 1.6rem; color: #12350E; font-size: 1.4rem; line-height: 1.5; margin-bottom: 2.4rem; }
    
    .pv-recommendations-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 2.4rem; }
    .pv-rec-card { background: #FFF; padding: 1.2rem; border-radius: 8px; border: 1px solid rgba(31,36,29,0.08); }
    .pv-rec-card strong { display: block; font-size: 1.3rem; color: #12350E; margin-bottom: 0.4rem; }
    .pv-rec-card span { display: block; font-size: 1.2rem; color: #4A5246; line-height: 1.4; }

    .pv-table-wrapper { display: none; margin-bottom: 2.4rem; background: #FFF; border-radius: 12px; border: 1px solid rgba(31,36,29,0.08); overflow: hidden; }
    .pv-size-table { width: 100%; border-collapse: collapse; text-align: left; }
    .pv-size-table th { font-size: 1.3rem; font-weight: 700; color: #4A5246; border-bottom: 2px solid rgba(18,53,14,0.1); padding: 1.6rem; letter-spacing: 0.5px; }
    .pv-size-table td { font-size: 1.4rem; color: #1F241D; border-bottom: 1px solid rgba(18,53,14,0.05); padding: 1.6rem; line-height: 1.5; }
    .pv-size-table tbody tr:nth-child(even) { background: rgba(255,247,234,0.4); }
    .pv-size-label { font-weight: 800; font-size: 1.6rem !important; }
    .pv-highlight { color: #12350E; font-weight: 700; }

    .pv-mobile-cards { display: flex; flex-direction: column; gap: 1.6rem; margin-bottom: 2.4rem; }
    .pv-mobile-card { background: #FFF; border-radius: 12px; border: 1px solid rgba(31,36,29,0.08); overflow: hidden; box-shadow: 0 2px 8px rgba(31,36,29,0.02); }
    .pv-mc-header { background: rgba(255,247,234,0.6); font-size: 1.8rem; font-weight: 800; color: #12350E; padding: 1.2rem 1.6rem; border-bottom: 1px solid rgba(31,36,29,0.04); }
    .pv-mc-row { display: flex; justify-content: space-between; padding: 1.2rem 1.6rem; border-bottom: 1px solid rgba(31,36,29,0.04); font-size: 1.4rem; line-height: 1.4; gap: 1.6rem; }
    .pv-mc-row:last-child { border-bottom: none; }
    .pv-mc-row span { color: #4A5246; white-space: nowrap; }
