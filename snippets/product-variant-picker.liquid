    @media screen and (min-width: 650px) {
      .pv-table-wrapper { display: block; }
      .pv-mobile-cards { display: none; }
    }

    .pv-modal-footer { background: #FFF; padding: 2rem; border-radius: 12px; text-align: center; border: 1px solid rgba(31,36,29,0.08); }
    .pv-modal-footer strong { display: block; font-size: 1.6rem; color: #12350E; margin-bottom: 0.8rem; }
    .pv-modal-footer p { font-size: 1.4rem; color: #4A5246; margin: 0 0 1.6rem; line-height: 1.5; }
    .pv-contact-btn { display: inline-block; background: #FFF7EA; color: #12350E; font-size: 1.4rem; font-weight: 700; padding: 1rem 2.4rem; border-radius: 999px; text-decoration: none; border: 1px solid rgba(18,53,14,0.1); transition: all 0.2s; }
    .pv-contact-btn:hover { background: #12350E; color: #FFF7EA; }
  </style>

  <script>
  /* ---- PawVoyage: Color Scroll Carousel — scoped IIFE ---- */
  (function() {
      'use strict';
      function initColorScrollers() {
        var wraps = document.querySelectorAll('[data-pv-color-wrap]');
        wraps.forEach(function(wrap) {
          var scroller = wrap.querySelector('[data-pv-scroller]');
          var nextBtn  = wrap.querySelector('[data-pv-next]');
          var prevBtn  = wrap.querySelector('[data-pv-prev]');
          if (!scroller) return;

          /* ---- Update scroll-state classes ---- */
          function updateState() {
            var atStart = scroller.scrollLeft <= 4;
            var atEnd   = scroller.scrollLeft + scroller.clientWidth >= scroller.scrollWidth - 4;
            var hasOverflow = scroller.scrollWidth > scroller.clientWidth + 4;

            wrap.classList.toggle('has-overflow-right', hasOverflow && !atEnd);
            wrap.classList.toggle('has-overflow-left',  hasOverflow && !atStart);
          }

          /* ---- Arrow click handlers ---- */
          var step = 0;
          function getStep() {
            var labels = scroller.querySelectorAll('label');
            if (labels.length) {
              var lw = labels[0].offsetWidth + 8; /* swatch width + gap */
              return lw * 3.5; /* ~3.5 swatches per click */
            }
            return scroller.clientWidth * 0.75;
          }

          if (nextBtn) nextBtn.addEventListener('click', function() {
            scroller.scrollBy({ left: getStep(), behavior: 'smooth' });
          });
          if (prevBtn) prevBtn.addEventListener('click', function() {
            scroller.scrollBy({ left: -getStep(), behavior: 'smooth' });
          });

          /* ---- Mouse drag-to-scroll ---- */
          var isDragging = false, startX = 0, startScroll = 0;
          scroller.addEventListener('mousedown', function(e) {
            isDragging = true;
            startX = e.pageX - scroller.offsetLeft;
            startScroll = scroller.scrollLeft;
            scroller.classList.add('is-grabbing');
            e.preventDefault();
          });
          window.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            var x = e.pageX - scroller.offsetLeft;
            scroller.scrollLeft = startScroll - (x - startX);
          });
          window.addEventListener('mouseup', function() {
            if (isDragging) {
              isDragging = false;
              scroller.classList.remove('is-grabbing');
              updateState();
            }
          });

          /* ---- Horizontal wheel scroll (trackpad + mouse) ---- */
          scroller.addEventListener('wheel', function(e) {
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; /* already horizontal */
            var hasHScroll = scroller.scrollWidth > scroller.clientWidth + 4;
            if (!hasHScroll) return;
            e.preventDefault();
            scroller.scrollLeft += e.deltaY;
          }, { passive: false });

          /* ---- Scroll & resize listeners ---- */
          scroller.addEventListener('scroll', updateState, { passive: true });
          window.addEventListener('resize', updateState, { passive: true });

          /* ---- Scroll selected swatch into view on variant change ---- */
          document.addEventListener('variant:change', function() {
            var selected = scroller.querySelector('input[type="radio"]:checked');
            if (selected && selected.nextElementSibling) {
              selected.nextElementSibling.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            }
            updateState();
          });

          /* ---- Initial state ---- */
          updateState();

          /* ---- Scroll selected swatch into view on init ---- */
          var initSelected = scroller.querySelector('input[type="radio"]:checked');
          if (initSelected && initSelected.nextElementSibling) {
            initSelected.nextElementSibling.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initColorScrollers);
      } else {
        initColorScrollers();
      }
  })();
  </script>
{%- endunless -%}
