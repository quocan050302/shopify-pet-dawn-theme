{% comment %}
  pv-beacons-content.liquid
  Left-column content feed:
  A. Intro card (headline, value prop, trust line)
  B. Variant selector (color + size) — synced to hidden right-col form picker
  C. Benefit cards
  D. Size & Fit + How to Measure
  E. Product Details accordion
  F. Comparison table
  G. Final CTA
{% endcomment %}

{%- assign pv_form_id = 'product-form-' | append: section.id -%}

