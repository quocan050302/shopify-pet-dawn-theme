{% comment %}
  pv-beacons-content.liquid
  Left-column content feed:
  A. Intro card (headline, value prop, trust line)
  B. Variant selector (color + size) — synced to hidden right-col form picker
  C. Benefit cards
  D. Size & Fit + How to Measure
  E. Product Details accordion
  F. Comparison table
  G. Final CTA
{% endcomment %}

{%- assign pv_form_id = 'product-form-' | append: section.id -%}

<div class="pv-beacons-content-wrapper">

  <!-- ===== A. INTRO CARD ===== -->
  <section class="pv-edu-section pv-intro-card">
    <div class="pv-intro-badges">
      <span class="pv-badge-dark">NO-PULL DOG HARNESS</span>
      <span class="pv-badge-gold">FREE SHIPPING TODAY</span>
    </div>
    <p class="pv-intro-hook">Built for dogs who pull, twist, and turn everyday walks into a tug-of-war.</p>
    <h2>Take Back Control of Every Walk</h2>
    <p class="pv-intro-title">{{ product.title }}</p>
    <p class="pv-intro-subtitle">Designed for calmer walks, better control, and all-day comfort.</p>
    <p class="pv-trust-line">
      <span>🔒 Secure checkout</span>
      <span>↩ 30-day easy returns</span>
      <span>🚚 Free shipping today</span>
    </p>
  </section>

  <!-- ===== B. VARIANT SELECTOR (left col — syncs with hidden right-col picker) ===== -->
  <section class="pv-edu-section pv-variants-section" id="pv-variant-chooser">
    <h3 class="pv-section-heading" style="margin-bottom:0.8rem">Choose Your Options</h3>
    <p style="font-size:1.3rem;color:#6F7568;margin:0 0 2rem">Select color and size before adding to cart.</p>

    {%- for option in product.options_with_values -%}
      <div class="pv-option-group" data-option-index="{{ forloop.index0 }}">
        <div class="pv-option-label">
          <span class="pv-option-name">{{ option.name }}:</span>
          <span class="pv-option-selected" id="pv-sel-{{ section.id }}-{{ forloop.index0 }}">
            {{- option.selected_value -}}
          </span>
        </div>
        <div class="pv-option-grid">
          {%- for value in option.values -%}
            {%- assign is_selected = false -%}
            {%- if value == option.selected_value -%}{%- assign is_selected = true -%}{%- endif -%}
            {%- comment -%} Check availability for this option value {%- endcomment -%}
            {%- assign option_available = false -%}
            {%- for variant in product.variants -%}
              {%- assign opt_key = 'option' | append: forloop.parentloop.index -%}
              {%- if variant[opt_key] == value and variant.available -%}
                {%- assign option_available = true -%}
              {%- endif -%}
            {%- endfor -%}
            <button
              type="button"
              class="pv-opt-btn{% if is_selected %} pv-opt-active{% endif %}{% unless option_available %} pv-opt-unavailable{% endunless %}"
              data-option-index="{{ forloop.parentloop.index0 }}"
              data-option-name="{{ option.name | escape }}"
              data-option-value="{{ value | escape }}"
              data-section-id="{{ section.id }}"
              {% unless option_available %}aria-label="{{ value }} - unavailable"{% endunless %}
            >
              {{- value -}}
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    <!-- Size guide link -->
    <div class="pv-size-guide-hint">
      <span>Between sizes?</span>
      <button type="button" class="pv-size-guide-link"
        onclick="document.getElementById('pv-size-guide-modal').showModal()">
        View Size Guide →
      </button>
    </div>

    <!-- Unavailability message -->
    <p class="pv-unavail-msg" id="pv-unavail-{{ section.id }}" style="display:none;color:#C0392B;font-size:1.3rem;margin-top:1.2rem;font-weight:600;">
      This combination is unavailable. Please choose another option.
    </p>
  </section>

  <!-- ===== C. BENEFIT CARDS ===== -->
  <section class="pv-edu-section">
    <h3 class="pv-section-heading">Why You'll Love It</h3>
    <div class="pv-benefits-grid">
      <div class="pv-benefit-card">
        <div class="pv-bc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <strong>Better No-Pull Control</strong>
        <p>Helps redirect pulling so walks feel easier to manage.</p>
      </div>
      <div class="pv-benefit-card">
        <div class="pv-bc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <strong>Comfort-Focused Fit</strong>
        <p>Padded chest support helps reduce rubbing and neck pressure.</p>
      </div>
      <div class="pv-benefit-card">
        <div class="pv-bc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <strong>Secure Adjustable Design</strong>
        <p>Adjustable straps help keep the harness snug and stable.</p>
      </div>
      <div class="pv-benefit-card">
        <div class="pv-bc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 2v6h6" stroke="#D99A2B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <strong>Ready for Daily Adventures</strong>
        <p>Built for walks, training, travel, and outdoor exploring.</p>
      </div>
    </div>
  </section>

  <!-- ===== D. SIZE & FIT + HOW TO MEASURE ===== -->
  <section class="pv-edu-section pv-size-section">
    <div class="pv-size-flex">
      <div class="pv-size-left">
        <h3 class="pv-section-heading">Find the Right Fit</h3>
        <p class="pv-size-desc">Measure around the widest part of your dog's chest, just behind the front legs. Chest girth is the most important measurement.</p>
        <ul class="pv-bullet-list">
          <li>If between sizes, choose the larger size.</li>
          <li>Weight and breed are general guides only.</li>
        </ul>
        <button type="button" class="pv-open-size-btn"
          onclick="document.getElementById('pv-size-guide-modal').showModal()">
          Open Size Guide
        </button>
      </div>
      <div class="pv-size-right">
        <h3 class="pv-section-heading">How to measure</h3>
        <ol class="pv-num-list">
          <li>Measure chest behind front legs</li>
          <li>Keep tape snug, not tight</li>
          <li>Compare with the size chart</li>
          <li>Adjust straps after putting on</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== E. PRODUCT DETAILS ACCORDION ===== -->
  <section class="pv-edu-section pv-faq-section">
    <h3 class="pv-section-heading">Product Details</h3>
    <div class="pv-faq-list">
      <details class="pv-faq-item" open>
        <summary>Why You'll Love It</summary>
        <div class="pv-faq-ans">Designed to help reduce pulling, support comfort, and make daily walks feel calmer and more controlled.</div>
      </details>
      <details class="pv-faq-item">
        <summary>Materials</summary>
        <div class="pv-faq-ans">Durable nylon webbing, reinforced buckles, adjustable straps, breathable padding.</div>
      </details>
      <details class="pv-faq-item">
        <summary>Shipping & Returns</summary>
        <div class="pv-faq-ans">Delivery typically takes 7–12 business days. 30-day easy returns if it's not the right fit.</div>
      </details>
      <details class="pv-faq-item">
        <summary>What's Included</summary>
        <div class="pv-faq-ans">1 × PawVoyage No-Pull Tactical Dog Harness</div>
      </details>
      <details class="pv-faq-item">
        <summary>FAQ</summary>
        <div class="pv-faq-ans">
          <p><strong>Is this good for dogs that pull?</strong><br>Yes — it helps redirect pulling and distributes pressure safely across the chest.</p>
          <p><strong>How do I choose the right size?</strong><br>Measure chest girth. Use the size guide. If between sizes, choose larger.</p>
          <p><strong>Is it comfortable for daily walks?</strong><br>Yes, the padded chest plate prevents rubbing during extended walks.</p>
          <p><strong>Can I use it for travel or training?</strong><br>Absolutely. Its durable build makes it ideal for both.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- ===== F. COMPARISON TABLE ===== -->
  <section class="pv-edu-section pv-comparison-section">
    <h3 class="pv-section-heading">PawVoyage vs. Regular Harness</h3>
    <table class="pv-compare-table">
      <thead>
        <tr>
          <th>Feature</th>
          <th class="pv-brand-col">PawVoyage</th>
          <th>Regular Harness</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Better pulling control</td><td class="pv-brand-col"><span class="pv-check">✓</span></td><td><span class="pv-cross">×</span></td></tr>
        <tr><td>Padded chest comfort</td><td class="pv-brand-col"><span class="pv-check">✓</span></td><td><span class="pv-cross">×</span></td></tr>
        <tr><td>Adjustable secure fit</td><td class="pv-brand-col"><span class="pv-check">✓</span></td><td><span class="pv-cross">×</span></td></tr>
        <tr><td>Durable tactical build</td><td class="pv-brand-col"><span class="pv-check">✓</span></td><td><span class="pv-cross">×</span></td></tr>
        <tr><td>Travel-ready design</td><td class="pv-brand-col"><span class="pv-check">✓</span></td><td><span class="pv-cross">×</span></td></tr>
      </tbody>
    </table>
  </section>

  <!-- ===== G. FINAL CTA ===== -->
  <section class="pv-edu-section pv-final-cta">
    <h2>Ready for calmer walks?</h2>
    <p>Choose a harness designed to help you guide your dog with more comfort, control, and confidence.</p>
    <a href="#pv-variant-chooser" class="pv-btn-solid"
       onclick="document.getElementById('pv-variant-chooser').scrollIntoView({behavior:'smooth'}); return false;">
      Choose Your Size
    </a>
  </section>

</div>

<!-- =====================================================
     JS BRIDGE: Left-col variant buttons → hidden right-col picker
     ===================================================== -->
<script>
(function() {
  'use strict';

  var SECTION_ID = {{ section.id | json }};

  function pvInitVariants() {
    var btns = document.querySelectorAll('.pv-opt-btn');
    if (!btns.length) return;

    btns.forEach(function(btn) {
      if (btn.dataset.pvBound) return;
      btn.dataset.pvBound = '1';

      btn.addEventListener('click', function() {
        if (this.classList.contains('pv-opt-unavailable')) return;

        var optIdx   = parseInt(this.dataset.optionIndex, 10);
        var optName  = this.dataset.optionName;
        var optValue = this.dataset.optionValue;

        // ── 1. Update visual active state in left col ──
        document.querySelectorAll('.pv-opt-btn[data-option-index="' + optIdx + '"]')
          .forEach(function(b) { b.classList.remove('pv-opt-active'); });
        this.classList.add('pv-opt-active');

        // ── 2. Update the selected label ──
        var label = document.getElementById('pv-sel-' + SECTION_ID + '-' + optIdx);
        if (label) label.textContent = optValue;

        // ── 3. Sync with the hidden variant-selects in right col ──
        // Dawn's picker is a <variant-selects> custom element
        var picker = document.querySelector('.pv-sticky-card variant-selects');
        if (picker) {
          // Try radio inputs first (Dawn default: button type)
          var synced = false;
          var radios = picker.querySelectorAll('input[type="radio"]');
          radios.forEach(function(radio) {
            // Dawn names options: "option1", "option2", etc.
            if (radio.name === 'option' + (optIdx + 1) && radio.value === optValue) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { bubbles: true }));
              synced = true;
            }
          });

          // Fallback: select dropdowns
          if (!synced) {
            var selects = picker.querySelectorAll('select');
            selects.forEach(function(sel) {
              if (sel.name === 'option' + (optIdx + 1)) {
                sel.value = optValue;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          }
        }

        // ── 4. Check selected combination availability ──
        pvCheckAvailability();
      });
    });
  }

  function pvCheckAvailability() {
    // Collect currently active values
    var selected = [];
    var groups = document.querySelectorAll('.pv-option-group');
    groups.forEach(function(g) {
      var active = g.querySelector('.pv-opt-btn.pv-opt-active');
      selected.push(active ? active.dataset.optionValue : '');
    });

    // Find matching variant
    var variants = {{ product.variants | json }};
    var match = variants.find(function(v) {
      return selected.every(function(val, i) {
        return v['option' + (i + 1)] === val;
      });
    });

    var msgEl = document.getElementById('pv-unavail-' + SECTION_ID);
    if (msgEl) {
      msgEl.style.display = (match && !match.available) ? 'block' : 'none';
    }

    // Dim add-to-cart in right col if unavailable
    var submitBtn = document.querySelector('.pv-sticky-card .product-form__submit');
    if (submitBtn) {
      if (match && !match.available) {
        submitBtn.setAttribute('aria-disabled', 'true');
      } else {
        submitBtn.removeAttribute('aria-disabled');
      }
    }
  }

  // Init on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', pvInitVariants);
  } else {
    pvInitVariants();
  }

  // Re-init if Shopify re-renders sections
  document.addEventListener('shopify:section:load', pvInitVariants);
})();
</script>

<style>
  /* ===== Wrapper ===== */
  .pv-beacons-content-wrapper { display: flex; flex-direction: column; gap: 2.4rem; padding-bottom: 4rem; }

  /* ===== Base card ===== */
  .pv-edu-section {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 2.8rem;
    border: 1px solid rgba(31,36,29,0.07);
    box-shadow: 0 4px 16px rgba(18,53,14,0.03);
  }
  .pv-section-heading { font-size: 2rem; font-weight: 800; color: #12350E; margin: 0 0 1.8rem; line-height: 1.25; }

  /* ===== Intro card ===== */
  .pv-intro-card { background: #12350E; color: #FFF7EA; border: none; }
  .pv-intro-badges { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1.6rem; }
  .pv-badge-dark { display: inline-block; background: rgba(255,247,234,0.12); color: #FFF7EA; font-size: 1.1rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.4rem 1rem; border-radius: 99px; border: 1px solid rgba(255,247,234,0.2); }
  .pv-badge-gold { display: inline-block; background: #D99A2B; color: #12350E; font-size: 1.1rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.4rem 1rem; border-radius: 99px; }
  .pv-intro-hook { display: block; font-size: 1.3rem; font-weight: 700; color: #D99A2B; margin: 0 0 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .pv-intro-card h2 { font-size: clamp(2.4rem, 4vw, 3.2rem); font-weight: 800; color: #FFF7EA; margin: 0 0 1rem; line-height: 1.2; }
  .pv-intro-title { font-size: 1.4rem; color: rgba(255,247,234,0.65); margin: 0 0 0.8rem; }
  .pv-intro-subtitle { font-size: 1.5rem; color: rgba(255,247,234,0.9); margin: 0 0 2rem; line-height: 1.5; }
  .pv-trust-line { display: flex; flex-wrap: wrap; gap: 1.4rem; font-size: 1.3rem; color: rgba(255,247,234,0.75); margin: 0; }
  @media screen and (max-width: 499px) { .pv-trust-line { flex-direction: column; gap: 0.6rem; } }

  /* ===== Benefits grid ===== */
  .pv-benefits-grid { display: grid; grid-template-columns: 1fr; gap: 1.4rem; }
  @media screen and (min-width: 600px) { .pv-benefits-grid { grid-template-columns: 1fr 1fr; } }
  .pv-benefit-card { background: #FAF3E7; padding: 1.8rem; border-radius: 12px; }
  .pv-bc-icon { width: 4.4rem; height: 4.4rem; background: #FFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 1.4rem; box-shadow: 0 4px 12px rgba(217,154,43,0.12); }
  .pv-benefit-card strong { display: block; font-size: 1.5rem; color: #12350E; margin-bottom: 0.6rem; }
  .pv-benefit-card p { font-size: 1.4rem; color: #4A5246; margin: 0; line-height: 1.5; }

  /* ===== Size & Fit ===== */
  .pv-size-flex { display: flex; flex-direction: column; gap: 2.4rem; }
  @media screen and (min-width: 700px) { .pv-size-flex { flex-direction: row; gap: 4rem; } .pv-size-left, .pv-size-right { flex: 1; } }
  .pv-size-desc { font-size: 1.4rem; color: #4A5246; line-height: 1.5; margin: 0 0 1.4rem; }
  .pv-bullet-list { list-style: none; padding: 0; margin: 0 0 1.8rem; }
  .pv-bullet-list li { position: relative; padding-left: 1.8rem; font-size: 1.4rem; font-weight: 600; color: #12350E; line-height: 1.5; margin-bottom: 0.8rem; }
  .pv-bullet-list li::before { content: "•"; position: absolute; left: 0; color: #D99A2B; font-size: 1.8rem; line-height: 1; top: -0.1rem; }
  .pv-open-size-btn { background: #D99A2B; color: #12350E; font-size: 1.4rem; font-weight: 800; border: none; padding: 1rem 2rem; border-radius: 99px; cursor: pointer; transition: background 0.2s; }
  .pv-open-size-btn:hover { background: #E0A846; }
  .pv-num-list { padding-left: 1.8rem; margin: 0; }
  .pv-num-list li { font-size: 1.4rem; color: #4A5246; line-height: 1.5; margin-bottom: 1rem; padding-left: 0.6rem; }
  .pv-num-list li::marker { font-weight: 700; color: #12350E; }

  /* ===== Product Details Accordion ===== */
  .pv-faq-list { display: flex; flex-direction: column; gap: 1rem; }
  .pv-faq-item { border: 1px solid rgba(31,36,29,0.1); border-radius: 8px; overflow: hidden; background: #FAF3E7; }
  .pv-faq-item summary { padding: 1.4rem 1.8rem; font-size: 1.5rem; font-weight: 700; color: #12350E; cursor: pointer; list-style: none; position: relative; user-select: none; }
  .pv-faq-item summary::-webkit-details-marker { display: none; }
  .pv-faq-item summary::after { content: "+"; position: absolute; right: 1.8rem; font-size: 2rem; color: #D99A2B; font-weight: 400; transition: transform 0.2s; }
  .pv-faq-item[open] summary::after { transform: rotate(45deg); }
  .pv-faq-ans { padding: 0 1.8rem 1.4rem; font-size: 1.4rem; color: #4A5246; line-height: 1.6; }
  .pv-faq-ans p { margin: 0 0 1rem; }
  .pv-faq-ans p:last-child { margin-bottom: 0; }

  /* ===== Comparison table ===== */
  .pv-compare-table { width: 100%; border-collapse: collapse; text-align: left; }
  .pv-compare-table th { font-size: 1.3rem; font-weight: 800; color: #6F7568; padding: 1.4rem; border-bottom: 2px solid rgba(31,36,29,0.1); }
  .pv-compare-table td { font-size: 1.4rem; color: #1F241D; padding: 1.4rem; border-bottom: 1px solid rgba(31,36,29,0.05); }
  .pv-brand-col { background: rgba(255,247,234,0.6); text-align: center; }
  .pv-compare-table th.pv-brand-col { color: #12350E; }
  .pv-compare-table td:not(:first-child) { text-align: center; }
  .pv-check { color: #12350E; font-weight: 800; font-size: 1.6rem; }
  .pv-cross { color: #B0B8AA; font-weight: 800; font-size: 1.6rem; }

  /* ===== Final CTA ===== */
  .pv-final-cta { text-align: center; background: #FAF3E7; }
  .pv-final-cta h2 { font-size: clamp(2.2rem, 3.5vw, 2.8rem); font-weight: 800; color: #12350E; margin: 0 0 1rem; }
  .pv-final-cta p { font-size: 1.5rem; color: #4A5246; margin: 0 0 2rem; }
  .pv-btn-solid { display: inline-block; background: #12350E; color: #FFF7EA; font-size: 1.6rem; font-weight: 800; padding: 1.4rem 3.6rem; border-radius: 99px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 8px 24px rgba(18,53,14,0.15); }
  .pv-btn-solid:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(18,53,14,0.22); }

  /* ===== Mobile ===== */
  @media screen and (max-width: 499px) {
    .pv-edu-section { padding: 2rem 1.6rem; }
    .pv-compare-table th, .pv-compare-table td { padding: 1rem 0.8rem; font-size: 1.3rem; }
  }
</style>
