  .pv-intro-hook { display: block; font-size: 1.3rem; font-weight: 700; color: #D99A2B; margin: 0 0 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .pv-intro-card h2 { font-size: clamp(2.4rem, 4vw, 3.2rem); font-weight: 800; color: #FFF7EA; margin: 0 0 1rem; line-height: 1.2; }
  .pv-intro-title { font-size: 1.4rem; color: rgba(255,247,234,0.65); margin: 0 0 0.8rem; }
