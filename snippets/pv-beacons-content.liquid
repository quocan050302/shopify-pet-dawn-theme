<!-- =====================================================
     JS BRIDGE: Left-col variant buttons → hidden right-col picker
     ===================================================== -->
<script>
(function() {
  'use strict';

  var SECTION_ID = {{ section.id | json }};

  function pvInitVariants() {
    var btns = document.querySelectorAll('.pv-opt-btn');
    if (!btns.length) return;

    btns.forEach(function(btn) {
      if (btn.dataset.pvBound) return;
      btn.dataset.pvBound = '1';

      btn.addEventListener('click', function() {
        if (this.classList.contains('pv-opt-unavailable')) return;

        var optIdx   = parseInt(this.dataset.optionIndex, 10);
        var optName  = this.dataset.optionName;
        var optValue = this.dataset.optionValue;

        // ── 1. Update visual active state in left col ──
        document.querySelectorAll('.pv-opt-btn[data-option-index="' + optIdx + '"]')
          .forEach(function(b) { b.classList.remove('pv-opt-active'); });
        
        // Add active state to both desktop and mobile buttons with this value
        document.querySelectorAll('.pv-opt-btn[data-option-index="' + optIdx + '"][data-option-value="' + optValue.replace(/"/g, '\\"') + '"]')
          .forEach(function(b) { b.classList.add('pv-opt-active'); });

        // ── 2. Update the selected label ──
        document.querySelectorAll('.pv-sel-label[data-idx="' + optIdx + '"]')
          .forEach(function(label) { label.textContent = optValue; });

        // ── 3. Sync with the hidden variant-selects in right col ──
        // Dawn's picker is a <variant-selects> custom element
        var picker = document.querySelector('.pv-sticky-card variant-selects');
        if (picker) {
          // Try radio inputs first (Dawn default: button type)
          var synced = false;
          var radios = picker.querySelectorAll('input[type="radio"]');
          radios.forEach(function(radio) {
            // Dawn names options: "option1", "option2", etc.
            if (radio.name === 'option' + (optIdx + 1) && radio.value === optValue) {
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { bubbles: true }));
              synced = true;
            }
          });

          // Fallback: select dropdowns
          if (!synced) {
            var selects = picker.querySelectorAll('select');
            selects.forEach(function(sel) {
              if (sel.name === 'option' + (optIdx + 1)) {
                sel.value = optValue;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          }
        }

        // ── 4. Check selected combination availability ──
        pvCheckAvailability();
      });
    });
  }

  function pvCheckAvailability() {
    // Collect currently active values from just ONE picker instance to avoid duplication
    var selected = [];
    var firstPicker = document.querySelector('.pv-variants-section');
    if (!firstPicker) return;
    
    var groups = firstPicker.querySelectorAll('.pv-option-group');
    groups.forEach(function(g) {
      var active = g.querySelector('.pv-opt-btn.pv-opt-active');
      selected.push(active ? active.dataset.optionValue : '');
    });

    // Find matching variant
    var variants = {{ product.variants | json }};
    var match = variants.find(function(v) {
      return selected.every(function(val, i) {
        return v['option' + (i + 1)] === val;
      });
    });

    document.querySelectorAll('.pv-unavail-msg').forEach(function(msgEl) {
      msgEl.style.display = (match && !match.available) ? 'block' : 'none';
    });

    // Dim add-to-cart in right col if unavailable
    var submitBtn = document.querySelector('.pv-sticky-card .product-form__submit');
    if (submitBtn) {
      if (match && !match.available) {
        submitBtn.setAttribute('aria-disabled', 'true');
      } else {
        submitBtn.removeAttribute('aria-disabled');
      }
    }
  }

  function pvInitAccordion() {
    var detailsEls = document.querySelectorAll('.pv-faq-item');
    detailsEls.forEach(function(detail) {
      var summary = detail.querySelector('summary');
      if (summary && !summary.dataset.ariaBound) {
        summary.dataset.ariaBound = 'true';
        summary.addEventListener('click', function() {
          requestAnimationFrame(function() {
            summary.setAttribute('aria-expanded', detail.hasAttribute('open'));
          });
        });
      }
    });
  }

  // Init on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      pvInitVariants();
      pvInitAccordion();
    });
  } else {
    pvInitVariants();
    pvInitAccordion();
  }

  // Re-init if Shopify re-renders sections
  document.addEventListener('shopify:section:load', function() {
    pvInitVariants();
    pvInitAccordion();
  });
})();
</script>

